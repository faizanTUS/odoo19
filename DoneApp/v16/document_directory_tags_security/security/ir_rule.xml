<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Directories: Document User sees only folders explicitly assigned to them (and group rules). -->
    <record id="rule_document_directory_document_user" model="ir.rule">
        <field name="name">Document Directory: assigned document users</field>
        <field name="model_id" ref="model_document_directory"/>
        <field name="domain_force">['&amp;', ('allowed_document_user_ids', 'in', [user.id]), '|', ('group_ids', '=', False), ('group_ids', 'in', user.groups_id.ids)]</field>
        <field name="groups" eval="[(4, ref('group_document_hub_user'))]"/>
    </record>

    <!-- Attachments: Document User — unfiled OR filed in an allowed directory -->
    <record id="rule_ir_attachment_document_user" model="ir.rule">
        <field name="name">Attachments: document user directory scope</field>
        <field name="model_id" ref="base.model_ir_attachment"/>
        <field name="domain_force">['&amp;', '|', '|', ('res_id', '!=', False), ('create_uid', '=', user.id), ('public', '=', True), '|', ('directory_id', '=', False), '&amp;', ('directory_id.allowed_document_user_ids', 'in', [user.id]), '|', ('directory_id.group_ids', '=', False), ('directory_id.group_ids', 'in', user.groups_id.ids)]</field>
        <field name="groups" eval="[(4, ref('group_document_hub_user'))]"/>
    </record>

    <!-- Attachments: employees — own owner only -->
    <record id="rule_ir_attachment_document_employee" model="ir.rule">
        <field name="name">Attachments: document employee owns only</field>
        <field name="model_id" ref="base.model_ir_attachment"/>
        <field name="domain_force">[("owner_id", "=", user.id)]</field>
        <field name="groups" eval="[(4, ref('group_document_hub_employee'))]"/>
    </record>
</odoo>
