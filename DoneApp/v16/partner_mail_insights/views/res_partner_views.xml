<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form_inherit_mail_counts" model="ir.ui.view">
        <field name="name">res.partner.form.mail.counts</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="priority" eval="30"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet//div[@class='oe_button_box']" position="inside">
                <button name="action_view_incoming_mails"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-sign-in">
                    <field name="incoming_mail_count" string="Incoming" widget="statinfo"/>
                </button>
                <button name="action_view_outgoing_mails"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-sign-out">
                    <field name="outgoing_mail_count" string="Outgoing" widget="statinfo"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
