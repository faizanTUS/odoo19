<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_customer_rma_form" model="ir.ui.view">
        <field name="name">customer.rma.form</field>
        <field name="model">customer.rma</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_submit" string="Submit" type="object"
                            attrs="{'invisible': [('state', '!=', 'draft')]}" class="oe_highlight"/>
                    <button name="action_approve" string="Approve" type="object"
                            attrs="{'invisible': [('state', '!=', 'submitted')]}" class="oe_highlight"/>
                    <button name="action_reject" string="Reject" type="object"
                            attrs="{'invisible': [('state', '!=', 'submitted')]}"/>
                    <button name="action_process" string="Start Processing" type="object"
                            attrs="{'invisible': [('state', '!=', 'approved')]}" class="oe_highlight"/>
                    <button name="action_close" string="Close" type="object"
                            attrs="{'invisible': [('state', '!=', 'processing')]}" class="oe_highlight"/>
                    <button name="action_draft" string="Reset to Draft" type="object"
                            attrs="{'invisible': [('state', 'not in', ('rejected',))]}"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,submitted,approved,processing,closed"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_picking" type="object" class="oe_stat_button" icon="fa-truck"
                                attrs="{'invisible': [('picking_count', '=', 0)]}">
                            <field name="picking_count" widget="statinfo" string="Return Picking"/>
                        </button>
                        <button name="action_view_credit_note" type="object" class="oe_stat_button"
                                icon="fa-pencil-square-o" attrs="{'invisible': [('credit_note_count', '=', 0)]}">
                            <field name="credit_note_count" widget="statinfo" string="Credit Note"/>
                        </button>
                        <button name="action_view_replacement_order" type="object" class="oe_stat_button" icon="fa-usd"
                                attrs="{'invisible': [('replacement_order_count', '=', 0)]}">
                            <field name="replacement_order_count" widget="statinfo" string="Replacement"/>
                        </button>
                    </div>
                    <field name="valid_product_ids" invisible="1"/>
                    <field name="company_id" invisible="1"/>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="sale_order_id" attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                            <field name="partner_id" attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                            <field name="return_address_id" attrs="{'readonly': [('state', '!=', 'draft')]}"
                                   domain="['|', ('parent_id', '=', partner_id), ('id', '=', partner_id)]"/>
                        </group>
                        <group>
                            <field name="date" attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                            <field name="user_id" attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                            <field name="priority" widget="priority" attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                        </group>
                    </group>
                    <group string="Bulk Apply Reason" col="2" invisible="state != 'draft'">
                        <label for="bulk_reason_id" string="Apply Reason to All Lines"/>
                        <div class="d-flex align-items-center gap-2">
                            <field name="bulk_reason_id" nolabel="1" class="w-auto"/>
                            <button name="action_apply_bulk_reason"
                                    string="Apply to All Lines"
                                    type="object"
                                    class="btn btn-primary"
                                    invisible="not bulk_reason_id"/>
                        </div>
                    </group>
                    <notebook>
                        <page string="RMA Lines">
                            <field name="rma_line_ids" attrs="{'readonly': [('state', '!=', 'draft')]}">
                                <tree editable="bottom">
                                    <field name="product_id" domain="[('id', 'in', parent.valid_product_ids)]"/>
                                    <field name="delivered_qty" readonly="1" force_save="1"/>
                                    <field name="quantity"/>
                                    <field name="reason_id"/>
                                    <field name="action"/>
                                    <field name="unit_price"/>
                                    <field name="tax_ids" widget="many2many_tags"/>
                                    <field name="subtotal"/>
                                </tree>
                            </field>
                            <group class="oe_subtotal_footer">
                                <field name="restocking_fee"/>
                                <field name="total_refund_amount" class="oe_subtotal_footer_separator"/>
                            </group>
                        </page>
                        <page string="Replacement Product Line">
                            <field name="replacement_line_ids">
                                <tree editable="bottom">
                                    <field name="product_id"/>
                                    <field name="quantity"/>
                                    <field name="price"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Other Info">
                            <group>
                                <field name="picking_id"/>
                                <field name="replacement_order_id"/>
                                <field name="credit_note_id"/>
                                <field name="reject_reason" attrs="{'invisible': [('state', '!=', 'rejected')]}"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_customer_rma_tree" model="ir.ui.view">
        <field name="name">customer.rma.list</field>
        <field name="model">customer.rma</field>
        <field name="arch" type="xml">
            <tree decoration-info="state == 'submitted'"
                  decoration-success="state in ('approved','closed')"
                  decoration-danger="state == 'rejected'"
                  decoration-muted="state == 'draft'">
                <field name="name"/>
                <field name="sale_order_id"/>
                <field name="partner_id"/>
                <field name="date"/>
                <field name="total_refund_amount" sum="Total"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'submitted'"
                       decoration-success="state in ('approved','closed')"
                       decoration-danger="state == 'rejected'"/>
            </tree>
        </field>
    </record>

    <record id="view_customer_rma_search" model="ir.ui.view">
        <field name="name">customer.rma.search</field>
        <field name="model">customer.rma</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="sale_order_id"/>
                <field name="partner_id"/>
                <filter string="Draft" name="state_draft" domain="[('state','=','draft')]"/>
                <filter string="Submitted" name="state_submitted" domain="[('state','=','submitted')]"/>
                <filter string="Approved" name="state_approved" domain="[('state','=','approved')]"/>
                <filter string="Processing" name="state_processing" domain="[('state','=','processing')]"/>
                <filter string="Closed" name="state_closed" domain="[('state','=','closed')]"/>
                <filter string="Rejected" name="state_rejected" domain="[('state','=','rejected')]"/>
                <separator/>
                <filter string="My RMAs" name="my_rmas" domain="[('user_id','=',uid)]"/>
                <group expand="0" string="Group By">
                    <filter string="Customer" name="group_partner" context="{'group_by':'partner_id'}"/>
                    <filter string="Status" name="group_state" context="{'group_by':'state'}"/>
                    <filter string="Date" name="group_date" context="{'group_by':'date'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_customer_rma_kanban" model="ir.ui.view">
        <field name="name">customer.rma.kanban</field>
        <field name="model">customer.rma</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="o_kanban_small_column" records_draggable="false">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="sale_order_id"/>
                <field name="date"/>
                <field name="state"/>
                <field name="total_refund_amount"/>
                <field name="currency_id"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_card oe_kanban_global_click">
                            <div class="o_kanban_record_top">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title">
                                        <field name="name"/>
                                    </strong>
                                    <div class="o_kanban_record_subtitle text-muted">
                                        <field name="partner_id"/>
                                    </div>
                                </div>
                            </div>
                            <div class="o_kanban_record_body">
                                <div>Order:
                                    <field name="sale_order_id"/>
                                </div>
                                <div>Date:
                                    <field name="date"/>
                                </div>
                                <div>
                                    Refund:
                                    <field name="total_refund_amount" widget="monetary"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_customer_rma_graph" model="ir.ui.view">
        <field name="name">customer.rma.graph</field>
        <field name="model">customer.rma</field>
        <field name="arch" type="xml">
            <graph string="Customer RMA Analysis" type="bar" sample="1">
                <field name="state"/>
                <field name="total_refund_amount" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="view_customer_rma_pivot" model="ir.ui.view">
        <field name="name">customer.rma.pivot</field>
        <field name="model">customer.rma</field>
        <field name="arch" type="xml">
            <pivot string="Customer RMA Analysis" sample="1">
                <field name="state" type="col"/>
                <field name="date" interval="month" type="row"/>
                <field name="total_refund_amount" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="action_customer_rma" model="ir.actions.act_window">
        <field name="name">Customer RMA Records</field>
        <field name="res_model">customer.rma</field>
        <field name="view_mode">tree,kanban,form,graph,pivot</field>
        <field name="search_view_id" ref="view_customer_rma_search"/>
    </record>
</odoo>