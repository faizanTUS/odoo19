<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_rma_reject_wizard_form" model="ir.ui.view">
        <field name="name">rma.reject.wizard.form</field>
        <field name="model">rma.reject.wizard</field>
        <field name="arch" type="xml">
            <form string="Reject RMA">
                <group>
                    <field name="reject_reason" placeholder="Explain why the RMA is being rejected..."/>
                </group>
                <footer>
                    <button name="action_reject_confirm" string="Reject Claim" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
