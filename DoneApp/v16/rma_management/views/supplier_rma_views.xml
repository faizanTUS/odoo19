<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_supplier_rma_form" model="ir.ui.view">
        <field name="name">supplier.rma.form</field>
        <field name="model">supplier.rma</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_submit" string="Submit" type="object"
                            attrs="{'invisible': [('state', '!=', 'draft')]}" class="oe_highlight"/>
                    <button name="action_approve" string="Approve" type="object"
                            attrs="{'invisible': [('state', '!=', 'submitted')]}" class="oe_highlight"/>
                    <button name="action_reject" string="Reject" type="object"
                            attrs="{'invisible': [('state', '!=', 'submitted')]}"/>
                    <button name="action_process" string="Start Processing" type="object"
                            attrs="{'invisible': [('state', '!=', 'approved')]}" class="oe_highlight"/>
                    <button name="action_close" string="Close" type="object"
                            attrs="{'invisible': [('state', '!=', 'processing')]}" class="oe_highlight"/>
                    <button name="action_draft" string="Reset to Draft" type="object"
                            attrs="{'invisible': [('state', 'not in', ('rejected',))]}"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,submitted,approved,processing,closed"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_outgoing_picking" type="object" class="oe_stat_button"
                                icon="fa-truck" attrs="{'invisible': [('outgoing_picking_count', '=', 0)]}">
                            <field name="outgoing_picking_count" widget="statinfo" string="Outgoing"/>
                        </button>
                        <button name="action_view_incoming_picking" type="object" class="oe_stat_button"
                                icon="fa-truck" attrs="{'invisible': [('incoming_picking_count', '=', 0)]}">
                            <field name="incoming_picking_count" widget="statinfo" string="Incoming"/>
                        </button>
                        <button name="action_view_credit_note" type="object" class="oe_stat_button"
                                icon="fa-pencil-square-o" attrs="{'invisible': [('credit_note_count', '=', 0)]}">
                            <field name="credit_note_count" widget="statinfo" string="Credit Note"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="purchase_order_id" attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                            <!-- Fixed: partner_id with safe domain + context -->
                            <field
                                name="partner_id"
                                attrs="{'readonly': [('state', '!=', 'draft')]}"
                                domain="[('company_id', 'in', [company_id or False, False])]"
                                context="{'default_company_id': company_id}"
                                groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="date" attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                            <field name="deadline" attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                            <field name="user_id" attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>

                    <group string="Bulk Apply Reason"
                           attrs="{'invisible': [('state', '!=', 'draft')]}">
                        <field name="bulk_reason_id"/>
                        <button name="action_apply_bulk_reason" string="Apply to All Lines"
                                type="object" class="btn-primary"
                                attrs="{'invisible': [('bulk_reason_id', '=', False)]}"/>
                    </group>

                    <notebook>
                        <page string="RMA Lines">
                            <field name="rma_line_ids" attrs="{'readonly': [('state', '!=', 'draft')]}">
                                <tree editable="bottom">
                                    <field name="product_id"/>
                                    <field name="reason_id"/>
                                    <field name="action"/>
                                    <field name="delivered_qty"/>
                                    <field name="return_qty"/>
                                    <field name="replace_qty"/>
                                    <field name="unit_price"/>
                                    <field name="tax_ids" widget="many2many_tags" optional="hide"/>
                                    <field name="subtotal"/>
                                </tree>
                            </field>
                            <group class="oe_subtotal_footer">
                                <field name="total_refund"/>
                            </group>
                        </page>
                        <page string="Replacement Product Line">
                            <field name="replacement_line_ids" attrs="{'readonly': [('state', '!=', 'draft')]}">
                                <tree editable="bottom">
                                    <field name="product_id"/>
                                    <field name="quantity"/>
                                    <field name="price"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Other Info">
                            <group>
                                <field name="outgoing_picking_id"/>
                                <field name="incoming_picking_id"/>
                                <field name="credit_note_id"/>
                                <field name="reject_reason" attrs="{'invisible': [('state', '!=', 'rejected')]}"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Rest of your views (tree, kanban, search, action) remain unchanged -->
    <record id="view_supplier_rma_tree" model="ir.ui.view">
        <field name="name">supplier.rma.list</field>
        <field name="model">supplier.rma</field>
        <field name="arch" type="xml">
            <tree decoration-info="state == 'submitted'"
                  decoration-success="state in ('approved','closed')"
                  decoration-danger="state == 'rejected'"
                  decoration-muted="state == 'draft'">
                <field name="name"/>
                <field name="purchase_order_id"/>
                <field name="partner_id"/>
                <field name="date"/>
                <field name="total_refund" sum="Total"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'submitted'"
                       decoration-success="state in ('approved','closed')"
                       decoration-danger="state == 'rejected'"/>
            </tree>
        </field>
    </record>

    <record id="view_supplier_rma_kanban" model="ir.ui.view">
        <field name="name">supplier.rma.kanban</field>
        <field name="model">supplier.rma</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="o_kanban_small_column" records_draggable="false">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="purchase_order_id"/>
                <field name="date"/>
                <field name="state"/>
                <field name="total_refund"/>
                <field name="currency_id"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_card oe_kanban_global_click">
                            <div class="o_kanban_record_top">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title">
                                        <field name="name"/>
                                    </strong>
                                    <div class="o_kanban_record_subtitle text-muted">
                                        <field name="partner_id"/>
                                    </div>
                                </div>
                            </div>
                            <div class="o_kanban_record_body">
                                <div>PO: <field name="purchase_order_id"/></div>
                                <div>Date: <field name="date"/></div>
                                <div>
                                    Refund:
                                    <field name="total_refund" widget="monetary"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_supplier_rma_search" model="ir.ui.view">
        <field name="name">supplier.rma.search</field>
        <field name="model">supplier.rma</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="purchase_order_id"/>
                <field name="partner_id"/>
                <filter string="Draft" name="state_draft" domain="[('state','=','draft')]"/>
                <filter string="Submitted" name="state_submitted" domain="[('state','=','submitted')]"/>
                <filter string="Approved" name="state_approved" domain="[('state','=','approved')]"/>
                <filter string="Closed" name="state_closed" domain="[('state','=','closed')]"/>
                <filter string="Rejected" name="state_rejected" domain="[('state','=','rejected')]"/>
                <separator/>
                <filter string="My RMAs" name="my_rmas" domain="[('user_id','=',uid)]"/>
                <group expand="0" string="Group By">
                    <filter string="Vendor" name="group_partner" context="{'group_by':'partner_id'}"/>
                    <filter string="Status" name="group_state" context="{'group_by':'state'}"/>
                    <filter string="Date" name="group_date" context="{'group_by':'date'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_supplier_rma" model="ir.actions.act_window">
        <field name="name">Supplier RMA Records</field>
        <field name="res_model">supplier.rma</field>
        <field name="view_mode">tree,kanban,form</field>
        <field name="search_view_id" ref="view_supplier_rma_search"/>
    </record>
</odoo>