<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="email_template_rma_submitted" model="mail.template">
            <field name="name">RMA Submitted Notification</field>
            <field name="model_id" ref="rma_management.model_customer_rma"/>
            <field name="subject">RMA {{ object.name }} Submitted for Order {{ object.sale_order_id.name }}</field>
            <field name="email_from">{{ object.company_id.email_formatted }}</field>
            <field name="email_to">{{ object.partner_id.email_formatted }}</field>
            <field name="body_html" type="html">
                <div style="margin: 0px; padding: 0px;">
                    <p style="margin: 0px; padding: 0px; font-size: 13px;">
                        Dear <t t-out="object.partner_id.name"/>,<br/><br/>
                        Your RMA request <strong><t t-out="object.name"/></strong> for order <strong><t t-out="object.sale_order_id.name"/></strong> has been submitted and is under review.
                        <br/><br/>
                        Thank you,<br/>
                        <t t-out="object.company_id.name"/>
                    </p>
                </div>
            </field>
        </record>

        <record id="email_template_rma_approved" model="mail.template">
            <field name="name">RMA Approved Notification</field>
            <field name="model_id" ref="rma_management.model_customer_rma"/>
            <field name="subject">RMA {{ object.name }} Approved</field>
            <field name="email_from">{{ object.company_id.email_formatted }}</field>
            <field name="email_to">{{ object.partner_id.email_formatted }}</field>
            <field name="body_html" type="html">
                <div style="margin: 0px; padding: 0px;">
                    <p style="margin: 0px; padding: 0px; font-size: 13px;">
                        Dear <t t-out="object.partner_id.name"/>,<br/><br/>
                        We are pleased to inform you that your RMA request <strong><t t-out="object.name"/></strong> has been approved.
                        <br/><br/>
                        Thank you,<br/>
                        <t t-out="object.company_id.name"/>
                    </p>
                </div>
            </field>
        </record>

        <record id="email_template_rma_closed" model="mail.template">
            <field name="name">RMA Closed Notification</field>
            <field name="model_id" ref="rma_management.model_customer_rma"/>
            <field name="subject">RMA {{ object.name }} Completed</field>
            <field name="email_from">{{ object.company_id.email_formatted }}</field>
            <field name="email_to">{{ object.partner_id.email_formatted }}</field>
            <field name="body_html" type="html">
                <div style="margin: 0px; padding: 0px;">
                    <p style="margin: 0px; padding: 0px; font-size: 13px;">
                        Dear <t t-out="object.partner_id.name"/>,<br/><br/>
                        Your return request <strong><t t-out="object.name"/></strong> has been completed.
                        <br/><br/>
                        Thank you,<br/>
                        <t t-out="object.company_id.name"/>
                    </p>
                </div>
            </field>
        </record>

        <record id="email_template_rma_rejected" model="mail.template">
            <field name="name">RMA Rejected Notification</field>
            <field name="model_id" ref="rma_management.model_customer_rma"/>
            <field name="subject">RMA {{ object.name }} Rejected</field>
            <field name="email_from">{{ object.company_id.email_formatted }}</field>
            <field name="email_to">{{ object.partner_id.email_formatted }}</field>
            <field name="body_html" type="html">
                <div style="margin: 0px; padding: 0px;">
                    <p style="margin: 0px; padding: 0px; font-size: 13px;">
                        Dear <t t-out="object.partner_id.name"/>,<br/><br/>
                        We regret to inform you that your RMA request <strong><t t-out="object.name"/></strong> has been rejected.
                        <br/>
                        <strong>Reason:</strong> <t t-out="object.reject_reason or 'No reason provided'"/>
                        <br/><br/>
                        Thank you,<br/>
                        <t t-out="object.company_id.name"/>
                    </p>
                </div>
            </field>
        </record>
    </data>
</odoo>
