<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">sale.config.settings.view.form.inherit.sale.price.history</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="70"/>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='companies_setting_container']" position="after">
                <div class="row mt16 o_settings_container" name="sales_price_history_container">
                    <div class="col-12 col-lg-6 o_setting_box" id="sales_price_history_settings">
                        <div class="o_setting_right_pane">
                            <h2 class="fw-bold">Sales Price History</h2>
                            <div class="mb16">
                                <label class="o_form_label me-2">Item Limit</label>
                                <field name="item_limit"/>
                            </div>
                            <div class="mb16">
                                <label class="o_form_label me-2">Show Confirm Sales Orders</label>
                                <field name="filter_confirmed"/>
                            </div>
                            <div class="mb16">
                                <label class="o_form_label me-2">Show Quotation Sent Sales Orders</label>
                                <field name="filter_sent"/>
                            </div>
                            <div class="mb16">
                                <label class="o_form_label me-2">Show Draft Sales Orders</label>
                                <field name="filter_draft"/>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
