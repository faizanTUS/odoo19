<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_inherit_otp" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.otp</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@id='user_default_rights']" position="after">
                <div class="app_settings_block" data-string="OTP Settings" string="OTP Settings" data-key="otp_settings">
                    <h2>Email OTP Configuration</h2>
                    <div class="row mt16 o_settings_container">
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_right_pane">
                                <label for="email_otp_expire_time"/>
                                <div class="text-muted">
                                    Time in Minutes before the OTP expires
                                </div>
                                <field name="email_otp_expire_time"/>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>