<odoo>
    <record id="view_users_form_inherit_1" model="ir.ui.view">
        <field name="name">res.users.form.inherit</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <notebook position="inside">
                <page string="Allow Products">
                    <field name="restriction_type" widget="radio"/>
                    <field name="allowed_product_ids" 
                           domain="[('sale_ok', '=', True)]" 
                           attrs="{'invisible': [('restriction_type', '!=', 'product')]}"/>
                    <field name="allowed_category_ids" 
                           attrs="{'invisible': [('restriction_type', '!=', 'category')]}"/>
                </page>
            </notebook>
        </field>
    </record>
</odoo>
