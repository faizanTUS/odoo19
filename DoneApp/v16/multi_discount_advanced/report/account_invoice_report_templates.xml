<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Account Invoice Report - Add Multi Discount column -->
    <template id="report_invoice_document_multi_discount" inherit_id="account.report_invoice_document">
        <xpath expr="//th[@name='th_priceunit']" position="after">
            <th name="th_mrp" t-attf-class="text-end text-nowrap {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}" t-if="o.show_multi_discount_in_pdf" groups="multi_discount_advanced.tus_multi_discount_advanced_group_account">
                <span>Multi Discount</span>
            </th>
        </xpath>
<!--        <xpath expr="//td[@name='td_price_unit']" position="after">-->
        <xpath expr="//t[@name='account_invoice_line_accountable']/td[3]" position="after">
            <td name="td_multi_discount" t-attf-class="text-end text-nowrap {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}" t-if="o.show_multi_discount_in_pdf and line.display_type == 'product'" groups="multi_discount_advanced.tus_multi_discount_advanced_group_account">
                <span t-field="line.multi_discount"/>
            </td>
        </xpath>
<!--        <xpath expr="//th[@name='th_discount']" position="after">-->
        <xpath expr="//th[@name='th_taxes']" position="before">
            <th name="th_discounted_amount" t-attf-class="text-end text-nowrap {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}" t-if="o.show_multi_discount_in_pdf" groups="multi_discount_advanced.tus_multi_discount_advanced_group_account">
                <span>Discounted Amount</span>
            </th>
        </xpath>
<!--        <xpath expr="//td[@name='td_discount']" position="after">-->
        <xpath expr="//td[@t-if='display_discount']" position="after">
            <td name="td_discounted_amount" t-attf-class="text-end text-nowrap {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}" t-if="o.show_multi_discount_in_pdf and line.display_type == 'product'" groups="multi_discount_advanced.tus_multi_discount_advanced_group_account">
                <span t-field="line.discount_amount"/>
            </td>
        </xpath>
    </template>
</odoo>

