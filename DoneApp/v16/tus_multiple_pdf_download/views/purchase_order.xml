<odoo>
    <record id="action_purchase_order_export_zip" model="ir.actions.server">
        <field name="name">Export Purchase Order</field>
        <field name="model_id" ref="purchase.model_purchase_order"/>
        <field name="binding_model_id" ref="purchase.model_purchase_order"/>
        <field name="state">code</field>
        <field name="groups_id" eval="[(6, 0, [ref('tus_multiple_pdf_download.group_export_purchase_order')])]"/>
        <field name="code">
            action = {
                'name': 'Export Purchase Order',
                'type': 'ir.actions.act_window',
                'res_model': 'export.pdf.wizard',
                'view_mode': 'form',
                'target': 'new',
                'context': {'default_purchase_ids': [record.id for record in records],
                             'default_is_purchase': True,
            },
            }
        </field>
    </record>
    <record id="purchase_order_list_action" model="ir.ui.view">
        <field name="name">purchase.order.list.view</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//tree" position="inside">
                <header>
                <button name="%(action_purchase_order_export_zip)d" type="action" string="Export Purchase Order" groups="tus_multiple_pdf_download.group_export_purchase_order"/>
                </header>
            </xpath>
        </field>
    </record>

     <record id="action_purchase_order_quotation_export" model="ir.actions.server">
        <field name="name">Export Purchase Quotation</field>
        <field name="model_id" ref="purchase.model_purchase_order"/>
        <field name="binding_model_id" ref="purchase.model_purchase_order"/>
        <field name="state">code</field>
        <field name="code">
            action = {
                'name': 'Export Purchase Quotation',
                'type': 'ir.actions.act_window',
                'res_model': 'export.pdf.wizard',
                'view_mode': 'form',
                'target': 'new',
                'context': {'default_purchase_ids': [record.id for record in records],
                             'default_is_purchase_rfq': True,
            },
            }
        </field>
        <field name="groups_id" eval="[(4, ref('tus_multiple_pdf_download.group_export_purchase_order'))]"/>
    </record>

     <record id="purchase_order_kpis_tree_list_action" model="ir.ui.view">
        <field name="name">purchase.order.list.view</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_kpis_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//tree" position="inside">
                <header>
                <button name="%(action_purchase_order_quotation_export)d" type="action" string="Export Purchase Order" groups="tus_multiple_pdf_download.group_export_purchase_order"/>
                </header>
            </xpath>
        </field>
    </record>
</odoo>