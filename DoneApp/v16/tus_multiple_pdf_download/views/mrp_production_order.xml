<odoo>
    <record id="action_mrp_production_order_export" model="ir.actions.server">
        <field name="name">Export Production Order</field>
        <field name="model_id" ref="mrp.model_mrp_production"/>
        <field name="binding_model_id" ref="mrp.model_mrp_production"/>
        <field name="groups_id" eval="[(6, 0, [ref('group_export_mrp_production_order')])]"/>
        <field name="state">code</field>
        <field name="code">
            action = {
                'name': 'Export Production Order',
                'type': 'ir.actions.act_window',
                'res_model': 'export.pdf.wizard',
                'view_mode': 'form',
                'target': 'new',
                'context': {'default_production_ids': [record.id for record in records],
                            'default_is_production':True,
            },

            }
        </field>
    </record>
    <record id="production_order_list_action" model="ir.ui.view">
        <field name="name">mrp.production.list.view</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_tree_view"/>
        <field name="arch" type="xml">
            <xpath expr="//tree" position="inside">
                <header>
                <button name="%(action_mrp_production_order_export)d" type="action" string="Export Production Orders" groups="tus_multiple_pdf_download.group_export_mrp_production_order"/>
                </header>
            </xpath>
        </field>
    </record>


</odoo>