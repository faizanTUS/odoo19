<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_mail_font" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.mail.font</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="mail.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <!--  Add font setting inside the Emails block, after the template rendering restriction -->
            <div id="restrict_template_rendering_setting" position="after">
                <div class="col-12 col-lg-6 o_setting_box">
                    <div class="o_setting_left_pane">
                    </div>
                    <div class="o_setting_right_pane">
                        <div class="row">
                            <span class="o_form_label">Default Email Font Family</span>
                            <div class="text-muted col-md-12">
                                Font family applied to the message composer, log note input, and mail template body
                                editor. The selected font is also embedded in the sent message HTML.
                            </div>
                        </div>
                        <div class="content-group">
                            <div class="row">
                                <field name="mail_font_family"/>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </field>
    </record>
</odoo>
