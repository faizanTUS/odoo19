<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- job Form View -->
        <record id="hr_job_linkedin_form" model="ir.ui.view">
            <field name="name">hr.job.linkedin.form</field>
            <field name="model">hr.job</field>
            <field name="inherit_id" ref="hr.view_hr_job_form"/>
            <field name="arch" type="xml">
                <xpath expr="//form//sheet" position="before">
                    <header>
                        <button name="share_linkedin" string="Share Post" type="object"
                                attrs="{'invisible':['|',('update_key', '!=', False), ('post_type', '!=', 'share_post')]}"
                                groups="base.group_user"/>
                        <button name="share_linkedin_article" string="Share Article" type="object"
                                attrs="{'invisible':['|',('update_key', '!=', False), ('post_type', '!=', 'share_article')]}"
                                groups="base.group_user"/>

                        <button name="share_linkedin_image" string="Share image" type="object"
                                attrs="{'invisible':['|',('update_key', '!=', False), ('post_type', '!=', 'share_image_post')]}"
                                groups="base.group_user"/>
                        <button name="post_job_to_linkedin" string="Job Post" type="object"
                                attrs="{'invisible':['|',('update_key', '!=', False), ('post_type', '!=', 'job_post')]}"
                                groups="base.group_user"/>
                        <button name="%(odoo_linkedin.action_multiple_user_selection)d" string="multiple Share Post"
                                type="action"
                                attrs="{'invisible':[('update_key', '!=', False)]}"
                                groups="base.group_user" context="{'default_post_type':post_type,
                                                                    'default_user_ids': [(4, uid)] }"/>
                        <button name="delete_post" string="Delete Post" type="object"
                                attrs="{'invisible':[('update_key', '=', False)]}"
                                groups="base.group_user"/>
                        <button name="send_draft" string="Share To Draft" type="object"
                                groups="base.group_user" invisible="True"/>
                    </header>
                </xpath>
                <xpath expr="//field[@name='description']" position="before">
                    <group>
                        <field name="post_type" widget="radio"/>
                        <field name="automate_post" attrs="{'readonly':[('update_key', '=', True)]}"/>
                        <field name="attachment_ids" widget="many2many_binary" attrs="{'invisible':[('post_type', '!=', 'share_image_post')]}"/>

                        <field name="job_title" attrs="{'invisible':[('post_type', '!=', 'job_post')]}"/>
                        <field name="job_location" attrs="{'invisible':[('post_type', '!=', 'job_post')]}"/>
                        <field name="job_skill" attrs="{'invisible':[('post_type', '!=', 'job_post')]}"/>
                        <field name="job_type" widget="radio" attrs="{'invisible':[('post_type', '!=', 'job_post')]}"/>

                        <field name="post_date" attrs="{
                        'invisible':[('automate_post', '=', False)],
                        'required': [('automate_post','=', True)],
                        'readonly': [('update_key','=', True)]}" />
                        <field name="user_ids" attrs="{
                        'invisible':[('automate_post', '=', False)],
                        'required': [('automate_post','=', True)],
                        'readonly': [('update_key','=', True)]}" widget="many2many_tags"/>
                    </group>
                    <group attrs="{
                    'invisible':[('post_type', '!=', 'share_article')]
                    }">
                        <field name="article_blog_url" placeholder="Ex:https://www.example.com/content.html"
                               attrs="{'required':[('post_type', '=', 'share_article')]}"/>
                        <field name="article_blog_image_url" placeholder="Ex:https://www.example.com/image.jpg"
                               attrs="{'required':[('post_type', '=', 'share_article')]}"/>
                        <field name="article_blog_title" placeholder="Ex:Example Blog"
                               attrs="{'required':[('post_type', '=', 'share_article')]}"/>
                    </group>
                </xpath>
                <xpath expr="//field[@name='description']" position="before">
                    <field name="update_key"  invisible="True"/>
                    <field name="share_id" invisible="True"/>
                    <field name="multiple_user_share_ids"  invisible="True" string="Shared Via Users">
                        <tree>
                            <field name="share_id"/>
                            <field name="job_id"/>
                            <field name="share_user_id" force_save="1"/>
                        </tree>
                    </field>
                    <div name="info_form" class="text-center text-danger d-inline-block"
                        attrs="{'invisible':[('post_type', '!=', 'share_image_post')]}">
                        Please be add your images into the attachment(Image Format Should Be PNG, JPEG, JPG, or GIF)
                    </div>
                </xpath>

            </field>
        </record>
    </data>
</odoo>
