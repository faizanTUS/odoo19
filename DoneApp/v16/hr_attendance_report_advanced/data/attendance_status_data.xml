<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Default Attendance Statuses -->
        <record id="status_present" model="hr.attendance.status">
            <field name="name">Present</field>
            <field name="code">P</field>
            <field name="color">#28a745</field>
            <field name="sequence">10</field>
            <field name="is_working">True</field>
            <field name="is_absent">False</field>
            <field name="is_leave">False</field>
            <field name="is_weekoff">False</field>
        </record>

        <record id="status_half_day" model="hr.attendance.status">
            <field name="name">Half Day</field>
            <field name="code">H/F</field>
            <field name="color">#007bff</field>
            <field name="sequence">20</field>
            <field name="is_working">True</field>
            <field name="is_absent">False</field>
            <field name="is_leave">False</field>
            <field name="is_weekoff">False</field>
        </record>

        <record id="status_absent" model="hr.attendance.status">
            <field name="name">Absent</field>
            <field name="code">A</field>
            <field name="color">#dc3545</field>
            <field name="sequence">30</field>
            <field name="is_working">False</field>
            <field name="is_absent">True</field>
            <field name="is_leave">False</field>
            <field name="is_weekoff">False</field>
        </record>

        <record id="status_leave" model="hr.attendance.status">
            <field name="name">On Leave</field>
            <field name="code">L</field>
            <field name="color">#e83e8c</field>
            <field name="sequence">40</field>
            <field name="is_working">False</field>
            <field name="is_absent">False</field>
            <field name="is_leave">True</field>
            <field name="is_weekoff">False</field>
        </record>

        <record id="status_weekoff" model="hr.attendance.status">
            <field name="name">Week Off</field>
            <field name="code">WO</field>
            <field name="color">#6c757d</field>
            <field name="sequence">50</field>
            <field name="is_working">False</field>
            <field name="is_absent">False</field>
            <field name="is_leave">False</field>
            <field name="is_weekoff">True</field>
        </record>

        <record id="status_holiday" model="hr.attendance.status">
            <field name="name">Holiday</field>
            <field name="code">H</field>
            <field name="color">#17a2b8</field>
            <field name="sequence">60</field>
            <field name="is_working">False</field>
            <field name="is_absent">False</field>
            <field name="is_leave">False</field>
            <field name="is_weekoff">True</field>
        </record>
    </data>
</odoo>