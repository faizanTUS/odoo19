<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="hr_attendance_report_advanced.AttendanceDashboard">
        <div class="o_attendance_dashboard">
            <div t-if="state.loading" class="dashboard-loading">
                <i class="fa fa-spinner"></i>
                <p>Loading dashboard data...</p>
                    </div>
            <div t-else="">
                <div class="kpi-section">
                    <h3>Key Performance Indicators</h3>
                    <div class="kpi-cards" t-ref="kpi_cards"></div>
                    </div>
                <div class="charts-section">
                    <div class="chart-container">
                        <h4>Daily Attendance Trends</h4>
                        <canvas t-ref="trends_chart"></canvas>
                    </div>
                    <div class="chart-container">
                        <h4>Department Attendance Rates</h4>
                        <canvas t-ref="department_chart"></canvas>
                    </div>
                    <div class="chart-container">
                        <h4>Punctuality Analysis</h4>
                        <canvas t-ref="punctuality_chart"></canvas>
                    </div>
                    <div class="chart-container">
                        <h4>Overtime Distribution</h4>
                        <canvas t-ref="overtime_chart"></canvas>
                    </div>
                </div>
                <div class="status-section">
                    <h3>Current Employee Status</h3>
                    <div t-ref="current_status_container"></div>
                </div>
            </div>
        </div>
    </t>
</templates>
