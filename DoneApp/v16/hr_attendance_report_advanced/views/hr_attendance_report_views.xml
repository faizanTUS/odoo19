<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Report Wizard Form View -->
    <record id="view_attendance_report_wizard_form" model="ir.ui.view">
        <field name="name">attendance.report.wizard.form</field>
        <field name="model">attendance.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Employee Attendance Report">
                <sheet>
                    <group>
                        <group string="Report Type">
                            <field name="report_type"/>
                            <field name="output_format"/>
                        </group>
                        <group string="Date Range">
                            <field name="date_from"/>
                            <field name="date_to"/>
                        </group>
                    </group>

                    <group string="Filters">
                        <group>
                            <field name="employee_ids" widget="many2many_tags"/>
                            <field name="department_ids" widget="many2many_tags"/>
                            <field name="company_id"/>
                        </group>
                        <group>
                            <field name="filter_status_ids" widget="many2many_tags"/>
                            <field name="include_inactive"/>
                            <field name="include_weekends"/>
                            <field name="include_holidays"/>
                        </group>
                    </group>

                    <group string="Options">
                        <group>
                            <field name="group_by"/>
                            <field name="show_hours"/>
                            <field name="show_overtime"/>
                            <field name="show_breaks"/>
                        </group>
                        <group>
                            <field name="min_hours"/>
                            <field name="max_hours"/>
                        </group>
                    </group>

                    <group string="Notifications">
                        <group>
                            <field name="send_email"/>
<!--                            <field name="recipient_ids" invisible="send_email == False"  widget="many2many_tags"/>-->
                            <field name="recipient_ids" attrs="{'invisible': [('send_email', '=', False)]}"  widget="many2many_tags"/>
<!--                            <field name="email_template_id" invisible="send_email == False"/>-->
                            <field name="email_template_id" attrs="{'invisible': [('send_email', '=', False)]}"/>
                        </group>
                    </group>

                    <footer>
                        <button name="action_generate_report" string="Generate Report" type="object" class="btn-primary"/>
                        <button name="action_open_analytics_dashboard" string="Open Analytics" type="object" class="btn-secondary"/>
                        <button string="Cancel" class="btn-secondary" special="cancel"/>
                    </footer>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action for Report Wizard -->
    <record id="action_attendance_report_wizard" model="ir.actions.act_window">
        <field name="name">Attendance Report</field>
        <field name="res_model">attendance.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{'default_report_type': 'detailed', 'default_output_format': 'pdf'}</field>
    </record>
</odoo>