<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="action_report_petty_cash_aging" model="ir.actions.report">
        <field name="name">Petty Cash Aging (PDF)</field>
        <field name="model">petty.cash.voucher</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">petty_cash_management.report_petty_cash_aging_document</field>
        <field name="report_file">petty_cash_management.report_petty_cash_aging_document</field>
        <field name="binding_model_id" ref="model_petty_cash_voucher"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_petty_cash_aging_document">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">

                <div class="page">

                    <!-- Beautiful Header -->
                    <div class="row mb-4">
                        <div class="col-12 text-center">
                            <h1 class="text-primary fw-bold" style="font-size: 28px; margin-bottom: 8px;">
                                Petty Cash Aging Report
                            </h1>
                            <p class="text-muted mb-0" style="font-size: 15px;">
                                As of <span t-esc="context_timestamp(datetime.datetime.now()).strftime('%d %B %Y')"/>
                            </p>
                        </div>
                    </div>

                    <!-- Report Summary Info -->
                    <div class="row mb-3">
                        <div class="6">
                            <strong>Generated On:</strong>
                            <span t-esc="context_timestamp(datetime.datetime.now()).strftime('%d/%m/%Y %H:%M')"/>
                        </div>
                        <div class="col-6 text-end">
                            <strong>Total Vouchers:</strong>
                            <span t-esc="len(docs)"/>
                        </div>
                    </div>

                    <!-- Main Table -->
                    <table class="table table-sm table-bordered o_main_table" style="font-size: 13.5px;">
                        <thead>
                            <tr class="table-primary text-center" style="background-color: #0d6efd; color: white;">
                                <th class="text-start ps-3">Reference</th>
                                <th class="text-start">Fund</th>
                                <th class="text-start">Employee</th>
                                <th class="text-center">Date</th>
                                <th class="text-end pe-3">Amount</th>
                                <th class="text-center">Status</th>
                                <th class="text-center">Days Pending</th>
                                <th class="text-center">Aging Bucket</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="docs" t-as="v">
                                <tr>
                                    <td class="ps-3 fw-semibold"><span t-field="v.name"/></td>
                                    <td><span t-field="v.fund_id"/></td>
                                    <td><span t-field="v.employee_id"/></td>
                                    <td class="text-center">
                                        <span t-field="v.date" t-options='{"widget": "date"}'/>
                                    </td>
                                    <td class="text-end pe-3 fw-semibold">
                                        <span t-field="v.amount"
                                              t-options='{"widget": "monetary", "display_currency": v.currency_id or res_company.currency_id}'/>
                                    </td>
                                    <td class="text-center">
                                        <span t-attf-class="badge {{
                                            'bg-secondary' if v.state == 'draft' else
                                            'bg-info' if v.state in ('submitted', 'under_approval') else
                                            'bg-success' if v.state == 'approved' else
                                            'bg-primary' if v.state == 'paid' else
                                            'bg-danger' if v.state == 'rejected' else
                                            'bg-dark' if v.state == 'cancelled' else
                                            'bg-light text-dark'
                                        }}">
                                            <t t-esc="v.state"/>
                                        </span>
                                    </td>
                                    <td class="text-center fw-bold"
                                        t-att-class="'text-danger' if v.days_pending > 45 else 'text-warning' if v.days_pending > 15 else 'text-success'">
                                        <span t-esc="v.days_pending"/>
                                    </td>
                                    <td class="text-center">
                                        <span t-attf-class="badge px-3 py-1 {{
                                            'bg-danger' if v.aging_bucket == '31_plus' else
                                            'bg-warning' if v.aging_bucket == '16_30' else
                                            'bg-success'
                                        }}">
                                            <span t-field="v.aging_bucket"/>
                                        </span>
                                    </td>
                                </tr>
                            </t>
                        </tbody>

                        <!-- Total Row -->
                        <tfoot>
                            <tr class="table-light fw-bold fs-6" style="border-top: 3px solid #0d6efd;">
                                <td colspan="4" class="text-end pe-3">**Total Amount**</td>
                                <td class="text-end pe-3">
                                    <span t-esc="sum(doc.amount for doc in docs)"
                                          t-options='{"widget": "monetary", "display_currency": res_company.currency_id}'/>
                                </td>
                                <td colspan="3"></td>
                            </tr>
                        </tfoot>
                    </table>

                    <!-- Footer Note -->
                    <div class="mt-5 text-center text-muted" style="font-size: 12px;">
                        <p class="mb-1">* Aging is calculated based on days pending from the voucher date.</p>
                        <p class="mb-0">Color coding: Green (Recent) → Yellow (Moderate) → Red (Overdue)</p>
                    </div>

                </div>

            </t>
        </t>
    </template>

</odoo>