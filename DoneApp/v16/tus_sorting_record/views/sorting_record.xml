<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data>
        <record id="view_sorting_record_tree" model="ir.ui.view">
            <field name="name">sorting.record.tree</field>
            <field name="model">sorting.record</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="name" />
                </tree>
            </field>
        </record>

        <record id="view_sorting_record_form" model="ir.ui.view">
            <field name="name">sorting.record.form</field>
            <field name="model">sorting.record</field>
            <field name="arch" type="xml">
                <form string="PrintNode System">
                    <header>
                    </header>
                    <sheet>
                        <group>
                            <group>
                                <field name="name" required="1" />
                                <field name="is_active" />
                            </group>
                            <group>
                                <field name="user_ids" widget="many2many_tags" />
                            </group>
                        </group>
                        <notebook>
                            <page name="Sorting Record Lines">
                                <field name="sort_line_ids" nolabel="1">
                                    <tree editable="bottom">
                                        <field name="model_id" required="1" />
                                        <field name="fields_id" required="1" />
                                        <field name="order_type" required="1" />
                                        <field name="sort_id" invisible="1" />
                                    </tree>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>


        <record id="action_sorting_record" model="ir.actions.act_window">
            <field name="name">Sorting Record</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">sorting.record</field>
            <field name="view_mode">tree,form</field>
        </record>

        <menuitem
            id="menu_action_psorting_record"
            name="Sorting Record"
            parent="base.menu_users"
            action="action_sorting_record"
            groups="sorting_record_group_user"
            sequence="100"
        />
    </data>
</odoo>
