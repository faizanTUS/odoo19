<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Inherit POS order list view to add "Cancel POS Orders" button -->
    <record id="view_pos_order_tree_cancel" model="ir.ui.view">
        <field name="name">pos.order.list.cancel</field>
        <field name="model">pos.order</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_order_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//tree" position="inside">
                <header>
                    <button name="action_cancel_pos_orders_wizard"
                            string="Cancel POS Orders"
                            type="object"
                            class="btn-primary"/>
                </header>
            </xpath>
        </field>
    </record>
</odoo>
