<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- Add Pricelist column and Multi Pricelist button to order lines list -->
    <record id="view_order_form_multi_pricelist" model="ir.ui.view">
        <field name="name">sale.order.form.multi.pricelist</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <!-- Add Pricelist column after Unit Price in order lines list -->
            <xpath expr="//field[@name='order_line']/tree/field[@name='price_unit']" position="after">
                <field name="effective_pricelist_id" optional="show" readonly="1" string="Pricelist" groups="sale_multi_pricelist.sale_multi_pricelist_group_user"/>
                <field name="pricelist_id" optional="hide" attrs="{'column_invisible': True}" context="{'hide_currency_in_name': True}" groups="sale_multi_pricelist.sale_multi_pricelist_group_user"/>
                <button name="action_open_multi_pricelist_wizard"
                        type="object"
                        string="Multi Pricelist"
                        title="Compare and apply a pricelist for this line"
                        class="btn-link"
                        attrs="{'invisible': ['|', '|', ('display_type', '!=', False), ('product_id', '=', False), ('is_downpayment', '=', True)]}"
                        groups="sale_multi_pricelist.sale_multi_pricelist_group_user"/>
            </xpath>
        </field>
    </record>

    <!-- Inline form: allow editing line pricelist next to price -->
    <record id="view_order_form_multi_pricelist_line_form" model="ir.ui.view">
        <field name="name">sale.order.form.multi.pricelist.line.form</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']/form/group/group/field[@name='price_unit']" position="after">
                <field name="pricelist_id" options="{'no_create': True}" context="{'order_id': parent.id}" groups="sale_multi_pricelist.sale_multi_pricelist_group_user"/>
                <field name="effective_pricelist_id" attrs="{'column_invisible': True}" groups="sale_multi_pricelist.sale_multi_pricelist_group_user"/>
            </xpath>
        </field>
    </record>

</odoo>
