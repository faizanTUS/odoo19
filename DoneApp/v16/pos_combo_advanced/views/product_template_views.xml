<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Product Combo Configuration + Combo Items: both pages in one inheritance to avoid xpath order issues -->
    <record id="product_template_form_view_combo_config" model="ir.ui.view">
        <field name="name">product.template.form.combo.config</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <page name="general_information" position="after">
                <page string="Product Combo Configuration" name="pos_combo_config">
                    <group string="Combo Settings">
                        <group>
                            <field name="is_combo_product" widget="boolean_toggle"/>
                            <field name="max_combo_items" attrs="{'invisible':[('is_combo_product','=',False)]}"/>
                            <field name="combo_display" attrs="{'invisible':[('is_combo_product','=',False)]}"/>
                        </group>
                        <group attrs="{'invisible':[('is_combo_product','=',False)]}" >
                            <field name="pos_combo_group_ids" widget="many2many_tags" options="{'no_create': True}"/>
                        </group>
                    </group>
                    <!-- <div class="alert alert-warning mb-0" role="alert" invisible="not is_combo_product or type == 'service'">
                        <p class="mb-0">
                            <strong>Warning:</strong> To avoid inventory tracking issues, combo products should be of type <strong>Service</strong>.
                            <button name="action_set_type_service" type="object" string="Fix Inventory Type" class="btn btn-link btn-sm p-0 align-baseline"/>
                        </p>
                    </div> -->
                    <group string="Combo Line" attrs="{'invisible':[('is_combo_product','=',False)]}" >
                        <field name="pos_combo_line_ids">
                            <tree editable="bottom">
                                <field name="product_id"/>
                                <field name="min_qty"/>
                                <field name="max_qty"/>
                                <field name="default_qty"/>
                            </tree>
                        </field>
                    </group>
                </page>
<!--                <page string="Combo Items" name="combo_items" attrs="{'invisible':[('type','!=','combo')]}">-->
