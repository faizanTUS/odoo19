<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_general_general_configuration" model="ir.ui.view">
        <field name="name">res.config.settings.smtp.routing</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='integration']" position="after">
                <h2>SMTP Configuration</h2>
                <div class="row mt16 o_settings_container" name="smtp_configuration">
                    <div class="col-12 col-lg-6 o_setting_box" id="smtp_by_company">
                        <div class="o_setting_left_pane">
                            <field name="smtp_by_company" attrs="{'invisible': [('smtp_by_user', '=', True)]}"/>
                        </div>
                        <div class="o_setting_right_pane">
                            <label string="SMTP By Company" for="smtp_by_company"/>
                        </div>
                    </div>
                    <div class="col-12 col-lg-6 o_setting_box" id="smtp_by_user">
                        <div class="o_setting_left_pane">
                            <field name="smtp_by_user"/>
                        </div>
                        <div class="o_setting_right_pane">
                            <label string="SMTP By User" for="smtp_by_user"/>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
