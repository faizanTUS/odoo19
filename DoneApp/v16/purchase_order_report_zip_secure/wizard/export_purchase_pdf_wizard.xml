<odoo>
    <record id="view_purchase_pdf_export_wizard_form" model="ir.ui.view">
        <field name="name">pdf.export.wizard.form</field>
        <field name="model">export.purchase.pdf.wizard</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <field name="is_production" invisible="1"/>
                    <field name="is_purchase" invisible="1"/>
                    <field name="is_purchase_rfq" invisible="1"/>

                    <div attrs="{'invisible':[('is_purchase','!=',True)]}" groups="purchase_order_report_zip_secure.group_export_purchase_order_pdf">
                        <h1>Purchase Order</h1>
                    </div>
                    <div attrs="{'invisible':[('is_purchase_rfq','!=',True)]}" groups="purchase_order_report_zip_secure.group_export_purchase_order_pdf">
                        <h1>Purchase Quotation</h1>
                    </div>

                    <div>
                        <group>
                            <group>
                            <field name="zip_password" password="True" string="Zip Password"/>
                            </group>
                        </group>
                    </div>

                    <field name="purchase_order_ids" attrs="{'invisible':[('is_purchase_rfq','!=',True)]}"  nolabel="1">
                        <tree>
                            <field name="name"/>
                            <field name="date_approve"/>
                            <field name="partner_id"/>
                            <field name="company_id"/>
                            <field name="user_id"/>
                            <field name="origin"/>
                            <field name="amount_total"/>
                            <field name="invoice_status"/>
                            <field name="date_planned"/>
                        </tree>
                    </field>

                    <field name="purchase_order_ids" attrs="{'invisible':[('is_purchase','!=',True)]}" nolabel="1">
                        <tree>
                            <field name="name"/>
                            <field name="date_approve"/>
                            <field name="partner_id"/>
                            <field name="company_id"/>
                            <field name="user_id"/>
                            <field name="origin"/>
                            <field name="amount_total"/>
                            <field name="invoice_status"/>
                            <field name="date_planned"/>
                        </tree>
                    </field>

                </sheet>
                <footer>
                    <button string="Export Purchase Quotation Zip" type="object" attrs="{'invisible':[('is_purchase_rfq','!=',True)]}"
                            name="action_purchase_quotation" class="oe_highlight"/>
                    <button string="Export Purchase Order Zip" type="object" attrs="{'invisible':[('is_purchase','!=',True)]}"
                            name="action_purchase_order" class="oe_highlight"/>
                    <button string="Export all Purchase Order/Quotation" type="object"
                            attrs="{'invisible':['|',('is_purchase_rfq','!=',True),('is_production','==',True)]}" name="action_all_purchase_quotation"
                            class="oe_highlight"/>

                    <button string="Cancel" class="oe_link" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
