<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Standalone settings view: do NOT inherit account form to avoid pulling in
         fields from other modules (e.g. base_vat.vat_check_vies) that may not be
         loaded, which causes OwlError "field is undefined". -->
    <record id="res_config_settings_view_form_pending_payment_report" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.pending.payment.report</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="priority" eval="50"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('settings')]" position="inside">
                <div class="app_settings_block" data-string="Pending Payment Report"
                     string="Pending Payment Report" data-key="pending_payment_report">
                    <h2>Auto-send report</h2>

                    <div class="row mt16 o_settings_container">
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_right_pane">
                                <label for="pending_payment_report_recipient_id"/>
                                <div class="text-muted">
                                    Partner who receives the Pending Payment Report
                                    when you click 'Send to Configured User' in the wizard.
                                </div>
                                <field name="pending_payment_report_recipient_id"
                                       placeholder="Select partner..."/>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>

    <record id="action_pending_payment_report_settings" model="ir.actions.act_window">
        <field name="name">Pending Payment Report Settings</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="target">inline</field>
        <field name="context">{'module': 'pending_payment_report'}</field>
        <field name="view_id" ref="res_config_settings_view_form_pending_payment_report"/>
    </record>

    <menuitem id="menu_pending_payment_report_settings"
              name="Pending Payment Report Settings"
              parent="account.menu_finance_configuration"
              action="action_pending_payment_report_settings"
              sequence="50"/>
</odoo>
