<odoo>
    <record id="res_config_settings_view_barcode" model="ir.ui.view">
        <field name="name">res.config.settings.barcode</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('settings')]" position="inside">
                <div class="app_settings_block" data-string="Barcode Generator"
                     string="Barcode Generator Configuration" data-key="tus_product_barcode_generator" groups="tus_product_barcode_generator.product_product_barcode_generator_group_user">

                    <h2>Barcode</h2>
                    <div class="row mt16 o_settings_container" id="auto_generate_barcode_setti">
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane">
                                <field name="auto_generate_barcode"/>
                            </div>
                            <div class="o_setting_right_pane">
                                  <span class="o_form_label">Generate Barcode On Product Creation</span>

                            </div>
                        </div>

                        <div class="col-12 col-lg-6 o_setting_box" id="barcode_type_setti">
                            <div class="o_setting_right_pane">
                                <span class="o_form_label">Barcode Type</span>
                                <div class="content-group">
                                    <div class="mt16">
                                        <field name="barcode_type"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
