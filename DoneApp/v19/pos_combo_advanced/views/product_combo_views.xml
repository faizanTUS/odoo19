<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Add Quantity column to combo item list (product.combo form) -->
    <record id="product_combo_view_form_quantity" model="ir.ui.view">
        <field name="name">product.combo.form.quantity</field>
        <field name="model">product.combo</field>
        <field name="inherit_id" ref="product.product_combo_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='combo_item_ids']/list/field[@name='product_id']" position="after">
                <field name="quantity" widget="float"/>
            </xpath>
        </field>
    </record>

    <!-- List view for product.combo.item (View Combo Items action) -->
    <record id="product_combo_item_view_tree" model="ir.ui.view">
        <field name="name">product.combo.item.tree</field>
        <field name="model">product.combo.item</field>
        <field name="arch" type="xml">
            <list string="Combo Items" editable="bottom">
                <field name="combo_id"/>
                <field name="product_id"/>
                <field name="quantity" widget="float"/>
                <field name="lst_price" widget="monetary" options="{'field_digits': True}"/>
                <field name="extra_price" widget="monetary" options="{'field_digits': True}"/>
                <field name="currency_id" column_invisible="True"/>
            </list>
        </field>
    </record>
</odoo>
