<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_mail_font" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.mail.font</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="mail.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <!--  Add font setting inside the Emails block, after the template rendering restriction -->
            <setting id="restrict_template_rendering_setting" position="after">
                <setting string="Default Email Font Family"
                         help="Font family applied to the message composer, log note input, and mail template body editor. The selected font is also embedded in the sent message HTML.">
                    <field name="mail_font_family"/>
                </setting>
            </setting>
        </field>
    </record>
</odoo>
