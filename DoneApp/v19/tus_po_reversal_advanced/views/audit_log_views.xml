<odoo>
    <record id="view_reversal_audit_log_tree" model="ir.ui.view">
        <field name="name">tus.reversal.audit.log.tree</field>
        <field name="model">tus.reversal.audit.log</field>
        <field name="arch" type="xml">
            <list>
                <field name="create_date"/>
                <field name="origin"/>
                <field name="user_id"/>
                <field name="model"/>
                <field name="display_name_related"/>
                <field name="reason"/>
                <field name="note"/>
                <field name="action" widget="badge" decoration-info="action == 'reset'"
                       decoration-warning="action == 'reverse'" decoration-danger="action == 'cancel'"/>

            </list>
        </field>
    </record>

