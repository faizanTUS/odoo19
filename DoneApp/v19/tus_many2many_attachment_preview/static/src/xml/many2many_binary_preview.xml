<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-inherit="web.Many2ManyBinaryField.attachment_preview" t-inherit-mode="extension">
        <xpath expr="//div[@class='o_attachment_uploaded']" position="after">
            <div
                t-if="map2IsPreviewable(file)"
                class="o_map2_attachment_preview_btn d-flex align-items-center justify-content-center cursor-pointer"
                t-on-click.stop="() => this.onPreviewMany2many(file)"
                role="button"
                t-att-aria-label="'Preview ' + file.name"
                t-att-title="'Preview ' + file.name"
            >
                <i class="fa fa-eye text-primary" role="img"/>
            </div>
        </xpath>
    </t>

</templates>
