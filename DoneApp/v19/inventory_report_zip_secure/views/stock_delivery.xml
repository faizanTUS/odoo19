<odoo>
    <record id="action_delivery_export_zip" model="ir.actions.server">
        <field name="name">Export Receipts/Deliveries</field>
        <field name="model_id" ref="stock.model_stock_picking"/>
        <field name="binding_model_id" ref="stock.model_stock_picking"/>
        <field name="state">code</field>
        <field name="group_ids" eval="[(4, ref('inventory_report_zip_secure.group_export_deliveries_receipts'))]"/>
        <field name="code">
            action = {
                'name': 'Export Receipts/Deliveries',
                'type': 'ir.actions.act_window',
                'res_model': 'export.delivery.pdf.wizard',
                'view_mode': 'form',
                'target': 'new',
                'context': {'default_picking_ids': [record.id for record in records],
                            'default_is_delivery':True,
            },
            }
        </field>
    </record>
    <record id="deliveries_list_view_action" model="ir.ui.view">
        <field name="name">delivery.list.view</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.vpicktree"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="%(action_delivery_export_zip)d" type="action" string="Export Receipts/Deliveries" groups="inventory_report_zip_secure.group_export_deliveries_receipts"/>
            </xpath>
        </field>
    </record>
</odoo>