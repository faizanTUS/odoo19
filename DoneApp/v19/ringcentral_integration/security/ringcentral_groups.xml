<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <record model="ir.module.category" id="module_category_ringcentral">
            <field name="name">RingCentral</field>
            <field name="description">RingCentral Integration - Manage calls, history, and settings</field>
            <field name="sequence">60</field>
        </record>

        <!-- Single privilege: one access row on the user form (User or Administrator) -->
        <record model="res.groups.privilege" id="res_groups_privilege_ringcentral">
            <field name="name">RingCentral</field>
            <field name="category_id" ref="module_category_ringcentral"/>
        </record>

        <record id="group_ringcentral_user" model="res.groups">
            <field name="name">User</field>
            <field name="sequence">10</field>
            <field name="comment">Access RingCentral menu, own dashboard, own call history, and calling widget.</field>
            <field name="privilege_id" ref="res_groups_privilege_ringcentral"/>
        </record>

        <record id="group_ringcentral_admin" model="res.groups">
            <field name="name">Administrator</field>
            <field name="sequence">20</field>
            <field name="comment">Full RingCentral access including configuration, OAuth, sync, and all call logs.</field>
            <field name="privilege_id" ref="res_groups_privilege_ringcentral"/>
            <field name="implied_ids" eval="[(4, ref('group_ringcentral_user'))]"/>
        </record>
    </data>
</odoo>
