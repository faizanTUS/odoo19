<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_analytics_report" model="ir.actions.report">
            <!-- Display name of the report -->
            <field name="name">Analytics Report</field>

            <!-- The model this report is linked to -->
            <field name="model">attendance.analytics.wizard</field>

            <!-- Report type -->
            <field name="report_type">qweb-pdf</field>

            <!-- QWeb template name (important) -->
            <field name="report_name">hr_attendance_report_advanced.analytics_report_template</field>

            <!-- File name (usually same as report_name) -->
            <field name="report_file">hr_attendance_report_advanced.analytics_report_template</field>

            <!-- Optional: Make it appear in the Print menu -->
            <field name="binding_model_id" ref="hr_attendance_report_advanced.model_attendance_analytics_wizard"/>
            <field name="binding_type">report</field>

            <!-- Paper format (A4 is default, but you can specify) -->
            <!-- <field name="paperformat_id" ref="base.paperformat_euro"/> -->
        </record>
</odoo>
