<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ========================================================= -->
    <!-- Privilege (replaces category_id in Odoo v19)              -->
    <!-- ========================================================= -->
    <record id="res_groups_privilege_attendance_report" model="res.groups.privilege">
        <field name="name">Attendance Reports</field>
        <field name="category_id" ref="base.module_category_human_resources"/>
        <field name="sequence">30</field>
    </record>

    <!-- ========================================================= -->
    <!-- Security Groups                                           -->
    <!-- ========================================================= -->
    <record id="group_attendance_report_user" model="res.groups">
        <field name="name">Attendance Report User</field>
        <field name="privilege_id" ref="res_groups_privilege_attendance_report"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_attendance_report_manager" model="res.groups">
        <field name="name">Attendance Report Manager</field>
        <field name="privilege_id" ref="res_groups_privilege_attendance_report"/>
        <field name="implied_ids" eval="[(4, ref('group_attendance_report_user'))]"/>
    </record>

    <record id="group_attendance_report_admin" model="res.groups">
        <field name="name">Attendance Report Administrator</field>
        <field name="privilege_id" ref="res_groups_privilege_attendance_report"/>
        <field name="implied_ids" eval="[(4, ref('group_attendance_report_manager'))]"/>
    </record>

    <!-- ========================================================= -->
    <!-- Record rules for Attendance                               -->
    <!-- ========================================================= -->
    <record id="hr_attendance_report_user_rule" model="ir.rule">
        <field name="name">Attendance Report User Rule</field>
        <field name="model_id" ref="hr_attendance.model_hr_attendance"/>
        <field name="domain_force">
            ['|',
                ('employee_id.department_id.manager_id', '=', user.id),
                ('employee_id.parent_id.user_id', '=', user.id)
            ]
        </field>
        <field name="groups" eval="[(4, ref('group_attendance_report_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="hr_attendance_report_manager_rule" model="ir.rule">
        <field name="name">Attendance Report Manager Rule</field>
        <field name="model_id" ref="hr_attendance.model_hr_attendance"/>
        <field name="domain_force">
            ['|',
                ('employee_id.department_id.manager_id', '=', user.id),
                ('employee_id.parent_id.user_id', '=', user.id)
            ]
        </field>
        <field name="groups" eval="[(4, ref('group_attendance_report_manager'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="hr_attendance_report_admin_rule" model="ir.rule">
        <field name="name">Attendance Report Admin Rule</field>
        <field name="model_id" ref="hr_attendance.model_hr_attendance"/>
        <field name="groups" eval="[(4, ref('group_attendance_report_admin'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <!-- ========================================================= -->
    <!-- Rules for Attendance Status                               -->
    <!-- ========================================================= -->
    <record id="hr_attendance_status_user_rule" model="ir.rule">
        <field name="name">Attendance Status User Rule</field>
        <field name="model_id" ref="model_hr_attendance_status"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_attendance_report_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="hr_attendance_status_manager_rule" model="ir.rule">
        <field name="name">Attendance Status Manager Rule</field>
        <field name="model_id" ref="model_hr_attendance_status"/>
        <field name="groups" eval="[(4, ref('group_attendance_report_manager'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="hr_attendance_status_admin_rule" model="ir.rule">
        <field name="name">Attendance Status Admin Rule</field>
        <field name="model_id" ref="model_hr_attendance_status"/>
        <field name="groups" eval="[(4, ref('group_attendance_report_admin'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <!-- ========================================================= -->
    <!-- Rules for Report Wizard                                   -->
    <!-- ========================================================= -->
    <record id="attendance_report_wizard_user_rule" model="ir.rule">
        <field name="name">Attendance Report Wizard User Rule</field>
        <field name="model_id" ref="model_attendance_report_wizard"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_attendance_report_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
    </record>

</odoo>
