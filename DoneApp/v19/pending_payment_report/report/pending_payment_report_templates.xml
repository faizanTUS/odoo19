<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="report_pending_payment_report">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="wizard">
                <t t-call="web.external_layout">
                    <div class="page">

                        <!-- ================= HEADER ================= -->
                        <div style="border-bottom: 2px solid #2c3e50; padding-bottom: 10px; margin-bottom: 20px;">
                            <h2 style="margin: 0; color: #2c3e50;">Pending Payment Report</h2>
                            <div style="margin-top: 8px; font-size: 13px;">
                                <strong>Due Date From:</strong>
                                <span t-esc="wizard.due_date_from"/>
                                <strong>Due Date To:</strong>
                                <span t-esc="wizard.due_date_to"/>
                                <strong>Invoice Type:</strong>
                                <span t-esc="dict(wizard._fields['invoice_type'].selection).get(wizard.invoice_type)"/>
                            </div>
                        </div>

                        <!-- ================= SUMMARY ================= -->
                        <h4 style="color:#34495e; margin-bottom:10px;">Summary</h4>

                        <table style="width:100%; border-collapse:collapse; font-size:13px;">
                            <thead>
                                <tr style="background-color:#f2f2f2;">
                                    <th style="padding:10px; border:1px solid #000; text-align:left;">Customer</th>
                                    <th style="padding:10px; border:1px solid #000; text-align:right;">Total</th>
                                    <th style="padding:10px; border:1px solid #000; text-align:right;">Paid Amount</th>
                                    <th style="padding:10px; border:1px solid #000; text-align:right;">Pending Amount</th>
                                    <th style="padding:10px; border:1px solid #000; text-align:right;">Invoices</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-set="grand_total" t-value="0"/>
                                <t t-set="grand_paid" t-value="0"/>
                                <t t-set="grand_pending" t-value="0"/>
                                <t t-set="total_count" t-value="0"/>

                                <t t-foreach="wizard.line_ids" t-as="line">
                                    <tr>
                                        <td style="padding:8px 12px; border:1px solid #000;">
                                            <t t-esc="line.partner_id.display_name"/>
                                        </td>
                                        <td style="padding:8px 12px; border:1px solid #000; text-align:right;">
                                            <t t-esc="'{:,.2f}'.format(line.total or 0)"/>
                                        </td>
                                        <td style="padding:8px 12px; border:1px solid #000; text-align:right;">
                                            <t t-esc="'{:,.2f}'.format(line.paid_amount or 0)"/>
                                        </td>
                                        <td style="padding:8px 12px; border:1px solid #000; text-align:right;">
                                            <t t-esc="'{:,.2f}'.format(line.pending_amount or 0)"/>
                                        </td>
                                        <td style="padding:8px 12px; border:1px solid #000; text-align:right;">
                                            <t t-esc="line.invoice_count"/>
                                        </td>
                                    </tr>

                                    <t t-set="grand_total" t-value="grand_total + (line.total or 0)"/>
                                    <t t-set="grand_paid" t-value="grand_paid + (line.paid_amount or 0)"/>
                                    <t t-set="grand_pending" t-value="grand_pending + (line.pending_amount or 0)"/>
                                    <t t-set="total_count" t-value="total_count + line.invoice_count"/>
                                </t>

                                <!-- Grand Total -->
                                <tr style="background-color:#e6e6e6; font-weight:bold;">
                                    <td style="padding:10px; border:1px solid #000;">Grand Total</td>
                                    <td style="padding:10px; border:1px solid #000; text-align:right;">
                                        <t t-esc="'{:,.2f}'.format(grand_total)"/>
                                    </td>
                                    <td style="padding:10px; border:1px solid #000; text-align:right;">
                                        <t t-esc="'{:,.2f}'.format(grand_paid)"/>
                                    </td>
                                    <td style="padding:10px; border:1px solid #000; text-align:right;">
                                        <t t-esc="'{:,.2f}'.format(grand_pending)"/>
                                    </td>
                                    <td style="padding:10px; border:1px solid #000; text-align:right;">
                                        <t t-esc="total_count"/>
                                    </td>
                                </tr>
                            </tbody>
                        </table>

                        <!-- ================= DETAILS ================= -->
                        <t t-if="wizard.line_ids">
                            <div style="margin-top:30px;">
                                <h4 style="color:#34495e;">Detailed Breakdown</h4>

                                <t t-foreach="wizard.line_ids" t-as="line">

                                    <div style="margin-top:20px; border-left:4px solid #2c3e50; padding-left:10px;">
                                        <h5 style="margin:0;">
                                            <t t-esc="line.partner_id.display_name"/>
                                        </h5>
                                    </div>

                                    <table style="width:100%; border-collapse:collapse; margin-top:8px; font-size:12px;">
                                        <thead>
                                            <tr style="background-color:#f2f2f2;">
                                                <th style="padding:8px 12px; border:1px solid #000; text-align:left;">Invoice</th>
                                                <th style="padding:8px 12px; border:1px solid #000; text-align:left;">Due Date</th>
                                                <th style="padding:8px 12px; border:1px solid #000; text-align:right;">Overdue Days</th>
                                                <th style="padding:8px 12px; border:1px solid #000; text-align:right;">Total</th>
                                                <th style="padding:8px 12px; border:1px solid #000; text-align:right;">Pending</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <t t-foreach="line.detail_ids" t-as="d">
                                                <tr>
                                                    <td style="padding:8px 12px; border:1px solid #000;">
                                                        <t t-esc="d.invoice_number"/>
                                                    </td>
                                                    <td style="padding:8px 12px; border:1px solid #000;">
                                                        <t t-esc="d.due_date"/>
                                                    </td>
                                                    <td style="padding:8px 12px; border:1px solid #000; text-align:right;">
                                                        <t t-esc="d.overdue_days"/>
                                                    </td>
                                                    <td style="padding:8px 12px; border:1px solid #000; text-align:right;">
                                                        <t t-esc="'{:,.2f}'.format(d.amount_total or 0)"/>
                                                    </td>
                                                    <td style="padding:8px 12px; border:1px solid #000; text-align:right;">
                                                        <t t-esc="'{:,.2f}'.format(d.amount_residual or 0)"/>
                                                    </td>
                                                </tr>
                                            </t>
                                        </tbody>
                                    </table>

                                </t>
                            </div>
                        </t>

                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
