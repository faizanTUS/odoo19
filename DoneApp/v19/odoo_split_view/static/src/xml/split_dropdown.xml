<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="odoo_split_view.SplitDropdown">
        <div class="dropdown">
            <button class="btn btn-outline-primary" type="button" data-bs-toggle="dropdown"
                    style="padding: 5px 16px; font-size: 7px;">
                <i t-attf-class="fa {{icon}} fa-2x" style="vertical-align: middle; color:red;"/>
            </button>
            <ul class="dropdown-menu">
                <li>
                    <a class="dropdown-item" href="#" t-on-click="handleSelectVertical">
                        <i class="fa fa-columns me-2"/>
                        Vertical
                    </a>
                </li>
                <li>
                    <a class="dropdown-item" href="#" t-on-click="handleSelectHorizontal">
                        <i class="fa fa-pause fa-rotate-90 me-2"/>
                        Horizontal
                    </a>
                </li>
                <li><hr class="dropdown-divider"/></li>
                <li>
                    <a class="dropdown-item" href="#" t-on-click="handleSelectOff">
                        <i class="fa fa-square-o me-2"/>
                        Split Off
                    </a>
                </li>
            </ul>
        </div>
    </t>
</templates>


