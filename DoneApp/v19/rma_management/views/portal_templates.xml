<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="portal_my_home_rma" name="Portal My Home: RMA" inherit_id="portal.portal_my_home" priority="20">
        <xpath expr="//div[hasclass('o_portal_docs')]" position="inside">
            <t t-call="portal.portal_docs_entry">
                <t t-set="title">My Returns</t>
                <t t-set="url" t-value="'/my/returns'"/>
                <t t-set="placeholder_count" t-value="'rma_count'"/>
            </t>
        </xpath>
    </template>

    <template id="portal_my_returns" name="My Returns">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True"/>
            <t t-call="portal.portal_searchbar">
                <t t-set="title">Returns</t>
            </t>
            <t t-if="not rmas">
                <div class="alert alert-warning mt8" role="alert">
                    There are currently no return requests for your account.
                </div>
            </t>
            <t t-if="rmas" t-call="portal.portal_table">
                <thead>
                    <tr class="active">
                        <th>RMA #</th>
                        <th>Order</th>
                        <th>Date</th>
                        <th>Items</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    <t t-foreach="rmas" t-as="rma">
                        <tr>
                            <td>
                                <a t-attf-href="/my/rma/#{rma.id}">
                                    <t t-out="rma.name"/>
                                </a>
                            </td>
                            <td><t t-out="rma.sale_order_id.name"/></td>
                            <td><span t-field="rma.date" t-options='{"widget": "date"}'/></td>
                            <td><t t-out="len(rma.rma_line_ids)"/></td>
                            <td>
                                <span t-attf-class="badge rounded-pill #{
                                    'bg-info' if rma.state == 'submitted' else
                                    'bg-success' if rma.state in ('approved','closed') else
                                    'bg-danger' if rma.state == 'rejected' else
                                    'bg-secondary'}">
                                    <t t-out="dict(rma._fields['state'].selection).get(rma.state, rma.state)"/>
                                </span>
                            </td>
                        </tr>
                    </t>
                </tbody>
            </t>
        </t>
    </template>

    <template id="portal_rma_detail" name="Portal RMA Detail">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="False"/>
            <div class="container mt-4">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h3>Return <t t-out="rma.name"/></h3>
                    <span t-attf-class="badge rounded-pill #{
                        'bg-info' if rma.state == 'submitted' else
                        'bg-success' if rma.state in ('approved','closed') else
                        'bg-danger' if rma.state == 'rejected' else
                        'bg-secondary'}">
                        <t t-out="dict(rma._fields['state'].selection).get(rma.state, rma.state)"/>
                    </span>
                </div>
                <div class="row mb-4">
                    <div class="col-md-6">
                        <strong>Order:</strong>
                        <a t-attf-href="/my/orders/#{rma.sale_order_id.id}">
                            <t t-out="rma.sale_order_id.name"/>
                        </a><br/>
                        <strong>Customer:</strong> <span t-out="rma.partner_id.name"/><br/>
                        <t t-if="rma.return_address_id">
                            <strong>Return Address:</strong>
                            <span t-out="rma.return_address_id.display_name"/>
                        </t>
                    </div>
                    <div class="col-md-6 text-md-end">
                        <strong>Submitted:</strong>
                        <span t-field="rma.date" t-options='{"widget": "date"}'/><br/>
                        <strong>Total Refund:</strong>
                        <span t-field="rma.total_refund_amount"
                              t-options='{"widget": "monetary", "display_currency": rma.currency_id}'/>
                    </div>
                </div>
                <h5>Returned Products</h5>
                <table class="table table-sm table-bordered">
                    <thead>
                        <tr>
                            <th>Product</th>
                            <th class="text-end">Qty</th>
                            <th>Reason</th>
                            <th>Action</th>
                            <th>Pickup</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="rma.rma_line_ids" t-as="line">
                            <tr>
                                <td><t t-out="line.product_id.display_name"/></td>
                                <td class="text-end"><t t-out="line.quantity"/></td>
                                <td><t t-out="line.reason_id.name or ''"/></td>
                                <td>
                                    <t t-out="dict(line._fields['action'].selection).get(line.action, '') if line.action else ''"/>
                                </td>
                                <td>
                                    <span t-if="line.pickup_required" class="badge bg-info">Required</span>
                                    <span t-if="not line.pickup_required" class="badge bg-success">Not Required</span>
                                </td>
                            </tr>
                        </t>
                    </tbody>
                </table>
                <t t-if="rma.state == 'rejected' and rma.reject_reason">
                    <div class="alert alert-danger">
                        <strong>Rejection reason:</strong> <t t-out="rma.reject_reason"/>
                    </div>
                </t>
                <div class="mt-3">
                    <a href="/my/returns" class="btn btn-secondary">Back to My Returns</a>
                </div>
            </div>
        </t>
    </template>

    <template id="portal_rma_submission_form" name="Submit Return Request">
        <t t-call="portal.portal_layout">
            <div class="container mt-4 mb-5">
                <h3>Return Products — Order <t t-out="order.name"/></h3>
                <p class="text-muted">Tick the products you want to return, enter the quantity, and pick a reason. Use the
                    <em>Apply to All</em> button to set the same reason/action on every ticked line.</p>

                <form action="/my/rma/submit" method="post" class="mt-4" id="rma_submit_form">
                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                    <input type="hidden" name="order_id" t-att-value="order.id"/>

                    <div class="card mb-3">
                        <div class="card-body">
                            <div class="row g-2 align-items-end">
                                <div class="col-md-4">
                                    <label class="form-label">Return Address</label>
                                    <select name="return_address_id" class="form-select">
                                        <option t-att-value="order.partner_shipping_id.id">
                                            <t t-out="order.partner_shipping_id.display_name"/>
                                        </option>
                                        <t t-foreach="addresses" t-as="addr">
                                            <t t-if="addr.id != order.partner_shipping_id.id">
                                                <option t-att-value="addr.id">
                                                    <t t-out="addr.display_name"/>
                                                </option>
                                            </t>
                                        </t>
                                    </select>
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label">Apply Reason to All</label>
                                    <select id="bulk_reason" class="form-select">
                                        <option value="">-- Bulk reason --</option>
                                        <t t-foreach="reasons" t-as="reason">
                                            <option t-att-value="reason.id"><t t-out="reason.name"/></option>
                                        </t>
                                    </select>
                                </div>
                                <div class="col-md-2">
                                    <label class="form-label">Apply Action to All</label>
                                    <select id="bulk_action" class="form-select">
                                        <option value="">-- Bulk action --</option>
                                        <option value="return_refund">Refund</option>
                                        <option value="replacement">Replacement</option>
                                    </select>
                                </div>
                                <div class="col-md-2">
                                    <button type="button" class="btn btn-outline-primary w-100"
                                            id="apply_to_all_btn">Apply to All</button>
                                </div>
                            </div>
                        </div>
                    </div>

                    <table class="table table-bordered align-middle">
                        <thead class="table-light">
                            <tr>
                                <th style="width:40px">
                                    <input type="checkbox" id="select_all" class="form-check-input"/>
                                </th>
                                <th>Product</th>
                                <th>Delivered</th>
                                <th>Return Qty</th>
                                <th>Reason</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="order.order_line" t-as="line">
                                <t t-if="not line.display_type and line.qty_delivered &gt; 0">
                                    <tr>
                                        <td>
                                            <input type="checkbox"
                                                   t-att-name="'select_%s' % line.id"
                                                   class="form-check-input rma-line-check"/>
                                        </td>
                                        <td><t t-out="line.product_id.display_name"/></td>
                                        <td><t t-out="line.qty_delivered"/></td>
                                        <td>
                                            <input type="number" step="0.01" min="0"
                                                   t-att-max="line.qty_delivered"
                                                   t-att-name="'qty_%s' % line.id"
                                                   t-att-value="line.qty_delivered"
                                                   class="form-control rma-qty-input"/>
                                        </td>
                                        <td>
                                            <select t-att-name="'reason_%s' % line.id"
                                                    class="form-select rma-reason-select">
                                                <option value="">-- Select reason --</option>
                                                <t t-foreach="reasons" t-as="reason">
                                                    <option t-att-value="reason.id">
                                                        <t t-out="reason.name"/>
                                                    </option>
                                                </t>
                                            </select>
                                        </td>
                                        <td>
                                            <select t-att-name="'action_%s' % line.id"
                                                    class="form-select rma-action-select">
                                                <option value="return_refund">Refund</option>
                                                <option value="replacement">Replacement</option>
                                                <option value="no_action">Return Only / No Action</option>
                                            </select>
                                        </td>
                                    </tr>
                                </t>
                            </t>
                        </tbody>
                    </table>

                    <div class="mt-4 d-flex gap-2">
                        <button type="submit" class="btn btn-primary">Submit Return Request</button>
                        <a t-attf-href="/my/orders/#{order.id}" class="btn btn-secondary">Cancel</a>
                    </div>
                </form>

                <script type="text/javascript">
                    (function () {
                        var form = document.getElementById('rma_submit_form');
                        if (!form) { return; }
                        var selectAll = document.getElementById('select_all');
                        var checks = form.querySelectorAll('.rma-line-check');
                        selectAll &amp;&amp; selectAll.addEventListener('change', function () {
                            checks.forEach(function (c) { c.checked = selectAll.checked; });
                        });
                        var applyBtn = document.getElementById('apply_to_all_btn');
                        var bulkReason = document.getElementById('bulk_reason');
                        var bulkAction = document.getElementById('bulk_action');
                        applyBtn &amp;&amp; applyBtn.addEventListener('click', function () {
                            var rVal = bulkReason.value;
                            var aVal = bulkAction.value;
                            form.querySelectorAll('.rma-line-check').forEach(function (chk) {
                                if (!chk.checked) { return; }
                                var row = chk.closest('tr');
                                if (rVal) {
                                    var rSel = row.querySelector('.rma-reason-select');
                                    if (rSel) { rSel.value = rVal; }
                                }
                                if (aVal) {
                                    var aSel = row.querySelector('.rma-action-select');
                                    if (aSel) { aSel.value = aVal; }
                                }
                            });
                        });
                        form.addEventListener('submit', function (e) {
                            // Zero-out qty on unchecked rows so the server skips them
                            form.querySelectorAll('.rma-line-check').forEach(function (chk) {
                                if (chk.checked) { return; }
                                var row = chk.closest('tr');
                                var qtyInput = row.querySelector('.rma-qty-input');
                                if (qtyInput) { qtyInput.value = 0; }
                            });
                        });
                    })();
                </script>
            </div>
        </t>
    </template>

    <template id="portal_order_page_rma" inherit_id="sale.sale_order_portal_template">
        <xpath expr="//div[@id='sale_order_communication']" position="before">
            <t t-if="sale_order.state == 'sale'">
                <div class="mt-3 mb-3">
                    <a t-attf-href="/my/rma/create/#{sale_order.id}" class="btn btn-primary">
                        <i class="fa fa-undo me-1"/> Return Products
                    </a>
                </div>
            </t>
        </xpath>
    </template>
</odoo>
