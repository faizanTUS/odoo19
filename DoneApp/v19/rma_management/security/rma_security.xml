<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="group_rma_user" model="res.groups">
            <field name="name">RMA User</field>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

<!--        <record id="group_rma_manager" model="res.groups">-->
<!--            <field name="name">RMA Manager</field>-->
<!--            <field name="implied_ids" eval="[(4, ref('group_rma_user'))]"/>-->
<!--            <field name="users" eval="[(4, ref('base.user_admin'))]"/>-->
<!--        </record>-->

        <record id="group_rma_manager" model="res.groups">
            <field name="name">RMA Manager</field>
            <field name="implied_ids" eval="[(4, ref('group_rma_user'))]"/>
        </record>

        <!-- Portal users see only their own RMAs -->
        <record id="rule_customer_rma_portal_own" model="ir.rule">
            <field name="name">Customer RMA: portal users see their own</field>
            <field name="model_id" ref="model_customer_rma"/>
            <field name="domain_force">[('partner_id','=',user.partner_id.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="rule_customer_rma_line_portal_own" model="ir.rule">
            <field name="name">Customer RMA Line: portal users see their own</field>
            <field name="model_id" ref="model_customer_rma_line"/>
            <field name="domain_force">[('rma_id.partner_id','=',user.partner_id.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>
    </data>
</odoo>
