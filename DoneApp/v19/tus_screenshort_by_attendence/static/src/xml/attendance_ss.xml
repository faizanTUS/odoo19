<?xml version="1.0" encoding="utf-8"?>
<template xml:space="preserve">
  <t t-inherit="hr_attendance.attendance_menu" t-inherit-mode="extension">
      <xpath expr="//Dropdown" position="attributes">
            <attribute name="onStateChanged.bind">stateChanged</attribute>
        </xpath>

     <xpath expr="//div[hasclass('o_att_menu_container')]" position="after">
      <img src="" style="margin-top: 20px;"/>
      <canvas width="300" height="300" id="mycanvas" style="display: none;"/>
      <div id="output"/>
      <div id="screenshot" style="text-align:center;">
        <h6 id="error_handle_msg"/>
        <video class="videostream" autoplay="" style='visibility:hidden'>
        </video>
        <img id="screenshot-img" src="data:," style="display: none;"/>
      </div>
        </xpath>
  </t>
</template>
