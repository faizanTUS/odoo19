<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

  <!-- 1.  the actual button that the component renders -->
    <t t-name="pos_orderline_fix_amount_discount.FixDiscountButton">
    <button class="btn btn-light btn-lg lh-lg" t-on-click="onClick">
      <i class="fa fa-calculator"/>
        Fix Discount
    </button>
  </t>

    <!-- 2.  put it in the control-buttons bar -->
    <t t-name="pos_orderline_fix_amount_discount.ControlButtons"
       t-inherit="point_of_sale.ControlButtons"
       t-inherit-mode="extension">
    <xpath expr="//SelectPartnerButton" position="after">
      <FixDiscountButton t-if="pos.config.fix_discount"/>
    </xpath>
  </t>

</templates>