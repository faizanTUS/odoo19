<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_project_stage_template_search" model="ir.ui.view">
        <field name="name">project.stage.template.search</field>
        <field name="model">project.stage.template</field>
        <field name="arch" type="xml">
            <search string="Stage Template">
                <field name="name"/>
            </search>
        </field>
    </record>

    <record id="view_project_stage_template_list" model="ir.ui.view">
        <field name="name">project.stage.template.list</field>
        <field name="model">project.stage.template</field>
        <field name="arch" type="xml">
            <list string="Stage Template" create="1" delete="1" edit="1">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="view_project_stage_template_form" model="ir.ui.view">
        <field name="name">project.stage.template.form</field>
        <field name="model">project.stage.template</field>
        <field name="arch" type="xml">
            <form string="Stage Template">
                <sheet>
                    <group>
                        <field name="name" placeholder="e.g. Marketing Stage"/>
                        <field name="sequence"/>
                    </group>
                    <notebook>
                        <page name="stages_page" string="Project Stages">
                            <field name="stage_line_ids" nolabel="1">
                                <list create="1" delete="1" edit="1" editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="stage_id"/>
                                    <field name="is_project_stage" string="Project Stage"/>
                                    <field name="track_duration_start" string="Start"/>
                                    <field name="track_duration_stop" string="Stop"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_project_stage_template" model="ir.actions.act_window">
        <field name="name">Stage Templates</field>
        <field name="res_model">project.stage.template</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_project_stage_template_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No stage templates yet.
            </p><p>
                Create reusable stage templates and add project stages with Project Stage, Start, and Stop options.
            </p>
        </field>
    </record>
</odoo>
