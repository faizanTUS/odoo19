<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_users_warehouse_restrictions" model="ir.ui.view">
            <field name="name">res.users.warehouse.restrictions.v18</field>
            <field name="model">res.users</field>
            <field name="inherit_id" ref="base.view_users_form"/>
            <field name="arch" type="xml">

                <!-- Insert inside Access Rights tab -->
                <xpath expr="//page[@name='access_rights']" position="inside">
                    <group string="Warehouse Restrictions"
                           groups="base.group_system,tus_warehouse_stock_restrictions.group_restrict_warehouse">
                        <group>
                            <field name="default_picking_type_ids" widget="many2many_tags"/>
                            <field name="warehouse_ids" widget="many2many_tags"/>
                        </group>
                        <group>
                            <field name="limit_sale_order"/>
                        </group>
                    </group>
                </xpath>

                <!-- Locations tab -->
                <xpath expr="//page[@name='preferences']" position="after">
                    <page string="Allowed Locations"
                          groups="base.group_system,tus_warehouse_stock_restrictions.group_restrict_warehouse">
                        <group>
                            <field name="restrict_locations"/>
                            <field name="stock_location_ids"
                                   invisible="restrict_locations == False"
                            />
                        </group>
                    </page>
                </xpath>

            </field>
        </record>

    </data>
</odoo>
