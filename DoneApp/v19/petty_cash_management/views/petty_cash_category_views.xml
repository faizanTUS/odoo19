<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_petty_cash_category_tree" model="ir.ui.view">
        <field name="name">petty.cash.category.list</field>
        <field name="model">petty.cash.category</field>
        <field name="arch" type="xml">
            <list string="Expense Categories">
                <field name="code"/>
                <field name="name"/>
                <field name="expense_account_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>
    <record id="view_petty_cash_category_form" model="ir.ui.view">
        <field name="name">petty.cash.category.form</field>
        <field name="model">petty.cash.category</field>
        <field name="arch" type="xml">
            <form string="Expense Category">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="code"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                        <field name="expense_account_id"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
