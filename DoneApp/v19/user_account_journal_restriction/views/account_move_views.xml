<odoo>
    <record id="view_move_form_show_journal_field" model="ir.ui.view">
        <field name="name">account.move.form.show.journal.field</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="priority" eval="1000"/>
        <field name="arch" type="xml">

            <!-- Add allowed_journal_ids invisible so the domain on journal_id works -->
            <xpath expr="//field[@name='partner_id']" position="before">
                <field name="allowed_journal_ids" invisible="1"/>
            </xpath>

            <!-- Always show the journal label (remove dependency on show_journal) -->
            <xpath expr="//label[@for='journal_id']" position="attributes">
                <attribute name="invisible">False</attribute>
            </xpath>

            <!-- Hide the currency label when journal is always shown
                 (currency label only shows when show_journal is False, so now always hide it) -->
            <xpath expr="//label[@for='currency_id']" position="attributes">
                <attribute name="invisible">True</attribute>
            </xpath>

            <!-- Always show the journal_id field with restricted domain -->
            <xpath expr="//div[@name='journal_div']/field[@name='journal_id']" position="attributes">
                <attribute name="invisible">False</attribute>
                <attribute name="domain">[('id', 'in', allowed_journal_ids)]</attribute>
                <attribute name="options">{'no_create': True, 'no_open': True}</attribute>
                <attribute name="readonly">posted_before and name not in (False, '', '/')</attribute>
            </xpath>

            <!-- Hide the "in" divider between journal and currency when journal is always shown
                 to keep the layout clean -->
            <xpath expr="//div[@name='in_and_refresh_button_div']" position="attributes">
                <attribute name="invisible">True</attribute>
            </xpath>

            <!-- Move the currency_div outside to its own row so it renders cleanly below journal -->
            <xpath expr="//div[@name='currency_div']" position="attributes">
                <attribute name="class">w-100 mt-1</attribute>
            </xpath>

        </field>
    </record>
</odoo>