<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Custom Font File Tree View -->
        <record id="view_custom_font_file_tree" model="ir.ui.view">
            <field name="name">custom.font.file.tree</field>
            <field name="model">custom.font.file</field>
            <field name="arch" type="xml">
                <list string="Custom Font Files">
                    <field name="name"/>
                    <field name="font_family_name"/>
                    <field name="company_id"/>
                    <field name="active" widget="boolean_toggle"/>
                </list>
            </field>
        </record>

        <!-- Custom Font File Form View -->
        <record id="view_custom_font_file_form" model="ir.ui.view">
            <field name="name">custom.font.file.form</field>
            <field name="model">custom.font.file</field>
            <field name="arch" type="xml">
                <form string="Custom Font File">
                    <sheet>
                        <group>
                            <group>
                                <field name="name" placeholder="e.g., Custom-font"/>
                                <field name="company_id" options="{'no_create': True}"/>
                                <field name="active"/>
                            </group>
                            <group>
                                <field name="font_family_name" readonly="1" help="This is the CSS font-family name that will be used in reports"/>
                                <field name="font_filename" readonly="1"/>
                            </group>
                        </group>
                        <group>
                            <field name="font_file" filename="font_filename" 
                                   widget="binary" 
                                   options="{'accepted_file_extensions': '.ttf,.otf,.woff,.woff2,.eot'}"
                                   required="1"/>
                        </group>
                        <div class="alert alert-info" role="alert">
                                <p><strong>Supported formats:</strong> .ttf, .otf, .woff, .woff2, .eot</p>
                                <p><strong>Note:</strong> After uploading, the font will be available in the Font selection dropdown in Document Layout configuration.</p>
                            </div>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Custom Font File Search View -->
        <record id="view_custom_font_file_search" model="ir.ui.view">
            <field name="name">custom.font.file.search</field>
            <field name="model">custom.font.file</field>
            <field name="arch" type="xml">
                <search string="Custom Font Files">
                    <field name="name"/>
                    <field name="font_family_name"/>
                    <field name="company_id"/>
                    <filter string="Active" name="active" domain="[('active', '=', True)]"/>
                    <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
                </search>
            </field>
        </record>

        <!-- Action for Custom Font File -->
        <record id="action_custom_font_file" model="ir.actions.act_window">
            <field name="name">Custom Font Files</field>
            <field name="res_model">custom.font.file</field>
            <field name="view_mode">list,form</field>
            <field name="domain">[]</field>
            <field name="context">{'search_default_active': 1}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Upload Custom Font Files
                </p>
                <p>
                    Upload your custom font files (.ttf, .otf, etc.) to use them in PDF reports.
                    After uploading, you can select the font in Document Layout configuration.
                </p>
            </field>
        </record>

        <!-- Menu Item -->
        <menuitem id="menu_custom_font_file"
                  name="Custom Font Files"
                  parent="base.menu_administration"
                  action="action_custom_font_file"
                  sequence="100"
                  groups="base.group_system"/>
    </data>
</odoo>

