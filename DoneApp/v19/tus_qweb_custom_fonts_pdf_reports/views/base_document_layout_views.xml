<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Extend Document Layout View to add Custom Font File Upload -->
        <record id="view_base_document_layout_inherit" model="ir.ui.view">
            <field name="name">base.document.layout.inherit.custom.font</field>
            <field name="model">base.document.layout</field>
            <field name="inherit_id" ref="web.view_base_document_layout"/>
            <field name="arch" type="xml">
                <!-- Add Custom Font File field after font selection -->
                <xpath expr="//field[@name='font']" position="after">
                    <field name="custom_font_file_id" 
                           widget="many2one" 
                           options="{'no_create': True, 'no_open': True}"
                           placeholder="Select custom font file (optional)"
                           string="Custom Font File"
                           help="Select a custom uploaded font file. To upload a new font, go to Settings → Custom Font Files."/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>

