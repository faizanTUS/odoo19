<odoo>
    <record id="action_mrp_production_order_export_zip" model="ir.actions.server">
        <field name="name">Export Production Order</field>
        <field name="model_id" ref="mrp.model_mrp_production"/>
        <field name="binding_model_id" ref="mrp.model_mrp_production"/>
        <field name="state">code</field>
        <field name="group_ids" eval="[(4, ref('mrp_report_zip_secure.group_export_mrp_production_order'))]"/>
        <field name="code">
            action = {
                'name': 'Export Production Order',
                'type': 'ir.actions.act_window',
                'res_model': 'export.mrp.pdf.wizard',
                'view_mode': 'form',
                'target': 'new',
                'context': {'default_production_ids': [record.id for record in records],
                            'default_is_production':True,
            },

            }
        </field>
    </record>
  <record id="production_order_list_action" model="ir.ui.view">
        <field name="name">mrp.production.list.view</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_tree_view"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="%(action_mrp_production_order_export_zip)d" type="action" groups="mrp_report_zip_secure.group_export_mrp_production_order" string="Export Production Orders" />
            </xpath>
        </field>
    </record>
</odoo>