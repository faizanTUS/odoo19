<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_approval_refused_reason_form" model="ir.ui.view">
        <field name="name">approval.refused.reason.form</field>
        <field name="model">approval.refused.reason</field>
        <field name="arch" type="xml">
            <form string="Refuse Reason">
                <group>
                    <field name="reason" placeholder="Enter the reason for refusal..."/>
                </group>
                <footer>
                    <button string="Refuse" name="action_apply" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_approval_refused_reason" model="ir.actions.act_window">
        <field name="name">Refuse Reason</field>
        <field name="res_model">approval.refused.reason</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>

