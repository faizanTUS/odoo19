<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_approval_cancel_wizard_form" model="ir.ui.view">
        <field name="name">approval.cancel.wizard.form</field>
        <field name="model">approval.cancel.wizard</field>
        <field name="arch" type="xml">
            <form string="Cancel Approval">
                <group>
                    <field name="reason" placeholder="Enter the reason for cancellation (optional)..."/>
                </group>
                <footer>
                    <button string="Cancel" name="action_cancel" type="object" class="btn-primary"/>
                    <button string="Close" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_approval_cancel_wizard" model="ir.actions.act_window">
        <field name="name">Cancel Approval</field>
        <field name="res_model">approval.cancel.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>

