<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ir_sequence_form_date_offset" model="ir.ui.view">
        <field name="name">ir.sequence.form.date.offset.legend</field>
        <field name="model">ir.sequence</field>
        <field name="inherit_id" ref="base.sequence_view"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='sequence']/field[@name='date_range_ids']/following-sibling::group[1]" position="after">
                <group col="4" string="Legend (date offsets)">
                    <group>
                        <span colspan="2">Year Offset: %%(year+1)s, %%(year-1)s</span>
                        <span colspan="2">Short Year Offset: %%(y+1)s, %%(y-1)s</span>
                        <span colspan="2">Month Offset: %%(month+1)s, %%(month-1)s</span>
                        <span colspan="2">Day Offset: %%(day+1)s, %%(day-1)s</span>
                    </group>
                </group>
                <group>
                    <div colspan="2">
                        Offset placeholders support signed integers and work in prefix and suffix.
                        Examples: %%(y)s-%%(y+1)s, INV/%%(year+1)s/%%(month+1)s/%%(day+1)s.
                    </div>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
