<?xml version="1.0" encoding="UTF-8"?>

<templates id="template" xml:space="preserve">

	<t t-name="tus_pos_partial_giftcard.PromoCodePopups" owl="1">
		<div class="popup popup-textinput">
                <div class="modal-header">
                    <h4 class="modal-title"><t t-esc="props.title" /></h4>
                </div>
                <div class="modal-body">
                    <p class="sub-line-title">Hello, <t t-esc=" props.partner_id || '' " /></p>
					<p class="sub-line-title">Your Coupon Code: <t t-esc=" props.code" /></p>
					<p class="sub-line-title">Your Coupon Amount : <t t-esc=" props.points" /></p>
                    <input class="form-control form-control-lg w-75 mx-auto" type="text" t-model="state.inputValue" t-ref="RedemptionInputRef" t-att-placeholder="props.placeholder"/>
                </div>
                <div class="footer footer-flex modal-footer">
                    <div class="button confirm highlight btn btn-lg btn-primary" t-on-click="_onClickLoad">
                        <t t-esc="props.confirmText" />
                    </div>
                    <div class="button cancel btn btn-lg btn-secondary" t-on-click="_onClickCancel">
                        <t t-esc="props.cancelText" />
                    </div>
                </div>
            </div>
	</t>

</templates>