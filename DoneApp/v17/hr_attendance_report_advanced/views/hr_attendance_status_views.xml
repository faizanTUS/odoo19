<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Attendance Status Tree View -->
    <record id="view_hr_attendance_status_tree" model="ir.ui.view">
        <field name="name">hr.attendance.status.tree</field>
        <field name="model">hr.attendance.status</field>
        <field name="arch" type="xml">
            <tree string="Attendance Statuses" decoration-success="is_working" decoration-danger="is_absent" decoration-info="is_leave" decoration-muted="is_weekoff">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="color" widget="color"/>
                <field name="is_working"/>
                <field name="is_absent"/>
                <field name="is_leave"/>
                <field name="is_weekoff"/>
                <field name="active"/>
            </tree>
        </field>
    </record>

    <!-- Attendance Status Form View -->
    <record id="view_hr_attendance_status_form" model="ir.ui.view">
        <field name="name">hr.attendance.status.form</field>
        <field name="model">hr.attendance.status</field>
        <field name="arch" type="xml">
            <form string="Attendance Status">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="sequence"/>
                            <field name="color" widget="color"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="is_working"/>
                            <field name="is_absent"/>
                            <field name="is_leave"/>
                            <field name="is_weekoff"/>
                        </group>
                    </group>

                    <group string="Description">
                        <field name="description" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action for Attendance Status -->
    <record id="action_hr_attendance_status" model="ir.actions.act_window">
        <field name="name">Attendance Statuses</field>
        <field name="res_model">hr.attendance.status</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'default_active': True}</field>
    </record>
</odoo>