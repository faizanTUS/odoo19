<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Attendance List View -->
    <record id="view_hr_attendance_tree" model="ir.ui.view">
        <field name="name">hr.attendance.list</field>
        <field name="model">hr.attendance</field>
        <field name="arch" type="xml">
            <tree string="Attendance Records">
                <field name="employee_id"/>
                <field name="check_in"/>
                <field name="check_out"/>
                <field name="worked_hours"/>
                <field name="attendance_status_id"/>
                <field name="overtime_hours"/>
            </tree>
        </field>
    </record>
    
    <!-- Custom Action for Attendance (without gantt) -->
    <record id="action_hr_attendance_tree" model="ir.actions.act_window">
        <field name="name">Attendance Records</field>
        <field name="res_model">hr.attendance</field>
        <field name="view_mode">tree,form</field>
        <field name="view_id" ref="view_hr_attendance_tree"/>
    </record>
</odoo>
