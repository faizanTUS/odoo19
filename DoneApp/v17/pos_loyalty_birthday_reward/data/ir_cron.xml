<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
          <!-- Scheduled Action for Birthday Rewards -->
    <record id="ir_cron_generate_birthday_rewards" model="ir.cron">
        <field name="name">Generate Birthday Rewards</field>
        <field name="model_id" ref="model_loyalty_generate_wizard"/>
        <field name="state">code</field>
        <field name="code">model._cron_generate_birthday_rewards()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="numbercall">-1</field>
        <field name="doall" eval="False"/>
        <field name="active" eval="True"/>
    </record>

    </data>
</odoo>