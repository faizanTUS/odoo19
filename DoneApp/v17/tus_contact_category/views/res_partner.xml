<odoo>
     <record id="view_res_partner_form_inherit" model="ir.ui.view">
        <field name="name">view.res.partner.form.inherit</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">

            <field name="category_id" position="after">
                <field name="contact_categ_id" options="{'no_create': True, 'no_create_edit': True}"/>
            </field>
        </field>
     </record>

    <record id="view_res_partner_filter_contact_categ_id" model="ir.ui.view">
        <field name="name">res.partner.select.inhert</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_res_partner_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='group_by']" position="inside">
                <filter name="contact_categ_id" string="Contact Category" context="{'group_by': 'contact_categ_id'}"/>
            </xpath>

        </field>
    </record>
</odoo>
