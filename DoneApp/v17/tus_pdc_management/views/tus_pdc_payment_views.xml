<odoo>
    <data>

        <record id="view_tus_pdc_payment_form" model="ir.ui.view">
            <field name="name">tus.pdc.payment.form</field>
            <field name="model">tus.pdc.payment</field>
            <field name="arch" type="xml">
                <form string="PDC Payment">
                    <header>
                        <button name="action_register" string="Register" type="object"
                                class="btn-primary" invisible="state != 'draft'"/>

                        <button name="action_collect" string="Collect" type="object"
                                class="btn-primary" invisible="state != 'registered'"/>

<!--                        <button name="action_collect" string="Re-Collect" type="object"-->
<!--                                                        class="btn-primary" invisible="state != 'bounce'"/>-->

                        <button name="action_bounce" string="Bounce" type="object"
                                class="btn-secondary" invisible="state not in ['registered','done']"/>

                        <button name="action_cancel" string="Cancel" type="object"
                                class="btn-secondary" invisible="state in ['done']"/>

                        <button name="action_reset_to_draft" string="Reset to Draft" type="object"
                                class="btn-secondary" invisible="state not in ['cancel','bounce']"/>

                        <field name="state" widget="statusbar"
                               statusbar_visible="draft,registered,done,bounce,cancel"/>
                    </header>

                    <sheet>
                        <group>
                            <group>
                                <field name="name" readonly="1"/>
                                <field name="pdc_type" required="1"/>
                                <field name="partner_id" required="1"/>
                                <field name="company_id" groups="base.group_multi_company"/>
                            </group>
                            <group>
                                <field name="date"/>
                                <field name="cheque_date"/>
                                <field name="cheque_number"/>
                                <field name="bank_name"/>
                                <field name="currency_id" readonly="1"/>
                                <field name="amount"/>
                            </group>
                        </group>

                        <notebook>
                            <page string="Invoices">
                                <field name="invoice_ids" widget="many2many_tags"/>
                            </page>

                            <page string="Journal Entries">
                                <group>
                                    <field name="move_pdc_id" readonly="1"/>
                                    <field name="move_collection_id" readonly="1"/>
                                    <field name="move_bounce_id" readonly="1"/>
                                </group>
                            </page>

                            <page string="Internal Notes">
                                <field name="note"/>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="view_tus_pdc_payment_tree" model="ir.ui.view">
            <field name="name">tus.pdc.payment.tree</field>
            <field name="model">tus.pdc.payment</field>
            <field name="arch" type="xml">
                <tree string="PDC Payments" decoration-danger="state=='bounce'"
                      decoration-muted="state in ('cancel',)">
                    <field name="name"/>
                    <field name="pdc_type"/>
                    <field name="partner_id"/>
                    <field name="date"/>
                    <field name="cheque_date"/>
                    <field name="amount"/>
                    <field name="days_overdue"/>
                    <field name="state"/>
                </tree>
            </field>
        </record>

        <record id="view_tus_pdc_payment_search" model="ir.ui.view">
            <field name="name">tus.pdc.payment.search</field>
            <field name="model">tus.pdc.payment</field>
            <field name="arch" type="xml">
                <search string="Search PDC Payments">
                    <field name="name"/>
                    <field name="partner_id"/>
                    <field name="pdc_type"/>
                    <field name="state"/>
                    <filter name="customer" string="Customer PDC" domain="[('pdc_type','=','customer')]"/>
                    <filter name="vendor" string="Vendor PDC" domain="[('pdc_type','=','vendor')]"/>
                    <filter name="registered" string="Registered" domain="[('state','=','registered')]"/>
                    <filter name="done" string="Collected" domain="[('state','=','done')]"/>
                    <filter name="bounce" string="Bounced" domain="[('state','=','bounce')]"/>
                    <filter name="overdue" string="Overdue" domain="[('state','=','registered'),('days_overdue','&gt;',0)]"/>
                </search>
            </field>
        </record>

        <record id="action_tus_pdc_payment" model="ir.actions.act_window">
            <field name="name">PDC Payments</field>
            <field name="res_model">tus.pdc.payment</field>
            <field name="view_mode">tree,form</field>
        </record>

        <menuitem id="menu_tus_finance_pdc_root"
                  name="Post Dated Cheques"
                  parent="account.menu_finance"
                  sequence="50"
                  groups="tus_pdc_management.group_tus_pdc_manager"/>

        <menuitem id="menu_tus_pdc_payment"
                  name="PDC Payments"
                  parent="menu_tus_finance_pdc_root"
                  action="action_tus_pdc_payment"
                  sequence="40"
                  groups="tus_pdc_management.group_tus_pdc_manager"/>

    </data>
</odoo>
