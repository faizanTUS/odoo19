<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_advance_pending_payment_report_wizard_form" model="ir.ui.view">
        <field name="name">advance.pending.payment.report.wizard.form</field>
        <field name="model">advance.pending.payment.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Advance Pending Payment Report">
                <group>
                    <group>
                        <field name="partner_id" placeholder="All Partners"/>
                        <field name="date_from"/>
                        <field name="date_to"/>
                    </group>
                    <group>
                        <field name="user_id" placeholder="All Salespersons"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                        <field name="invoice_type" widget="radio"/>
                    </group>
                </group>
                <footer>
                    <button name="action_view_report" string="View Report" type="object" class="btn-secondary"/>
                    <button name="action_print_report" string="Print Report" type="object" class="btn-primary"/>
                    <button name="action_print_excel" string="Print Excel" type="object" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="view_advance_pending_payment_report_line_tree" model="ir.ui.view">
        <field name="name">advance.pending.payment.report.line.tree</field>
        <field name="model">advance.pending.payment.report.line</field>
        <field name="arch" type="xml">
            <tree string="Advance Pending Payment Report" create="false" edit="false" delete="false">
                <field name="partner_id"/>
                <field name="total" sum="Total"/>
                <field name="paid_amount" sum="Paid Amount"/>
                <field name="pending_amount" sum="Pending Amount"/>
                <field name="invoice_count" sum="Invoice Count"/>
                <field name="email"/>
                <field name="email_id"/>
            </tree>
        </field>
    </record>

    <record id="action_advance_pending_payment_report_wizard" model="ir.actions.act_window">
        <field name="name">Advance Pending Payment Report</field>
        <field name="res_model">advance.pending.payment.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
