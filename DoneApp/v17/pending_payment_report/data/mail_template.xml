<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="mail_template_pending_payment_details" model="mail.template">
        <field name="name">Pending Payment Details</field>
        <field name="model_id" ref="model_pending_payment_report_line"/>
        <field name="subject">Pending Payment Details - {{ object.partner_id.name or 'Customer' }}</field>
        <field name="email_from">{{ (object.report_id and object.report_id.create_uid.email_formatted) or user.email_formatted }}</field>
        <field name="body_html" type="html">
            <div style="margin: 0px; padding: 0px; font-size: 13px;">
                <p>Dear <t t-out="object.partner_id.name or 'Customer'"/>.</p>
                <p>Please find below a summary of your pending payments with <t t-out="object.report_id.company_id.name or 'us'"/>.</p>
                <table border="1" style="border-collapse: collapse; width: 100%; margin-top: 10px;">
                    <thead>
                        <tr style="background-color: #f2f2f2;">
                            <th style="padding: 8px;">Invoice Number</th>
                            <th style="padding: 8px;">Due Date</th>
                            <th style="padding: 8px; text-align: right;">Overdue Days</th>
                            <th style="padding: 8px; text-align: right;">Total</th>
                            <th style="padding: 8px; text-align: right;">Pending Amount</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="object.detail_ids" t-as="d">
                            <tr>
                                <td style="padding: 8px;"><t t-out="d.invoice_number"/></td>
                                <td style="padding: 8px;"><t t-out="d.due_date"/></td>
                                <td style="padding: 8px; text-align: right;"><t t-out="d.overdue_days"/></td>
                                <td style="padding: 8px; text-align: right;"><t t-out="'%.2f' % (d.amount_total or 0)"/></td>
                                <td style="padding: 8px; text-align: right;"><t t-out="'%.2f' % (d.amount_residual or 0)"/></td>
                            </tr>
                        </t>
                    </tbody>
                </table>
                <p style="margin-top: 12px;"><strong>Total Pending Amount:</strong> <t t-out="'%.2f' % (object.pending_amount or 0)"/></p>
                <p>Thank you.</p>
            </div>
        </field>
    </record>

    <!-- Template used when sending report to configured user (auto-send). -->
    <record id="mail_template_pending_payment_report_to_user" model="mail.template">
        <field name="name">Pending Payment Report (To Configured User)</field>
        <field name="model_id" ref="model_pending_payment_report_wizard"/>
        <field name="subject">Pending Payment Report - {{ object.due_date_from }} to {{ object.due_date_to }}</field>
        <field name="body_html" type="html">
            <div style="margin: 0px; padding: 0px; font-size: 13px;">
                <p>Hello,</p>
                <p>Please find attached the Pending Payment Report for the period from <strong t-out="object.due_date_from"/> to <strong t-out="object.due_date_to"/>.</p>
                <p>The report includes outstanding invoices/bills grouped by customer/vendor, with received amount and payment dates, currency wise totals and grand total.</p>
                <p>Thank you.</p>
            </div>
        </field>
    </record>
</odoo>
