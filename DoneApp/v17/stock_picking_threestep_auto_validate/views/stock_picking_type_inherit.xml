<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_picking_type_form_pick_pack_auto_inherit" model="ir.ui.view">
        <field name="name">pick.pack.auto.stock.picking.type.inherit</field>
        <field name="model">stock.picking.type</field>
        <field name="inherit_id" ref="stock.view_picking_type_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='sequence_code']" position="after">
                <field name="delivery_auto_validate" invisible="show_my_boolean_visible != True"/>
                <field name="pack_auto_validate" invisible="show_my_boolean_visible != True"/>
            </xpath>
        </field>
    </record>
</odoo>
