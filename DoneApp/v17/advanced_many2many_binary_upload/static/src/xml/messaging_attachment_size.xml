<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-inherit="Many2ManyBinaryField.attachment_preview"
       t-inherit-mode="extension">

        <xpath expr="//div[hasclass('caption') and hasclass('small')]/a[last()]"
               position="after">
            <t t-if="file.file_size or file.size">
                <span class="text-muted ms-2 o_attachment_size">
                    <t t-esc="((file.file_size or file.size) / 1048576).toFixed(2)"/> MB
                </span>
            </t>
        </xpath>

    </t>

</templates>
