<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_form_view_inherit_rma" model="ir.ui.view">
        <field name="name">product.template.form.rma</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='inventory']" position="inside">
                <group name="rma" string="RMA Configuration">
                    <field name="rma_product_type_id"/>
                    <field name="rma_threshold"/>
                    <field name="rma_reason_id"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
