<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="tus_petty_cash_management.PettyCashDashboard">
        <div class="o_petty_cash_dashboard container-fluid py-4 bg-100 min-vh-100">
            <!-- Header Section -->
            <div class="row mb-4">
                <div class="col-12 d-flex align-items-center justify-content-between">
                    <div>
                        <h1 class="h2 fw-bold text-900 mb-1">Petty Cash Overview</h1>
                        <p class="text-muted mb-0">Real-time tracking of funds and expenditures</p>
                    </div>
                    <div class="d-flex gap-2">
                        <button class="btn btn-primary rounded-pill px-4 shadow-sm" t-on-click.stop="openVouchers">
                            <i class="fa fa-plus me-2"/>New Voucher
                        </button>
                    </div>
                </div>
            </div>

            <t t-if="state.loading">
                <div class="d-flex justify-content-center align-items-center py-5">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                </div>
            </t>
            <t t-else="">
                <!-- Primary KPIs Row -->
                <div class="row g-4 mb-4">
                    <div class="col-12 col-sm-6 col-xl-3">
                        <div class="card o_pc_kpi border-0 shadow-sm overflow-hidden h-100 cursor-pointer" t-on-click.stop="openFunds">
                            <div class="card-body p-4">
                                <div class="d-flex align-items-start justify-content-between mb-3">
                                    <div class="bg-primary-light rounded-3 p-3">
                                        <i class="fa fa-university text-primary fs-4"/>
                                    </div>
                                </div>
                                <h6 class="text-uppercase text-muted fw-semibold small ls-widest mb-1">Total Cash (GL)</h6>
                                <h3 class="fw-bold mb-0" t-esc="formatMoney(state.data.total_cash)"/>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-sm-6 col-xl-3">
                        <div class="card o_pc_kpi border-0 shadow-sm overflow-hidden h-100 cursor-pointer" t-on-click.stop="openFunds">
                            <div class="card-body p-4">
                                <div class="d-flex align-items-start justify-content-between mb-3">
                                    <div class="bg-success-light rounded-3 p-3">
                                        <i class="fa fa-money text-success fs-4"/>
                                    </div>
                                </div>
                                <h6 class="text-uppercase text-muted fw-semibold small ls-widest mb-1">Available Balance</h6>
                                <h3 class="fw-bold mb-0 text-success" t-esc="formatMoney(state.data.available_balance)"/>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-sm-6 col-xl-3">
                        <div class="card o_pc_kpi border-0 shadow-sm overflow-hidden h-100 cursor-pointer" t-on-click.stop="openPaidVouchers">
                            <div class="card-body p-4">
                                <div class="d-flex align-items-start justify-content-between mb-3">
                                    <div class="bg-info-light rounded-3 p-3">
                                        <i class="fa fa-line-chart text-info fs-4"/>
                                    </div>
                                </div>
                                <h6 class="text-uppercase text-muted fw-semibold small ls-widest mb-1">Monthly Spent</h6>
                                <h3 class="fw-bold mb-0" t-esc="formatMoney(state.data.monthly_spent)"/>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-sm-6 col-xl-3">
                        <div class="card o_pc_kpi border-0 shadow-sm overflow-hidden h-100 cursor-pointer" t-on-click.stop="openDraftVouchers">
                            <div class="card-body p-4">
                                <div class="d-flex align-items-start justify-content-between mb-3">
                                    <div class="bg-warning-light rounded-3 p-3">
                                        <i class="fa fa-file-text-o text-warning fs-4"/>
                                    </div>
                                    <span t-if="state.data.draft_vouchers > 0" class="badge rounded-pill bg-warning text-dark px-3 py-2">Pending</span>
                                </div>
                                <h6 class="text-uppercase text-muted fw-semibold small ls-widest mb-1">Draft Vouchers</h6>
                                <h3 class="fw-bold mb-0" t-esc="state.data.draft_vouchers"/>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Operations Row -->
                <div class="row g-4">
                    <div class="col-12 col-lg-8">
                        <div class="card border-0 shadow-sm h-100">
                            <div class="card-header bg-white py-3 border-bottom-0">
                                <h5 class="fw-bold mb-0">Operational Status</h5>
                            </div>
                            <div class="card-body">
                                <div class="row g-4">
                                    <div class="col-12 col-md-3">
                                        <div class="p-3 border rounded-3 text-center h-100 cursor-pointer hover-bg-light transition-base" t-on-click.stop="openReplenishments">
                                            <div class="text-muted small mb-1">Active Replenishments</div>
                                            <div class="h4 fw-bold mb-0" t-esc="state.data.replenishments_pending"/>
                                        </div>
                                    </div>
                                    <div class="col-12 col-md-3">
                                        <div class="p-3 border rounded-3 text-center h-100 cursor-pointer hover-bg-light transition-base" t-on-click.stop="openUnreconciled">
                                            <div class="text-muted small mb-1">Unreconciled Payments</div>
                                            <div class="h4 fw-bold mb-0" t-esc="state.data.unreconciled"/>
                                        </div>
                                    </div>
                                    <div class="col-12 col-md-3">
                                        <div class="p-3 border rounded-3 text-center h-100 cursor-pointer hover-bg-light transition-base" t-on-click.stop="openCancelledVouchers">
                                            <div class="text-muted small mb-1">Cancelled Vouchers</div>
                                            <div class="h4 fw-bold mb-0" t-esc="state.data.cancelled_vouchers"/>
                                        </div>
                                    </div>
                                    <div class="col-12 col-md-3">
                                        <div class="p-3 border rounded-3 text-center h-100">
                                            <div class="text-muted small mb-1">Variance (Abs)</div>
                                            <div class="h4 fw-bold mb-0 text-danger" t-esc="formatMoney(state.data.variance_total)"/>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <div class="col-12 col-lg-4">
                        <div class="card border-0 shadow-sm h-100">
                            <div class="card-header bg-white py-3 border-bottom-0">
                                <h5 class="fw-bold mb-0 text-danger">Alerts &amp; Actions</h5>
                            </div>
                            <div class="card-body">
                                <div class="list-group list-group-flush">
                                    <div class="list-group-item list-group-item-action border-0 px-0 d-flex align-items-center justify-content-between cursor-pointer" t-on-click.stop="openCriticalFunds">
                                        <div class="d-flex align-items-center">
                                            <div class="rounded-circle bg-danger-light p-2 me-3">
                                                <i class="fa fa-exclamation-triangle text-danger"/>
                                            </div>
                                            <div>
                                                <div class="fw-semibold">Critical Funds</div>
                                                <div class="small text-muted">Low balance alerts</div>
                                            </div>
                                        </div>
                                        <span class="badge rounded-pill bg-danger" t-esc="state.data.critical_funds"/>
                                    </div>
                                    <div class="list-group-item list-group-item-action border-0 px-0 d-flex align-items-center justify-content-between cursor-pointer" t-on-click.stop="openMissingReceipts">
                                        <div class="d-flex align-items-center">
                                            <div class="rounded-circle bg-warning-light p-2 me-3">
                                                <i class="fa fa-paperclip text-warning"/>
                                            </div>
                                            <div>
                                                <div class="fw-semibold">Missing Receipts</div>
                                                <div class="small text-muted">Audit compliance</div>
                                            </div>
                                        </div>
                                        <span class="badge rounded-pill bg-warning text-dark" t-esc="state.data.missing_receipts"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </t>
        </div>
    </t>
</templates>
