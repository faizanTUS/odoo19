<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_petty_cash_policy_tree" model="ir.ui.view">
        <field name="name">petty.cash.policy.list</field>
        <field name="model">petty.cash.policy</field>
        <field name="arch" type="xml">
            <tree string="Spend Policies">
                <field name="name"/>
                <field name="max_amount_per_voucher"/>
                <field name="daily_limit_per_employee"/>
                <field name="monthly_limit_per_employee"/>
                <field name="require_receipt"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </tree>
        </field>
    </record>
    <record id="view_petty_cash_policy_form" model="ir.ui.view">
        <field name="name">petty.cash.policy.form</field>
        <field name="model">petty.cash.policy</field>
        <field name="arch" type="xml">
            <form string="Spend Policy">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                        <field name="currency_id"/>
                    </group>
                    <group string="Limits">
                        <field name="max_amount_per_voucher"/>
                        <field name="daily_limit_per_employee"/>
                        <field name="monthly_limit_per_employee"/>
                        <field name="require_receipt"/>
                    </group>
                    <group string="Allowed categories">
                        <field name="category_ids" widget="many2many_tags" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
