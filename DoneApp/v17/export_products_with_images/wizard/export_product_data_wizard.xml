<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_export_product_data_wizard" model="ir.ui.view">
        <field name="name">export.product.data.wizard.form</field>
        <field name="model">export.product.data.wizard</field>
        <field name="arch" type="xml">
            <form string="Export Products">
                <sheet>
                    <group>
                        <button name="export_products_image" type="object" string="Export Product Img" class="btn-primary"/>
                        <button name="export_products_data" type="object" string="Export Product Data" class="btn-primary"/>
                    </group>
                </sheet>
                <footer>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
