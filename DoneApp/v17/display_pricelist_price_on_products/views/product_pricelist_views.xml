<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_pricelist_form_view_display_on_product" model="ir.ui.view">
        <field name="name">product.pricelist.form.display.on.product</field>
        <field name="model">product.pricelist</field>
        <field name="inherit_id" ref="product.product_pricelist_view"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='pricelist_settings']" position="inside">
                <field name="display_on_product_form"/>
            </xpath>
        </field>
    </record>
</odoo>
