<odoo>
    <record id="view_accounting_pdf_export_wizard_form" model="ir.ui.view">
        <field name="name">accounting.pdf.export.wizard.form</field>
        <field name="model">export.accounting.pdf.wizard</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <field name="move_type" invisible="1"/>
                    <field name="is_production" invisible="1"/>
                    <field name="is_sale" invisible="1"/>
                    <field name="is_quotation" invisible="1"/>
                    <field name="is_work_order" invisible="1"/>
                    <field name="is_purchase" invisible="1"/>
                    <field name="is_purchase_rfq" invisible="1"/>
                    <field name="is_delivery" invisible="1"/>
                    <field name="payment_type" invisible="1"/>
                    <div invisible="move_type != 'out_invoice' or is_production != True or is_sale != True">
                        <h1>Export Invoices</h1>
                    </div>
                    <div invisible="move_type != 'in_invoice'">
                        <h1>Export Vendor bill</h1>
                    </div>
                    <div invisible="move_type != 'out_refund'">
                        <h1>Export Customer Credit Notes</h1>
                    </div>
                    <div invisible="move_type != 'in_refund'">
                        <h1>Export Vendor Credit Notes</h1>
                    </div>
                    <div invisible="move_type != 'move_type'">
                        <h1>Export Payment</h1>
                    </div>
                    <div>
                        <group>
                            <group>
                            <field name="zip_password" password="True" string="Zip Password"/>
                            </group>
                        </group>
                    </div>
                    <field name="invoice_ids" nolabel="1"
                           invisible="move_type == 'entry' or move_type != 'out_invoice' or is_production == True or is_work_order == True or is_sale == True or is_quotation == True or is_purchase == True or is_purchase_rfq == True or is_delivery == True">
                        <tree>
                            <field name="name"/>
                            <field name="partner_id"/>
                            <field name="invoice_date"/>
                            <field name="invoice_date_due"/>
                            <field name="amount_untaxed_signed"/>
                            <field name="amount_tax"/>
                            <field name="amount_total_signed"/>
                            <field name="amount_total_in_currency_signed"/>
                            <field name="payment_state"/>
                            <field name="state"/>
                        </tree>
                    </field>

                    <field name="invoice_ids" nolabel="1"
                           invisible="move_type == 'entry' or move_type != 'in_invoice' or is_production == True or is_work_order == True">
                        <tree>
                            <field name="name"/>
                            <field name="partner_id"/>
                            <field name="invoice_date"/>
                            <field name="invoice_date_due"/>
                            <field name="amount_untaxed_signed"/>
                            <field name="amount_tax"/>
                            <field name="amount_total_signed"/>
                            <field name="amount_total_in_currency_signed"/>
                            <field name="payment_state"/>
                            <field name="state"/>
                        </tree>
                    </field>

                    <field name="invoice_ids" nolabel="1"
                           invisible="move_type == 'entry' or move_type != 'out_refund' or is_production == True or is_work_order == True">
                        <tree>
                            <field name="name"/>
                            <field name="invoice_partner_display_name"/>
                            <field name="invoice_date"/>
                            <field name="invoice_date_due"/>
                            <field name="amount_untaxed_signed"/>
                            <field name="amount_tax"/>
                            <field name="amount_total_signed"/>
                            <field name="amount_total_in_currency_signed"/>
                            <field name="payment_state"/>
                            <field name="state"/>
                        </tree>
                    </field>
                    <field name="invoice_ids" nolabel="1"
                           invisible="move_type == 'entry' or move_type != 'in_refund' or is_production == True or is_work_order == True">
                        <tree>
                            <field name="name"/>
                            <field name="invoice_partner_display_name"/>
                            <field name="invoice_date"/>
                            <field name="invoice_date_due"/>
                            <field name="amount_untaxed_signed"/>
                            <field name="amount_tax"/>
                            <field name="amount_total_signed"/>
                            <field name="amount_total_in_currency_signed"/>
                            <field name="payment_state"/>
                            <field name="state"/>
                        </tree>
                    </field>
                    <field name="payment_ids" nolabel="1" invisible="move_type != 'entry'">
                        <tree>
                            <field name="date"/>
                            <field name="name"/>
                            <field name="journal_id"/>
                            <field name="payment_method_line_id"/>
                            <field name="partner_id"/>
                            <field name="amount_signed"/>
                            <field name="amount_company_currency_signed"/>
                        </tree>
                    </field>
                </sheet>
                <footer>
                    <button string="Export Customer Invoice Zip" type="object"
                            invisible="move_type != 'out_invoice' or is_production == True or is_sale == True or is_quotation == True or is_delivery == True or is_purchase == True or is_purchase_rfq == True or is_work_order == True"
                            name="action_export"
                            class="oe_highlight"/>
                    <button string="Export Vendor Bill Zip" type="object" invisible="move_type != 'in_invoice'"
                            name="action_export_bill" class="oe_highlight"/>
                    <button string="Export Customer Credit Note Zip" type="object" invisible="move_type != 'out_refund'"
                            name="action_customer_credit_notes" class="oe_highlight"/>
                    <button string="Export Vendor Credit Note Zip" type="object" invisible="move_type != 'in_refund'"
                            name="action_vendor_credit_notes" class="oe_highlight"/>
                    <button string="Export Payment Zip" type="object" invisible="move_type != 'entry'"
                            name="action_customer_payment" class="oe_highlight"/>
                    <button string="Cancel" class="oe_link" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
