<?xml version="1.0" encoding="utf-8"?>
<templates id="template" xml:space="preserve">
     <t t-name="PaymentScreen" t-inherit="point_of_sale.PaymentScreenButtons" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('payment-buttons')]" position="inside">
            <t t-if="pos.config.cash_rounding">
                <t t-debug=""/>
                <div class="cash-visible" t-if="cash_rounding_list.length > 1">
                    <t t-foreach="cash_rounding_list" t-as="cash_rounding" t-key="cash_rounding.id">
                        <div>
                        <button t-if="pos.config.cash_rounding" style="width: 100% !important;"
                                class="button cash_rounding_all btn btn-light py-3 text-start rounded-0 border-bottom cash_rounding_half_up cash_rounding_al"
                                t-att-data-rounding_id='cash_rounding.id' t-on-click="on_click_cash_rounding">
                                            <span t-esc="cash_rounding_val()"/></button>
                        </div>
                    </t>
                </div>

            </t>
