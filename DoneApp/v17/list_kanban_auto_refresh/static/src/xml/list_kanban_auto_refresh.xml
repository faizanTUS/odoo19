<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-inherit="web.ListView" t-inherit-mode="extension">
        <xpath expr="//t[@t-set-slot='control-panel-additional-actions']/CogMenu[1]" position="before">
            <button
                type="button"
                class="o_list_kanban_auto_refresh_btn"
                t-att-class="listKanbanAutoRefreshClass"
                t-att-title="listKanbanAutoRefreshTitle"
                t-att-disabled="listKanbanAutoRefreshDisabled"
                t-on-click="toggleListKanbanAutoRefresh"
            >
                <i class="oi oi-arrow-repeat" role="img" aria-hidden="true"/>
                <span class="d-none d-md-inline ms-1">Auto Refresh</span>
            </button>
        </xpath>
    </t>

    <t t-inherit="web.KanbanView" t-inherit-mode="extension">
        <xpath expr="//t[@t-set-slot='control-panel-additional-actions']/CogMenu[1]" position="before">
            <button
                type="button"
                class="o_list_kanban_auto_refresh_btn"
                t-att-class="listKanbanAutoRefreshClass"
                t-att-title="listKanbanAutoRefreshTitle"
                t-att-disabled="listKanbanAutoRefreshDisabled"
                t-on-click="toggleListKanbanAutoRefresh"
            >
                <i class="oi oi-arrow-repeat" role="img" aria-hidden="true"/>
                <span class="d-none d-md-inline ms-1">Auto Refresh</span>
            </button>
        </xpath>
    </t>

</templates>
