<odoo>
    <record id="view_purchase_order_form_inherit_reversal" model="ir.ui.view">
        <field name="name">purchase.order.form.tus.reversal</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_open_cancel_reset_wizard" type="object"
                        string="Cancel/Reverse/Reset" class="oe_highlight"
                        groups="tus_po_reversal_advanced.group_reversal_user"/>
            </xpath>
        </field>
    </record>
</odoo>
