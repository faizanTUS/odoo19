<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>

        <record id="sale_order_form_currency_rate" model="ir.ui.view">
            <field name="name">sale.order.form.currency.rate</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_order_form" />
            <field name="arch" type="xml">

                <!-- Currency Rate Field -->
                <xpath expr="//field[@name='pricelist_id']" position="before">
                    <field name="allow_custom_currency_rate" invisible="1"/>
                    <field name="is_new_currency_rate_visible" invisible="1"/>
                    <field
                        name="new_currency_rate"
                        invisible="allow_custom_currency_rate != True or is_new_currency_rate_visible != True"
                        attrs="{'readonly': [('state', 'not in', ('draft', 'sent'))]}"
                    />
                </xpath>

                <!-- Converted Amount in Footer -->
                <xpath expr="//group[hasclass('oe_subtotal_footer')]" position="inside">
                    <field name="company_currency_id" invisible="1"/>
                    <field
                        name="converted_currency_amount"
                        widget="monetary"
                        options="{'currency_field': 'company_currency_id'}"
                        invisible="allow_custom_currency_rate != True or is_new_currency_rate_visible != True"
                    />
                </xpath>

                <!-- Converted Subtotal Column in Lines -->
                <xpath expr="//field[@name='order_line']/list/field[@name='price_subtotal']" position="after">
                    <field name="converted_subtotal"
                           column_invisible="parent.allow_custom_currency_rate != True or parent.is_new_currency_rate_visible != True"/>
                </xpath>

            </field>
        </record>

    </data>
</odoo>