<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="purchase_order_form_inherit_crm_lead" model="ir.ui.view">
        <field name="name">purchase.order.form.inherit.crm.lead</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="priority" eval="15"/>
        <field name="arch" type="xml">
            <!-- Stat button: Lead/Opportunity -->
            <xpath expr="//button[@name='action_view_invoice']" position="after">
                <button name="action_view_lead" type="object"
                    class="oe_stat_button" icon="fa-star"
                    invisible="not opportunity_id">
                    <span class="o_stat_text">Lead/Opportunity</span>
                </button>
            </xpath>
            <!-- Origin / Lead in Other Information -->
            <xpath expr="//field[@name='origin']" position="after">
                <field name="opportunity_id" string="Lead/Opportunity" readonly="1" options="{'no_create': True}"/>
            </xpath>
        </field>
    </record>
</odoo>
