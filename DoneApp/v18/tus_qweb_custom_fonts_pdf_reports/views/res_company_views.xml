<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Extend Settings View to add Font File Upload option -->
        <record id="res_config_settings_view_form_inherit_custom_font" model="ir.ui.view">
            <field name="name">res.config.settings.view.form.inherit.custom.font</field>
            <field name="model">res.config.settings</field>
            <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
            <field name="arch" type="xml">
                <!-- Add button to manage custom fonts in Document Layout section -->
                <xpath expr="//setting[@id='document_layout_setting']//div[@class='content-group']" position="inside">
                    <div class="mt16">
                        <button name="action_open_custom_font_files" 
                                string="Upload/Choose Font File" 
                                type="object" 
                                class="oe_link" 
                                icon="oi-arrow-right"/>
                    </div>
                </xpath>
            </field>
        </record>
    </data>
</odoo>

