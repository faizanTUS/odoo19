<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="0">
        <record id="email_template_otp_login" model="mail.template">
            <field name="name">OTP Login Verification</field>
            <field name="model_id" ref="base.model_res_users"/>
            <field name="subject">Your One-Time Password (OTP) for Login</field>
            <field name="email_from">${email_from}</field>
            <field name="email_to">${email_to}</field>
            <field name="auto_delete" eval="True"/>
            <field name="body_html" type="html">
                <div style="background-color: #f8f9fa; padding: 20px; border-radius: 5px;">
                    <h2 style="color: #333;">Login Verification</h2>
                    <p>Dear <b><t t-out="object.name"/></b>,</p>
                    <p>A login attempt was made for your account. Please use the following One-Time Password (OTP) to verify your identity:</p>
                    <div style="background-color: #ffffff; padding: 15px; border-radius: 5px; margin: 20px 0; text-align: center;">
                        <h1 style="color: #007bff; letter-spacing: 5px; font-size: 24px;"><t t-out="ctx.get('otp')"/></h1>
                    </div>
                    <div style="margin: 20px 0;">
                        <p><strong>Important Security Information:</strong></p>
                        <ul style="color: #666;">
                            <li>This OTP is valid for 2 minutes only</li>
                            <li>Can only be used once</li>
                            <li>Never share this OTP with anyone</li>
                            <li>Our team will never ask for your OTP</li>
                        </ul>
                    </div>
                    <p style="color: #dc3545;">If you did not request this OTP, please contact us immediately at
                        <a t-att-href="'mailto:' + (object.company_id.email or '')" target="_blank">
                            <t t-out="object.company_id.email"/>
                        </a>
                    </p>
                    <div style="margin-top: 30px; padding-top: 20px; border-top: 1px solid #eee;">
                        <p style="margin: 0;">Best regards,</p>
                        <p style="margin: 5px 0;"><strong><t t-out="object.company_id.name"/></strong></p>
                        <p style="margin: 0;">
                            <a t-att-href="'mailto:' + (object.company_id.email or '')">
                                <t t-out="object.company_id.email"/>
                            </a>
                        </p>
                    </div>
                </div>
            </field>
        </record>


        <!-- Signup OTP Email Template -->
        <record id="mail_template_signup_otp" model="mail.template">
            <field name="name">Signup OTP Email</field>
            <field name="model_id" ref="base.model_res_users"/>
            <field name="subject">Your One-Time Password (OTP) for SignUp</field>
            <field name="email_from">${object.company_id.email or 'info@example.com'}</field>
            <field name="email_to">${email_to}</field>
            <field name="body_html" type="html">
                <style>
                    body { font-family: Arial, sans-serif; line-height: 1.6; color: #333; }
                    .container { padding: 20px; max-width: 600px; margin: 0 auto; }
                    .otp-box { background-color: #f5f5f5; padding: 15px; border-radius: 5px; margin: 20px 0; }
                    .important { color: #ff0000; }
                </style>
                <div class="container">
                    <h2>Welcome to <t t-out="object.company_id.name"/></h2>
                    <p>Dear <b><t t-out="ctx.get('name')"/></b>,</p>
                    <p>Thank you for signing up. To complete your registration, please use the following One-Time Password (OTP):</p>

                    <div class="otp-box">
                        <h3>🔒 Your OTP: <span style="font-size: 24px; color: #007bff;"><t t-out="ctx.get('otp')"/></span></h3>
                    </div>

                    <p><strong>Important Security Information:</strong></p>
                    <ul>
                        <li>This OTP is valid for 2 minutes only</li>
                        <li>This OTP can be used only once</li>
                        <li>Never share your OTP with anyone</li>
                        <li>Our team will never ask for your OTP</li>
                    </ul>

                    <p class="important">If you did not request this OTP, please contact us immediately at
                        <a t-att-href="'mailto:' + (object.company_id.email or '')" target="_blank">
                            <t t-out="object.company_id.email"/>
                        </a>
                    </p>

                    <p style="margin: 0;">Best regards,</p>
                    <p style="margin: 5px 0;"><strong><t t-out="object.company_id.name"/></strong></p>
                    <p style="margin: 0;">
                        <a t-att-href="'mailto:' + (object.company_id.email or '')">
                            <t t-out="object.company_id.email"/>
                        </a>
                    </p>
                </div>
            </field>
        </record>

    </data>
</odoo>
