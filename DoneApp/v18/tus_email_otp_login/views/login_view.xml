<odoo>
    <template id="custom_login_otp_checkbox_template" inherit_id="web.login">
        <xpath expr="//input[@name='password']" position="after">
            <div class="o_login_otp_container">
                <div style="margin-top:10px; display:flex;">
                    <a t-attf-href="?otp_login=true" class="btn btn-link" role="button">
                        Login with OTP
                    </a>
                </div>
            </div>
        </xpath>
<!--        <xpath expr="//form[@class='oe_login_form']" position="attributes">-->
        <xpath expr="//form[contains(@t-attf-class, 'oe_login_form')]" position="attributes">
            <attribute name="t-if">not otp_login</attribute>
        </xpath>
    </template>

    <template id="tus_email_login_template" inherit_id="web.login">
<!--        <xpath expr="//form[@class='oe_login_form']" position="after">-->
        <xpath expr="//form[contains(@t-attf-class, 'oe_login_form')]" position="after">
            <owl-component t-if="not login and not otp_login" name="web.user_switch" />
            <form t-if="otp_login and not otp" id="form_otp_login" t-attf-class="oe_login_form #{'' if login else 'd-none'}" role="form" t-attf-action="/web/otp/login" method="post">
                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                <div class="form-group field-login">
                    <label t-attf-style="margin-bottom:10px" for="login">Email</label>
                    <input type="text" placeholder="Email" name="login" t-att-value="login" id="login" t-attf-class="form-control #{'form-control-sm' if form_small else ''}" required="required" autofocus="autofocus" autocapitalize="off"/>
                </div>
                <p t-if="login_error" class="alert alert-danger" role="alert">
                    The Email entered is incorrect.
                </p>
                <div t-attf-class="clearfix oe_login_buttons text-center mb-1 {{'pt-2' if form_small else 'pt-3'}}">
                    <button style="width:100%" type="submit" class="btn btn-primary btn-block">Send OTP</button>
                </div>
                <div style="margin-top:10px; display:flex;">
                    <a t-attf-href="/web/login" class="btn btn-link" role="button">
                        Login with Password
                    </a>
                </div>
            </form>
        </xpath>
    </template>

    <template id="otp_verification_template" name="OTP Verification Template">
        <t t-call="web.login_layout">
            <div class="container mt-3">
                <form id="form_otp_verification" class="oe_login_form" role="form" t-attf-action="{{ action_url }}" method="post">
                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>

                    <!-- Context-specific hidden fields -->
                    <t t-if="context.get('name')">
                        <input t-att-value="context.get('name')" id="name" type="hidden" name="name"/>
                    </t>
                    <t t-if="context.get('password')">
                        <input t-att-value="context.get('password')" id="password" type="hidden" name="password"/>
                    </t>
                    <t t-if="context.get('confirm_password')">
                        <input t-att-value="context.get('confirm_password')" id="confirm_password" type="hidden" name="confirm_password"/>
                    </t>

                    <!-- Common fields -->
                    <input t-att-value="context.get('login')" id="login" type="hidden" name="login"/>
                    <input t-att-value="context.get('expiry_time')" id="expiry_time" type="hidden" name="expiry_time"/>

                    <!-- OTP Input -->
                    <div class="form-group">
                        <label style="margin-bottom:10px" for="otp">OTP</label>
                        <input type="text" placeholder="OTP" name="otp" id="otp" class="form-control" required="required"/>
                    </div>

                    <!-- Timer display -->
                    <div id="otpTimerContainer" class="mt-3 text-center">
                        <p>Time remaining:
                            <span id="otpTimer" class="font-weight-bold"/>
                        </p>
                    </div>

                    <t t-if="context.get('otp_invalid')">
                        <div class="alert alert-danger" id="otpErrorMsg">
                            The OTP entered is invalid. Please use the button to resend the OTP.
                        </div>
                    </t>

                    <!-- Resend OTP link (hidden initially) -->
                    <div id="otpResendContainer"  t-if="context.get('expiry_time')" class="text-end mt-3" style="display: none;">
                        <a href="#" id="otpResendBtn">Resend OTP</a>
                    </div>

                    <!-- Success/Error messages -->
                    <div id="otpMessage" class="alert mt-3" style="display: none;"/>

                    <div class="d-flex justify-content-between align-items-center mt-3">
                        <!-- Verify button -->
                        <div id="verifyBtnContainer" class="flex-grow-1 me-2" t-attf-style="{{ 'display:none;' if context.get('otp_invalid') else '' }}">
                            <button style="width:100%" type="submit" class="btn btn-primary btn-block" t-esc="submit_button_text"/>
                        </div>

                        <!-- Resend OTP as a BUTTON when OTP is invalid -->
                        <div id="resendBtnInvalidContainer" class="flex-grow-1 me-2" t-if="context.get('otp_invalid')">
                            <button style="width:100%" id="otpResendBtnInvalid" type="button" class="btn btn-primary btn-block">
                                Resend OTP
                            </button>
                        </div>
                    </div>

                </form>
            </div>
        </t>
    </template>
</odoo>
