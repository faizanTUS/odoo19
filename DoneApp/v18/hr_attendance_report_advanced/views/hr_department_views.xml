<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Department Form View Extension -->
    <record id="view_hr_department_form_inherit_attendance" model="ir.ui.view">
        <field name="name">hr.department.form.inherit.attendance</field>
        <field name="model">hr.department</field>
        <field name="inherit_id" ref="hr.view_department_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <notebook position="after">
                    <page string="Attendance" name="attendance_tab">
                        <group string="Attendance Settings">
                            <field name="attendance_alert_recipients" widget="many2many_tags"/>
                            <field name="attendance_report_recipients" widget="many2many_tags"/>
                            <field name="standard_hours" help="Standard working hours per day for this department"/>
                            <field name="overtime_threshold" help="Hours after which overtime is calculated"/>
                        </group>

                        <group string="Attendance Summary">
                            <label for="current_month_summary" string="Current Month Summary"/>
                            <div class="o_stat_text">
                                <field name="attendance_summary" id="current_month_summary" nolabel="1" readonly="1"/>
                            </div>
                        </group>

                        <footer>
                            <button name="action_view_department_attendance" string="View Attendance Report"
                                    type="object" class="btn-primary"/>
                        </footer>
                    </page>
                </notebook>
            </xpath>
        </field>
    </record>
</odoo>