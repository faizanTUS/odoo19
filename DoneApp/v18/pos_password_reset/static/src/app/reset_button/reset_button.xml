<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="pos_password_reset.CustomSelectionPopup" t-inherit="point_of_sale.SelectionPopup"
       t-inherit-mode="extension">
        <xpath expr="//i[contains(@t-attf-class, 'oi-chevron-right')]" position="attributes">
            <attribute name="t-attf-class">
                {{ item.isSelected ? 'fa fa-check text-action' : 'oi oi-chevron-right d-none' }}
            </attribute>
        </xpath>

        <xpath expr="//i" position="before">
<!--            todo: this below if condition is remaining to implement here. Thanks-->
<!--            <t t-esc="item.item.user_id == env.services.pos.user.id || env.services.user.isAdmin"/>-->
            <button style="height:40px; width:75px;"
                 class="btn-reset selection-item d-flex align-items-center btn btn-lg btn-primary p-3 text-start"
                 data-popup="reset-button-popup"
                 t-attf-id="#{item.id}"
                 t-on-click="resetPassword">
                <span style="text-align:center;"><b>Reset</b></span>
            </button>
        </xpath>
    </t>
</templates>

