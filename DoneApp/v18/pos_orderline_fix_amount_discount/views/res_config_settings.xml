<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.pos_orderline_fix_amount_discount</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//block[@id='pos_interface_section']" position="inside">
                <setting id="allow_fix_discount" string="Enable Fix Discount" help="Allow user to add line fix discount(in amount)">
                    <field name="pos_fix_discount" />
                </setting>
            </xpath>
        </field>
    </record>

</odoo>
