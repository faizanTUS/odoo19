<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="ir_cron_petty_cash_critical" model="ir.cron">
        <field name="name">Petty Cash: critical balance check</field>
        <field name="model_id" ref="model_petty_cash_fund"/>
        <field name="state">code</field>
        <field name="code">model._cron_check_critical_balances()</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
