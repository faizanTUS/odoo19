<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="pos_payment_method_view_form_inherit_pos_general" model="ir.ui.view">
        <field name="name">pos.payment.method.form.inherit.general</field>
        <field name="model">pos.payment.method</field>
        <field name="inherit_id" ref="point_of_sale.pos_payment_method_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='journal_id']" position="after">
                <field name="user_ids" context="{'is_pos_users': 1}" groups="point_of_sale.group_pos_manager" invisible="type == 'cash'" options="{'no_create_edit': True}" widget="many2many_tags"/>
            </xpath></field>
    </record>
</odoo>
