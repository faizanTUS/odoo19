<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_rma_product_type_tree" model="ir.ui.view">
        <field name="name">rma.product.type.tree</field>
        <field name="model">rma.product.type</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="name"/>
                <field name="description"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="action_rma_product_type" model="ir.actions.act_window">
        <field name="name">RMA Product Types</field>
        <field name="res_model">rma.product.type</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
