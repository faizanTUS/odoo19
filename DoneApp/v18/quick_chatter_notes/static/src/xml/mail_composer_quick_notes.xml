<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

  <t t-inherit="mail.Composer.actionButtons"
     t-inherit-mode="extension">

    <xpath expr="//div[contains(@class,'o_Composer_actionButtons')]"
           position="inside">

      <button
        class="o_Composer_actionButton btn btn-light border-0 rounded-circle p-0 o_quick_notes_button"
        title="Quick Notes"
        aria-label="Quick Notes"
        type="button"
        t-on-click="openQuickNotes"
        style="height:35px;width:35px;"
      >
        <i class="fa fa-file-text-o"/>
      </button>

    </xpath>

  </t>
</templates>
