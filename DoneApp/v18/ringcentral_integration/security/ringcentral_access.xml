<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Access Rights for RingCentral Config -->
        <record id="access_ringcentral_config_admin" model="ir.model.access">
            <field name="name">ringcentral.config.admin</field>
            <field name="model_id" ref="model_ringcentral_config"/>
            <field name="group_id" ref="ringcentral_integration.group_ringcentral_admin"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="1"/>
        </record>

        <record id="access_ringcentral_config_user" model="ir.model.access">
            <field name="name">ringcentral.config.user</field>
            <field name="model_id" ref="model_ringcentral_config"/>
            <field name="group_id" ref="ringcentral_integration.group_ringcentral_user"/>
            <field name="perm_read" eval="0"/>
            <field name="perm_write" eval="0"/>
            <field name="perm_create" eval="0"/>
            <field name="perm_unlink" eval="0"/>
        </record>

        <!-- Access Rights for RingCentral Call History -->
        <record id="access_ringcentral_call_history_admin" model="ir.model.access">
            <field name="name">ringcentral.call.history.admin</field>
            <field name="model_id" ref="model_ringcentral_call_history"/>
            <field name="group_id" ref="ringcentral_integration.group_ringcentral_admin"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="1"/>
        </record>

        <record id="access_ringcentral_call_history_user" model="ir.model.access">
            <field name="name">ringcentral.call.history.user</field>
            <field name="model_id" ref="model_ringcentral_call_history"/>
            <field name="group_id" ref="ringcentral_integration.group_ringcentral_user"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="0"/>
        </record>

        <!-- Access Rights for RingCentral KPI -->
        <record id="access_ringcentral_kpi_admin" model="ir.model.access">
            <field name="name">ringcentral.kpi.admin</field>
            <field name="model_id" ref="model_ringcentral_kpi"/>
            <field name="group_id" ref="ringcentral_integration.group_ringcentral_admin"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
