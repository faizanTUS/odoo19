<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <!-- Module Category for RingCentral -->
        <record id="module_category_ringcentral" model="ir.module.category">
            <field name="name">RingCentral</field>
            <field name="description">RingCentral Integration - Manage calls, history, and settings</field>
            <field name="sequence">60</field>
        </record>

        <!-- Security Groups (Odoo 18 style: use category_id, no res.groups.privilege) -->

        <!-- RingCentral Administrator -->
        <record id="group_ringcentral_admin" model="res.groups">
            <!-- Give it a clear, unique name in the UI -->
            <field name="name">RingCentral Administrator</field>
            <!-- Link group directly to module category -->
            <field name="category_id" ref="module_category_ringcentral"/>
            <field name="comment">
                Can configure RingCentral settings and view all call history.
            </field>
            <!-- Optional but usually desired: has standard user rights -->
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <!-- RingCentral User -->
        <record id="group_ringcentral_user" model="res.groups">
            <field name="name">RingCentral User</field>
            <field name="category_id" ref="module_category_ringcentral"/>
            <field name="comment">
                Can view own RingCentral call history only.
            </field>
            <!-- Optional: normal internal user -->
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

    </data>
</odoo>
