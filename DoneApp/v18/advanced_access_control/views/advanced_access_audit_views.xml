<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_advanced_access_audit_log_tree" model="ir.ui.view">
        <field name="name">advanced.access.audit.log.tree</field>
        <field name="model">advanced.access.audit.log</field>
        <field name="arch" type="xml">
            <list string="Access denials" create="false" delete="false" edit="false">
                <field name="create_date"/>
                <field name="user_id"/>
                <field name="policy_id"/>
                <field name="model_name"/>
                <field name="operation"/>
                <field name="detail"/>
            </list>
        </field>
    </record>

    <record id="view_advanced_access_audit_log_form" model="ir.ui.view">
        <field name="name">advanced.access.audit.log.form</field>
        <field name="model">advanced.access.audit.log</field>
        <field name="arch" type="xml">
            <form string="Access denial" create="false" delete="false" edit="false">
                <sheet>
                    <group>
                        <field name="create_date"/>
                        <field name="user_id"/>
                        <field name="policy_id"/>
                        <field name="model_name"/>
                        <field name="operation"/>
                    </group>
                    <field name="detail" nolabel="1"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_advanced_access_audit_log" model="ir.actions.act_window">
        <field name="name">Access audit log</field>
        <field name="res_model">advanced.access.audit.log</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
