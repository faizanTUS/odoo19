<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_out_of_stock_columns" model="ir.ui.view">
        <field name="name">sale.order.form.out.of.stock.columns</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']/list/field[@name='product_uom_qty']" position="after">
                <field
                    name="restriction_qty_available"
                    string="On Hand"
                    optional="hide"
                    readonly="1"
                />
                <field
                    name="restriction_virtual_available"
                    string="Forecast"
                    optional="hide"
                    readonly="1"
                />
            </xpath>
        </field>
    </record>
</odoo>
