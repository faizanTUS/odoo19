<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_map2_attachment_example_tree" model="ir.ui.view">
        <field name="name">map2.attachment.example.list</field>
        <field name="model">map2.attachment.example</field>
        <field name="arch" type="xml">
            <list string="Attachment preview examples">
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="view_map2_attachment_example_form" model="ir.ui.view">
        <field name="name">map2.attachment.example.form</field>
        <field name="model">map2.attachment.example</field>
        <field name="arch" type="xml">
            <form string="Attachment preview example">
                <sheet>
                    <group>
                        <field name="name" placeholder="e.g. Test upload"/>
                    </group>
                    <group string="Attachments">
                        <field
                            name="attachment_ids"
                            widget="many2many_binary"
                            colspan="2"
                            nolabel="1"
                        />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_map2_attachment_example" model="ir.actions.act_window">
        <field name="name">Attachment preview example</field>
        <field name="res_model">map2.attachment.example</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
        id="menu_map2_attachment_example"
        name="Attachment preview example"
        parent="mail.menu_configuration"
        action="action_map2_attachment_example"
        sequence="90"
    />
</odoo>
