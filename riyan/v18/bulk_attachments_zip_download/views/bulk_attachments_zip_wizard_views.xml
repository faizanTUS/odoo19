<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_bulk_attachments_zip_wizard_form" model="ir.ui.view">
        <field name="name">bulk.attachments.zip.wizard.form</field>
        <field name="model">bulk.attachments.zip.wizard</field>
        <field name="arch" type="xml">
            <form string="Download attachments as ZIP">
                <sheet>
                    <group>
                        <group string="Selection">
                            <field name="res_model"/>
                            <field name="res_ids"/>
                            <field name="include_chatter"/>
                        </group>
                        <group string="Summary">
                            <field name="attachment_count"/>
                            <field name="total_bytes" widget="integer"/>
                        </group>
                    </group>
                    <group string="Files in this archive">
                        <field name="line_ids" nolabel="1" colspan="2">
                            <!-- not editable: avoids OWL/x2many issues updating lines when toggling chatter -->
                            <list create="0" delete="1">
                                <!-- Required for save: client must keep attachment_id when toggling chatter / Refresh -->
                                <field name="attachment_id" column_invisible="1"/>
                                <field name="name" string="Filename"/>
                                <field name="mimetype" string="Type"/>
                                <field name="file_size" string="Size"/>
                                <field name="source" optional="show"/>
                            </list>
                        </field>
                    </group>
                </sheet>
                <footer>
                    <button
                        name="action_refresh_lines"
                        type="object"
                        string="Refresh list"
                        class="btn-secondary"
                    />
                    <button
                        name="action_download_zip"
                        type="object"
                        string="Download"
                        class="btn-primary"
                    />
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_bulk_attachments_zip_wizard" model="ir.actions.act_window">
        <field name="name">Download attachments (ZIP)</field>
        <field name="res_model">bulk.attachments.zip.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
