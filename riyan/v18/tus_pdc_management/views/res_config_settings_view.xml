<odoo>
    <record id="view_res_config_settings_tus_pdc" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.tus.pdc</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='account_vendor_bills']" position="after">
                <block title="PDC Payment" id="tus_pdc_payment_block">
                    <setting string="PDC Accounts and Journals">
                        <div class="row mt8">
                            <label for="customer_pdc_account_id" class="col-lg-6 o_light_label" string="PDC Account For Customer"/>
                            <field name="customer_pdc_account_id"/>
                        </div>
                        <div class="row mt8">
                            <label for="customer_pdc_journal_id" class="col-lg-6 o_light_label" string="Customer PDC Journal"/>
                            <field name="customer_pdc_journal_id"/>
                        </div>
                    </setting>
                    <setting string="PDC Accounts and Journals">

                        <div class="row mt8">
                            <label for="customer_pdc_bounce_account_id" class="col-lg-6 o_light_label" string="Customer PDC Bounce Account"/>
                            <field name="customer_pdc_bounce_account_id"/>
                        </div>
                        <div class="row mt8">
                            <label for="pdc_bank_journal_id" class="col-lg-6 o_light_label" string="PDC Bank Journal"/>
                            <field name="pdc_bank_journal_id"/>
                        </div>
                    </setting>
                    <setting>
                        <div class="row mt8">
                            <label for="vendor_pdc_account_id" class="col-lg-6 o_light_label" string="Vendor PDC Account"/>
                            <field name="vendor_pdc_account_id"/>
                        </div>
                        <div class="row mt8">
                            <label for="vendor_pdc_journal_id" class="col-lg-6 o_light_label" string="Vendor PDC Journal"/>
                            <field name="vendor_pdc_journal_id"/>
                        </div>

                    </setting>
                    <setting>
                        <div class="row mt8">
                            <label for="vendor_pdc_bounce_account_id" class="col-lg-6 o_light_label" string="Vendor PDC Bounce Account"/>
                            <field name="vendor_pdc_bounce_account_id"/>
                        </div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
