<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Wizard Form View -->
    <record id="view_stock_backdate_wizard_form" model="ir.ui.view">
        <field name="name">stock.backdate.wizard.form</field>
        <field name="model">stock.backdate.wizard</field>
        <field name="arch" type="xml">
            <form string="Mass Backdate Stock Operations">
                <group>
                    <group>
                        <field name="backdate"/>
                        <field name="backdate_reason"/>
                    </group>
                    <group>
                        <field name="recalculate_accounting"/>
                    </group>
                </group>

                <group string="Transfers Selection">
                    <field name="picking_domain" placeholder="[('state', '=', 'done')]"/>
                    <p class="text-muted mb-0">
                        Enter a domain (list of tuples) to select which transfers to backdate. Only transfers in state <strong>Done</strong> are processed.
                        <br/>
                        Examples:
                        <br/>
                        • All done: <code>[('state', '=', 'done')]</code>
                        <br/>
                        • Done deliveries: <code>[('state', '=', 'done'), ('picking_type_code', '=', 'outgoing')]</code>
                        <br/>
                        • Done receipts: <code>[('state', '=', 'done'), ('picking_type_code', '=', 'incoming')]</code>
                    </p>
                </group>

                <footer>
                    <button name="action_mass_backdate" string="Apply Mass Backdate" type="object" class="oe_highlight"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Action to open the wizard from the menu -->
    <record id="action_stock_backdate_wizard" model="ir.actions.act_window">
        <field name="name">Mass Backdate Stock Operations</field>
        <field name="res_model">stock.backdate.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- Menu Item: visible to Stock Managers so the option appears under Configuration -->
    <menuitem id="menu_stock_backdate_wizard"
              name="Mass Backdate"
              action="inventory_backdate_advanced.action_stock_backdate_wizard"
              parent="stock.menu_stock_config_settings"
              sequence="99"
              groups="stock.group_stock_manager"/>

    <!-- Contextual Action on stock.picking list view -->
    <record id="action_stock_picking_backdate_wizard" model="ir.actions.act_window">
        <field name="name">Backdate Selected Transfers</field>
        <field name="res_model">stock.backdate.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="stock.model_stock_picking"/>
        <field name="binding_view_types">list</field>
    </record>

</odoo>
