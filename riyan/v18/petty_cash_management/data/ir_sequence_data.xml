<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="seq_petty_cash_voucher" model="ir.sequence">
        <field name="name">Petty Cash Voucher</field>
        <field name="code">petty.cash.voucher</field>
        <field name="prefix">PCV/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
    <record id="seq_petty_cash_replenishment" model="ir.sequence">
        <field name="name">Petty Cash Replenishment</field>
        <field name="code">petty.cash.replenishment</field>
        <field name="prefix">PCR/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
</odoo>
