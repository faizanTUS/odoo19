<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_petty_cash_approval_reject_wizard" model="ir.ui.view">
        <field name="name">petty.cash.approval.reject.wizard.form</field>
        <field name="model">petty.cash.approval.reject.wizard</field>
        <field name="arch" type="xml">
            <form string="Reject Voucher">
                <group>
                    <field name="voucher_id" invisible="1"/>
                    <field name="reason" placeholder="Explain why this voucher is rejected..."/>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="Confirm Rejection" class="btn-primary" data-hotkey="q"/>
                    <button string="Cancel" class="btn-secondary" special="cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
