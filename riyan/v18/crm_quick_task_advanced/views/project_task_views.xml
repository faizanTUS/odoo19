<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Project Task form: show Lead/Opportunity link -->
    <record id="project_task_view_form_lead" model="ir.ui.view">
        <field name="name">project.task.form.lead</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_form2"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='project']/field[@name='project_id']" position="after">
                <field name="lead_id" options="{'no_create': True}" readonly="1"/>
            </xpath>
        </field>
    </record>
</odoo>
