<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Step 1: Create the module category (still needed for the privilege) -->
    <record id="module_category_document_hub" model="ir.module.category">
        <field name="name">Document Directory Hub</field>
        <field name="description">Advanced attachment organization: directories, tags, and security.</field>
        <field name="sequence">55</field>
    </record>

    <!-- Step 2: Create the privilege — this becomes the section header on the user form -->
    <record id="privilege_document_hub" model="res.groups.privilege">
        <field name="name">Document Directory Hub</field>
        <field name="sequence">55</field>
        <field name="category_id" ref="module_category_document_hub"/>
    </record>

    <!-- Step 3: Link groups to privilege_id instead of category_id -->
    <record id="group_document_hub_manager" model="res.groups">
        <field name="name">Document Manager</field>
        <field name="privilege_id" ref="privilege_document_hub"/>
        <field name="sequence">1</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Full directories, all documents, tag configuration, security.</field>
    </record>

    <record id="group_document_hub_user" model="res.groups">
        <field name="name">Document User</field>
        <field name="privilege_id" ref="privilege_document_hub"/>
        <field name="sequence">2</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Sees only assigned directories; can apply existing document tags.</field>
    </record>

    <record id="group_document_hub_employee" model="res.groups">
        <field name="name">Document Employee (My Documents)</field>
        <field name="privilege_id" ref="privilege_document_hub"/>
        <field name="sequence">3</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Restricted to the My Documents menu and own files only.</field>
    </record>
</odoo>