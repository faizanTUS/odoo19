<odoo>
    <data>

        <record id="view_tus_pdc_create_wizard_form" model="ir.ui.view">
            <field name="name">tus.pdc.create.wizard.form</field>
            <field name="model">tus.pdc.create.wizard</field>
            <field name="arch" type="xml">
                <form string="Create PDC">
                    <group>
                        <field name="invoice_ids" widget="many2many_tags" readonly="1"/>
                        <field name="pdc_type" readonly="1"/>
                        <field name="partner_id" readonly="1"/>
                        <field name="cheque_date"/>
                        <field name="cheque_number"/>
                        <field name="bank_name"/>
                        <field name="currency_id" readonly="1"/>
                        <field name="amount"/>
                    </group>
                    <footer>
                        <button name="action_create_pdc" type="object" string="Create" class="btn-primary"/>
                        <button special="cancel" string="Cancel" class="btn-secondary"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="action_tus_pdc_create_wizard" model="ir.actions.act_window">
            <field name="name">Create PDC</field>
            <field name="res_model">tus.pdc.create.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
            <field name="context">{'active_ids': active_ids}</field>
        </record>

    </data>
</odoo>
