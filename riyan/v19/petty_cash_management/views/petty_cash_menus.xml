<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_petty_cash_dashboard" model="ir.actions.client">
        <field name="name">Dashboard</field>
        <field name="tag">petty_cash_dashboard</field>
    </record>

    <record id="action_petty_cash_fund" model="ir.actions.act_window">
        <field name="name">Petty Cash Funds</field>
        <field name="res_model">petty.cash.fund</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_petty_cash_fund_search"/>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create a petty cash fund</p>
            <p>Link a dedicated GL account, journal, and spend policy for each cash box.</p>
        </field>
    </record>

    <record id="action_petty_cash_voucher" model="ir.actions.act_window">
        <field name="name">Vouchers</field>
        <field name="res_model">petty.cash.voucher</field>
        <field name="view_mode">list,form,graph,pivot</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create a voucher</p>
            <p>Request petty cash spending with policy checks and approvals.</p>
        </field>
    </record>

    <record id="action_petty_cash_replenishment" model="ir.actions.act_window">
        <field name="name">Replenishments</field>
        <field name="res_model">petty.cash.replenishment</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_petty_cash_aging" model="ir.actions.act_window">
        <field name="name">Aging Analysis</field>
        <field name="res_model">petty.cash.voucher</field>
        <field name="view_mode">list,graph,pivot</field>
        <field name="domain">[('state', 'not in', ('draft', 'cancelled', 'rejected')), ('is_reconciled', '=', False)]</field>
        <field name="context">{'search_default_group_aging': 1}</field>
    </record>

    <record id="action_petty_cash_category" model="ir.actions.act_window">
        <field name="name">Expense Categories</field>
        <field name="res_model">petty.cash.category</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_petty_cash_policy" model="ir.actions.act_window">
        <field name="name">Spend Policies</field>
        <field name="res_model">petty.cash.policy</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_petty_cash_root"
              name="Petty Cash"
              sequence="25"
              web_icon="account,static/description/icon.png"
              groups="petty_cash_management.group_petty_cash_user"/>

    <menuitem id="menu_petty_cash_dashboard"
              name="Dashboard"
              parent="menu_petty_cash_root"
              action="action_petty_cash_dashboard"
              sequence="1"/>

    <menuitem id="menu_petty_cash_funds"
              name="Funds"
              parent="menu_petty_cash_root"
              action="action_petty_cash_fund"
              sequence="5"/>

    <menuitem id="menu_petty_cash_vouchers"
              name="Vouchers"
              parent="menu_petty_cash_root"
              action="action_petty_cash_voucher"
              sequence="10"/>

    <menuitem id="menu_petty_cash_replenishments"
              name="Replenishments"
              parent="menu_petty_cash_root"
              action="action_petty_cash_replenishment"
              sequence="15"/>

    <menuitem id="menu_petty_cash_reporting"
              name="Reporting"
              parent="menu_petty_cash_root"
              sequence="40"/>

    <menuitem id="menu_petty_cash_aging"
              name="Aging Analysis"
              parent="menu_petty_cash_reporting"
              action="action_petty_cash_aging"
              sequence="10"/>

    <menuitem id="menu_petty_cash_configuration"
              name="Configuration"
              parent="menu_petty_cash_root"
              sequence="90"
              groups="petty_cash_management.group_petty_cash_manager"/>

    <menuitem id="menu_petty_cash_category"
              name="Expense Categories"
              parent="menu_petty_cash_configuration"
              action="action_petty_cash_category"
              sequence="10"/>

    <menuitem id="menu_petty_cash_policy"
              name="Spend Policies"
              parent="menu_petty_cash_configuration"
              action="action_petty_cash_policy"
              sequence="20"/>
</odoo>
