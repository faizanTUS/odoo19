<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <record id="view_product_pricelist_form_cumulative" model="ir.ui.view">
    <field name="name">product.pricelist.form.cumulative.by.template</field>
    <field name="model">product.pricelist</field>
    <field name="inherit_id" ref="product.product_pricelist_view"/>
    <field name="arch" type="xml">
      <xpath expr="//notebook" position="inside">
        <page string="Cumulative by Template">
            <group>
                <group>
                    <field name="cumulative_by_template"/>
                </group>
                <group>

                </group>
                <label for="cumulative_by_template" string="If enabled, min quantity tiers are evaluated using the sum of all variants (same product template) present on the order/cart."/>
            </group>
        </page>
      </xpath>
    </field>
  </record>
</odoo>
