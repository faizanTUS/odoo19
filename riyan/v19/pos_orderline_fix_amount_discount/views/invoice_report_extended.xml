<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_invoice_document" inherit_id="account.report_invoice_document">
        <xpath expr="//table[@name='invoice_line_table']//thead//th[@name='th_priceunit']" position="after">
            <th name="th_discount_amount" class="text-end">
                <span>Discount(Amount)</span>
            </th>
        </xpath>
        <xpath expr="//table[@name='invoice_line_table']//tbody//td[@name='td_price_unit']" position="after">
            <td name="td_discount_amount" class="text-end">
                <span class="text-nowrap" t-field="line.discount_amount" />
            </td>
        </xpath>
    </template>
</odoo>
