<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_inherit_pos_product_price_display" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.pos.product.price.display</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
             <xpath expr="//block[@id='pos_payment_section']" position="inside">
                <setting id="product_price_display" string="Product Price Display" help="Choose whether to show product prices on POS product cards including or excluding sales tax." invisible="not pos_config_id">
                    <field name="pos_iface_tax_included" class="o_light_label" widget="radio"/>
                    <div class="content-group text-muted small mt-1">
                        <p class="mb-1">
                            <strong>With Sales Tax:</strong> Users can enable the option to display product prices including sales tax. Once activated, the Point of Sale interface automatically updates all product prices to show tax-inclusive amounts.
                        </p>
                        <p class="mb-0">
                            <strong>Without Sales Tax:</strong> Businesses can also choose to display product prices excluding sales tax from the same POS settings panel. By selecting this option, the POS interface switches to showing net prices.
                        </p>
                    </div>
                    <div class="content-group mt16" invisible="not pos_config_id">
                        <div class="row">
                            <div class="col-lg-3 o_light_label">
                                <label for="pos_display_product_price_on_card" string="Show price on product cards"/>
                            </div>
                            <div class="col-lg-9">
                                <field name="pos_display_product_price_on_card"/>
                            </div>
                        </div>
                    </div>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
