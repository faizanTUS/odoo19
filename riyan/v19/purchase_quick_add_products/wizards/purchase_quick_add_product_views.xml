<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_purchase_quick_add_product_form" model="ir.ui.view">
        <field name="name">purchase.quick.add.product.form</field>
        <field name="model">purchase.quick.add.product</field>
        <field name="arch" type="xml">
            <form string="Quick Add Products">
                <field name="purchase_order_id" invisible="1"/>

                <group>
                    <p class="oe_grey">
                        Add products manually or use "Add Multiple Products" for bulk selection.<br/>
                        Prices are auto-filled from vendor pricelist (or cost price fallback).
                    </p>
                </group>

                <header>
                    <button name="action_open_multi_product_select"
                            type="object"
                            string="Add Multiple Products"
                            class="oe_highlight"/>
                </header>

                <field name="product_line_ids" nolabel="1">
                    <list editable="bottom">
                        <field name="product_id" required="1" domain="[('purchase_ok', '=', True)]"/>
                        <field name="quantity"/>
                        <field name="price_unit"/>
                    </list>
                </field>

                <footer>
                    <button name="action_add_products" string="Add Products" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="view_product_tree_multi_select" model="ir.ui.view">
        <field name="name">product.product.tree.multi.select</field>
        <field name="model">product.product</field>
        <field name="arch" type="xml">
            <list string="Select Products" create="false" delete="false">
                <header>
                    <button name="action_add_selected_to_quick_wizard"
                            type="object"
                            string="Add Selected"
                            class="btn-primary"/>
                </header>
                <field name="default_code" string="Internal Reference"/>
                <field name="name" string="Name"/>
                <field name="uom_id" string="UoM"/>
                <field name="standard_price" string="Cost" optional="show"/>
            </list>
        </field>
    </record>

    <record id="action_purchase_quick_add_product" model="ir.actions.act_window">
        <field name="name">Quick Add Products</field>
        <field name="res_model">purchase.quick.add.product</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>