<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_document_directory_tag_tree" model="ir.ui.view">
        <field name="name">document.directory.tag.list</field>
        <field name="model">document.directory.tag</field>
        <field name="arch" type="xml">
            <tree string="Directory Tags" editable="bottom">
                <field name="name"/>
                <field name="color" widget="color_picker"/>
            </tree>
        </field>
    </record>

    <record id="view_document_directory_tag_form" model="ir.ui.view">
        <field name="name">document.directory.tag.form</field>
        <field name="model">document.directory.tag</field>
        <field name="arch" type="xml">
            <form string="Directory Tag">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="color" widget="color_picker"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_document_directory_tag" model="ir.actions.act_window">
        <field name="name">Directory Tags</field>
        <field name="res_model">document.directory.tag</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
