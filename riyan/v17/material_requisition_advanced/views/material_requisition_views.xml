<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_material_requisition_tree" model="ir.ui.view">
        <field name="name">material.requisition.tree</field>
        <field name="model">material.requisition</field>
        <field name="arch" type="xml">
            <tree string="Material Requisitions" decoration-info="state=='confirmed'" decoration-success="state in ('approved_officer','dispatch','received')" decoration-warning="state=='approved_manager'" decoration-danger="state=='rejected'" decoration-muted="state=='draft'">
                <field name="name"/>
                <field name="request_date"/>
                <field name="requested_by_id"/>
                <field name="department_id"/>
                <field name="dest_location_id"/>
                <field name="state" widget="badge" decoration-info="state=='confirmed'" decoration-success="state in ('approved_officer','dispatch','received')" decoration-warning="state=='approved_manager'" decoration-danger="state=='rejected'" decoration-muted="state=='draft'"/>
            </tree>
        </field>
    </record>

    <record id="view_material_requisition_form" model="ir.ui.view">
        <field name="name">material.requisition.form</field>
        <field name="model">material.requisition</field>
        <field name="arch" type="xml">
            <form string="Material Requisition">
                <header>
                    <button name="action_confirm" string="Confirm Request" type="object" class="oe_highlight"
                            invisible="state != 'draft'"/>
                    <button name="action_approve_manager" string="Approve" type="object" class="oe_highlight"
                            invisible="state != 'confirmed'"
                            groups="material_requisition_advanced.group_material_requisition_manager"/>
                    <button name="action_reject_manager" string="Reject" type="object" invisible="state != 'confirmed'"
                            groups="material_requisition_advanced.group_material_requisition_manager"/>
                    <button name="action_approve_officer" string="Approve" type="object" class="oe_highlight"
                            invisible="state not in ('confirmed','approved_manager')"
                            groups="material_requisition_advanced.group_material_requisition_officer"/>
                    <button name="action_reject_officer" string="Reject" type="object"
                            invisible="state not in ('confirmed','approved_manager')"
                            groups="material_requisition_advanced.group_material_requisition_officer"/>
                    <button name="action_create_picking" string="Create Picking" type="object"
                            invisible="state != 'approved_officer' or requisition_type == 'purchase'"/>
                    <button name="action_create_purchase_order" string="Create Purchase Order" type="object"
                            invisible="state != 'approved_officer' or requisition_type == 'internal'"/>
                    <button name="action_received" string="Received" type="object" class="oe_highlight"
                            invisible="state != 'dispatch'"/>
                    <button name="action_reset_draft" string="Reset to Draft" type="object"
                            invisible="state not in ('draft','rejected')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,confirmed,approved_manager,approved_officer,dispatch,received"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_pickings" type="object" class="oe_stat_button" icon="fa-truck" invisible="picking_count == 0">
                            <field name="picking_count" widget="statinfo" string="Pickings"/>
                        </button>
                        <button name="action_view_purchase_orders" type="object" class="oe_stat_button" icon="fa-shopping-cart" invisible="purchase_order_count == 0">
                            <field name="purchase_order_count" widget="statinfo" string="Purchase Orders"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Rejected" bg_color="text-bg-danger" invisible="state != 'rejected'"/>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="description"/>
                            <field name="request_date"/>
                            <field name="requested_by_id"/>
                            <field name="employee_id"/>
                            <field name="department_id"/>
                            <field name="requisition_type"/>
                            <field name="company_id" invisible="1"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="source_location_id"/>
                            <field name="dest_location_id"/>

                            <field name="approved_manager_id" readonly="1"/>
                            <field name="approved_manager_date" readonly="1"/>
                            <field name="approved_officer_id" readonly="1"/>
                            <field name="approved_officer_date" readonly="1"/>
                            <field name="rejected_by_id" readonly="1" invisible="state != 'rejected'"/>
                            <field name="rejection_reason" readonly="1" invisible="state != 'rejected'" nolabel="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Requisition Lines" name="lines">
                            <field name="line_ids" context="{'default_requisition_id': id}">
                                <tree editable="bottom" create="1" delete="1">
                                    <field name="company_id" invisible="1" optional="hide"/>
                                    <field name="product_id"/>
                                    <field name="description"/>
                                    <field name="required_qty"/>
                                    <field name="product_uom_id"/>
                                    <field name="purchase_price"/>
                                    <field name="requisition_action"/>
                                    <field name="warehouse_id"/>
                                    <field name="picking_type_id" invisible="requisition_action == 'purchase'"/>
                                    <field name="vendor_id"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Picking Details" name="picking_details" invisible="picking_count == 0">
                            <field name="picking_ids" nolabel="1">
                                <tree readonly="1">
                                    <field name="name"/>
                                    <field name="picking_type_id"/>
                                    <field name="origin"/>
                                    <field name="scheduled_date"/>
                                    <field name="state"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Purchase Order Details" name="po_details" invisible="purchase_order_count == 0">
                            <field name="purchase_order_ids" nolabel="1">
                                <tree readonly="1">
                                    <field name="name"/>
                                    <field name="partner_id"/>
                                    <field name="date_order"/>
                                    <field name="amount_total"/>
                                    <field name="state"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_material_requisition_search" model="ir.ui.view">
        <field name="name">material.requisition.search</field>
        <field name="model">material.requisition</field>
        <field name="arch" type="xml">
            <search string="Material Requisitions">
                <field name="name"/>
                <field name="requested_by_id"/>
                <field name="department_id"/>
                <field name="dest_location_id"/>
                <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Confirmed" name="confirmed" domain="[('state', '=', 'confirmed')]"/>
                <filter string="Approved by Manager" name="approved_manager" domain="[('state', '=', 'approved_manager')]"/>
                <filter string="Approved by Officer" name="approved_officer" domain="[('state', '=', 'approved_officer')]"/>
                <filter string="Dispatch" name="dispatch" domain="[('state', '=', 'dispatch')]"/>
                <filter string="Received" name="received" domain="[('state', '=', 'received')]"/>
                <filter string="Rejected" name="rejected" domain="[('state', '=', 'rejected')]"/>
                <filter string="My Requisitions" name="my" domain="[('requested_by_id', '=', uid)]"/>
                <group expand="0" string="Group By">
                    <filter string="Department" name="group_department" context="{'group_by': 'department_id'}"/>
                    <filter string="Requested By" name="group_requested_by" context="{'group_by': 'requested_by_id'}"/>
                </group>
            </search>
        </field>
    </record>
</odoo>
