<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_users_form_inherit_global_search" model="ir.ui.view">
        <field name="name">res.users.form.inherit.global.search</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook/page[@name='access_rights']" position="inside">
                <group string="Global Search" name="global_search">
                    <field name="global_search_model_ids" widget="many2many_tags"
                           domain="['|',('is_mail_thread','=',True),('is_mail_activity','=',True)]"
                           options="{'no_create': True, 'no_open': True}"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
