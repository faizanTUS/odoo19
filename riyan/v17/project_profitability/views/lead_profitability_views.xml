<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_lead_profitability_list" model="ir.ui.view">
        <field name="name">lead.profitability.list</field>
        <field name="model">lead.profitability</field>
        <field name="arch" type="xml">
            <tree string="Lead Profitability" decoration-success="profitability_status == 'excellent'" decoration-info="profitability_status == 'good'" decoration-warning="profitability_status in ('average', 'poor')" decoration-danger="profitability_status == 'loss'">
                <field name="lead_id"/>
                <field name="stage_id"/>
                <field name="partner_id"/>
                <field name="sale_order_id"/>
                <field name="date"/>
                <field name="lead_value"/>
                <field name="so_total"/>
                <field name="revenue_recognized"/>
                <field name="total_cost"/>
                <field name="gross_margin"/>
                <field name="margin_percentage"/>
                <field name="progress"/>
                <field name="profitability_status"/>
                <field name="budget_status"/>
            </tree>
        </field>
    </record>

    <record id="view_lead_profitability_form" model="ir.ui.view">
        <field name="name">lead.profitability.form</field>
        <field name="model">lead.profitability</field>
        <field name="arch" type="xml">
            <form string="Lead Profitability">
                <sheet>
                    <group>
                        <group string="Lead Info (Status → Customer → Lead → SO → Invoice)">
                            <field name="lead_id"/>
                            <field name="stage_id"/>
                            <field name="partner_id"/>
                            <field name="sale_order_id"/>
                            <field name="project_id"/>
                            <field name="analytic_account_id"/>
                            <field name="date"/>
                        </group>
                        <group string="Status">
                            <field name="profitability_status"/>
                            <field name="budget_status"/>
                            <field name="progress"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="company_id" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Revenue" name="revenue">
                            <group>
                                <field name="lead_value"/>
                                <field name="so_total"/>
                                <field name="invoiced_amount"/>
                                <field name="paid_amount"/>
                                <field name="revenue_recognized"/>
                            </group>
                        </page>
                        <page string="Costs" name="costs">
                            <group>
                                <field name="timesheet_cost"/>
                                <field name="expense_cost"/>
                                <field name="vendor_bill_cost"/>
                                <field name="other_cost"/>
                                <field name="total_cost"/>
                            </group>
                        </page>
                        <page string="Budget" name="budget">
                            <group>
                                <field name="budget_revenue"/>
                                <field name="budget_cost"/>
                                <field name="budget_margin"/>
                            </group>
                        </page>
                        <page string="Profitability" name="profitability">
                            <group>
                                <field name="gross_margin"/>
                                <field name="margin_percentage"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

</odoo>
