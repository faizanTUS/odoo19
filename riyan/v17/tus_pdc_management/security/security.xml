<odoo>
    <data>
        <record id="group_tus_pdc_user" model="res.groups">
            <field name="name">PDC User</field>
            <field name="implied_ids" eval="[(4, ref('account.group_account_user'))]"/>
        </record>

        <record id="group_tus_pdc_manager" model="res.groups">
            <field name="name">PDC Manager</field>
            <!-- Don't set category_id to a bogus xmlid -->
            <field name="implied_ids"
                   eval="[(4, ref('tus_pdc_management.group_tus_pdc_user')), (4, ref('account.group_account_manager'))]"/>
            <field name="users" eval="[(4, ref('base.user_admin'))]"/>
        </record>
    </data>
</odoo>
