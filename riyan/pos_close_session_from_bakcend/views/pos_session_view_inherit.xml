<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_pos_session_form_inherit" model="ir.ui.view">
            <field name="name">pos.session.form.inherit</field>
            <field name="model">pos.session</field>
            <field name="inherit_id" ref="point_of_sale.view_pos_session_form"/>
            <field name="arch" type="xml">
                <xpath expr="//button[@name='action_pos_session_closing_control']" position="after">
                    <button class="oe_highlight" invisible="state == 'closed' and cash_register_balance_end_real == False" name="close_session_wizard" string="Close Session and Post Entries" type="object"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
