<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="purchase_order_form_quick_add_product" model="ir.ui.view">
            <field name="name">purchase.order.form.quick.add.product</field>
            <field name="model">purchase.order</field>
            <field name="inherit_id" ref="purchase.purchase_order_form"/>
            <field name="arch" type="xml">
                <xpath expr="//button[@name='action_rfq_send']" position="before">
                    <button name="action_quick_add_product" type="object" string="Quick Add Product"
                            class="oe_highlight"
                            attrs="{'invisible': [('state', 'in', ['done', 'cancel'])]}"
                            groups="purchase_quick_add_products.purchase_quick_add_products_group_user"
                    />
                </xpath>
            </field>
        </record>
    </data>
</odoo>