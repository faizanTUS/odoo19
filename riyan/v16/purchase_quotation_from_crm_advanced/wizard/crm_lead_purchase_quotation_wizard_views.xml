<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="crm_lead_purchase_quotation_wizard_view_form" model="ir.ui.view">
        <field name="name">crm.lead.purchase.quotation.wizard.form</field>
        <field name="model">crm.lead.purchase.quotation.wizard</field>
        <field name="arch" type="xml">
            <form string="New Purchase Quotation">
                <group>
                    <field name="lead_id" readonly="1"/>
                    <field name="lead_company_id" invisible="1"/>
                    <field name="action" widget="radio"/>
                    <field name="partner_id"
                           attrs="{'invisible': [('action', '!=', 'exist')],'required': [('action', '=', 'exist')]}"
                           context="{'default_supplier_rank': 1}"
                           options="{'no_create_edit': False}"/>
                </group>
                <footer>
                    <button name="action_create_purchase_quotation" string="Create Purchase Order" type="object"
                            class="oe_highlight"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
