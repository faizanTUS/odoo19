<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form_inherit_disable_out_of_stock_variant" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.disable.out.of.stock.variant</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="website_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@id='product_attributes_setting']" position="after">
                <div class="col-12 col-lg-6 o_setting_box" id="disable_out_of_stock_variant_setting">
                    <div class="o_setting_left_pane">
                        <field name="website_disable_out_of_stock_variant"/>
                    </div>
                    <div class="o_setting_right_pane">
                        <label for="website_disable_out_of_stock_variant"
                               string="Disable Out of Stock Product Variant"/>
                        <div class="text-muted">
                            Disable out of stock product variant for add to cart. When enabled, out-of-stock variants
                            show "This combination does not exist" and Add to cart is disabled on the product page.
                        </div>
                    </div>
                </div>

                <div class="col-12 col-lg-6 o_setting_box" id="hide_out_of_stock_products_from_shop_setting">
                    <div class="o_setting_left_pane">
                        <field name="website_hide_out_of_stock_products_from_shop"/>
                    </div>
                    <div class="o_setting_right_pane">
                        <label for="website_hide_out_of_stock_products_from_shop"
                               string="Hide Out of Stock Products from Shop"/>
                        <div class="text-muted">
                            When enabled, products with 0 on hand are hidden from the shop listing (e.g. Corner Desk
                            Right Sit with 0 quantity will not appear on /shop).
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>

</odoo>
