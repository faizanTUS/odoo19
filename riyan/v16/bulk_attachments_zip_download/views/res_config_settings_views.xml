<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_bulk_zip" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.bulk.attachments.zip</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@id='languages']" position="after">
                <div id="bulk_attachment">
                    <h2>Bulk attachment ZIP</h2>
                    <div class="row mt16 o_settings_container" name="bulk_attachments_zip_setting">
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane">
                                <field name="bulk_attach_include_chatter"/>
                            </div>
                            <div class="o_setting_right_pane">
                                <label for="bulk_attach_include_chatter" string="Include chatter attachments by default"/>
                                <div class="text-muted">
                                    Files posted on the chatter of selected records are included in the preview when the wizard opens.
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane"/>
                            <div class="o_setting_right_pane">
                                <label for="bulk_attach_max_files" string="Maximum files per ZIP"/>
                                <div class="text-muted">
                                    Use 0 for no limit. Prevents accidental export of thousands of files.
                                </div>
                                <div class="content-group">
                                    <field name="bulk_attach_max_files"/>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane"/>
                            <div class="o_setting_right_pane">
                                <label for="bulk_attach_max_total_mb" string="Maximum total size (MB)"/>
                                <div class="text-muted">
                                    Use 0 for no limit. Compares the sum of attachment sizes before building the archive.
                                </div>
                                <div class="content-group">
                                    <field name="bulk_attach_max_total_mb"/>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
