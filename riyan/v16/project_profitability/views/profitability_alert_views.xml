<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_profitability_alert_list" model="ir.ui.view">
        <field name="name">profitability.alert.list</field>
        <field name="model">profitability.alert</field>
        <field name="arch" type="xml">
            <tree string="Profitability Alerts" editable="bottom">
                <field name="name"/>
                <field name="alert_type"/>
                <field name="threshold_percentage"/>
                <field name="threshold_value"/>
                <field name="send_email"/>
                <field name="active"/>
            </tree>
        </field>
    </record>

    <record id="view_profitability_alert_form" model="ir.ui.view">
        <field name="name">profitability.alert.form</field>
        <field name="model">profitability.alert</field>
        <field name="arch" type="xml">
            <form string="Profitability Alert">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="alert_type"/>
                            <field name="threshold_value" attrs="{'invisible': [('alert_type','not in',('cost_spike'))]}"/>
                            <field name="threshold_percentage"/>
                        </group>
                        <group>
                            <field name="notification_users" widget="many2many_tags"/>
                            <field name="send_email"/>
                            <field name="active"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

</odoo>
