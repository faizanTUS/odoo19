<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_petty_cash" model="ir.module.category">
        <field name="name">Petty Cash</field>
        <field name="description">Petty cash funds, vouchers, and replenishments.</field>
        <field name="sequence">55</field>
    </record>

    <record id="group_petty_cash_user" model="res.groups">
        <field name="name">User</field>
        <field name="category_id" ref="module_category_petty_cash"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_petty_cash_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="category_id" ref="module_category_petty_cash"/>
        <field name="implied_ids" eval="[(4, ref('group_petty_cash_user')), (4, ref('account.group_account_invoice'))]"/>
    </record>

    <record id="petty_cash_voucher_rule_user" model="ir.rule">
        <field name="name">Petty Cash Voucher: own requests</field>
        <field name="model_id" ref="model_petty_cash_voucher"/>
        <field name="groups" eval="[(4, ref('petty_cash_management.group_petty_cash_user'))]"/>
        <field name="domain_force">['|', '|', ('user_id', '=', user.id), ('employee_id.user_id', '=', user.id), ('approval_line_ids.user_id', '=', user.id)]</field>
    </record>

    <record id="petty_cash_voucher_rule_manager" model="ir.rule">
        <field name="name">Petty Cash Voucher: manager sees all</field>
        <field name="model_id" ref="model_petty_cash_voucher"/>
        <field name="groups" eval="[(4, ref('petty_cash_management.group_petty_cash_manager'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>
</odoo>
