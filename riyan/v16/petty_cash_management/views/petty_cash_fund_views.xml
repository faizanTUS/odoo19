<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_petty_cash_fund_tree" model="ir.ui.view">
        <field name="name">petty.cash.fund.tree</field>
        <field name="model">petty.cash.fund</field>
        <field name="arch" type="xml">
            <tree string="Petty Cash Funds" decoration-danger="is_critical == True">
                <field name="name"/>
                <field name="manager_id"/>
                <field name="currency_id"/>
                <field name="balance" sum="Total"/>
                <field name="available_balance"/>
                <field name="min_balance"/>
                <field name="is_critical" invisible="1"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </tree>
        </field>
    </record>

    <record id="view_petty_cash_fund_form" model="ir.ui.view">
        <field name="name">petty.cash.fund.form</field>
        <field name="model">petty.cash.fund</field>
        <field name="arch" type="xml">
            <form string="Petty Cash Fund">
                <header>
                    <button name="action_request_replenishment" type="object" string="Request Replenishment"
                            class="btn-primary" attrs="{'invisible': [('active', '=', False)]}"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_vouchers" type="object" class="oe_stat_button" icon="fa-list">
                            <field name="voucher_count" widget="statinfo" string="Vouchers"/>
                        </button>
                        <button name="action_view_replenishments" type="object" class="oe_stat_button" icon="fa-refresh">
                            <field name="replenishment_count" widget="statinfo" string="Replenishments"/>
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="company_id" invisible="1"/> <!-- Ensure company_id is always in context for domains -->
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="currency_id"/>
                            <field name="manager_id"/>
                            <field name="active"/>
                        </group>
                        <group string="Balances">
                            <field name="balance"/>
                            <field name="available_balance"/>
                            <field name="monthly_spent"/>
                            <field name="is_critical" invisible="1"/>
                            <field name="expected_vs_actual_variance"/>
                        </group>
                    </group>
                    <group string="Accounting">
                        <field name="journal_id"/>
                        <field name="petty_cash_account_id"/>
                        <field name="default_expense_account_id"/>
                        <field name="source_bank_journal_id"/>
                    </group>
                    <group string="Limits &amp; alerts">
                        <field name="policy_id"/>
                        <field name="min_balance"/>
                        <field name="auto_replenish"/>
                        <field name="replenishment_target_amount"/>
                    </group>
                    <group string="Physical count">
                        <field name="physical_balance"/>
                        <field name="last_count_date"/>
                    </group>
                    <notebook>
                        <page string="Approval matrix" name="approval">
                            <field name="approval_rule_ids" context="{'default_fund_id': id}">
                                <tree editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="amount_from"/>
                                    <field name="amount_to"/>
                                    <field name="approver_id"/>
                                    <field name="active"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_petty_cash_fund_search" model="ir.ui.view">
        <field name="name">petty.cash.fund.search</field>
        <field name="model">petty.cash.fund</field>
        <field name="arch" type="xml">
            <search string="Funds">
                <field name="name"/>
                <field name="manager_id"/>
                <filter name="active" string="Active" domain="[('active', '=', True)]"/>
            </search>
        </field>
    </record>
</odoo>
