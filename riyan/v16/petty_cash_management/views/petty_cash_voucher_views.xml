<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_petty_cash_voucher_tree" model="ir.ui.view">
        <field name="name">petty.cash.voucher.list</field>
        <field name="model">petty.cash.voucher</field>
        <field name="arch" type="xml">
            <tree string="Petty Cash Vouchers" decoration-warning="state=='draft'"
                  decoration-danger="require_receipt and not has_receipt" multi_edit="1">
                <field name="name"/>
                <field name="date"/>
                <field name="fund_id"/>
                <field name="employee_id"/>
                <field name="require_receipt" invisible="1"/> <!-- Odoo 16 compatible invisible -->
                <field name="has_receipt" invisible="1"/> <!-- Odoo 16 compatible invisible -->
                <field name="category_id"/>
                <field name="amount" sum="Total"/>
                <field name="state" widget="badge" decoration-success="state=='paid'"
                       decoration-info="state=='under_approval'" decoration-muted="state in ('cancelled','rejected')"/>
                <field name="days_pending"/>
                <field name="aging_bucket"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </tree>
        </field>
    </record>
    <record id="view_petty_cash_voucher_form" model="ir.ui.view">
        <field name="name">petty.cash.voucher.form</field>
        <field name="model">petty.cash.voucher</field>
        <field name="arch" type="xml">
            <form string="Petty Cash Voucher">
                <header>
                    <button name="action_submit" type="object" string="Submit" class="btn-primary"
                            attrs="{'invisible': [('state', '!=', 'draft')]}"/>
                    <button name="action_approve" type="object" string="Approve" class="btn-primary"
                            attrs="{'invisible': [('user_can_approve', '=', False)]}"/>
                    <button name="action_reject_wizard" type="object" string="Reject"
                            attrs="{'invisible': [('user_can_approve', '=', False)]}"/>
                    <button name="action_pay" type="object" string="Register Payment" class="btn-primary"
                            attrs="{'invisible': [('state', '!=', 'approved')]}"
                            groups="petty_cash_management.group_petty_cash_manager"/>
                    <button name="action_mark_reconciled" type="object" string="Mark Reconciled"
                            attrs="{'invisible': ['|', ('state', '!=', 'paid'), ('is_reconciled', '=', True)]}"/>
                    <button name="action_cancel" type="object" string="Cancel"
                            attrs="{'invisible': [('state', 'not in', ('draft','under_approval','approved'))]}"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,under_approval,approved,paid"/>
                </header>
                <sheet>
                    <field name="company_id" invisible="1"/> <!-- Added for domain evaluation -->
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_attachments"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-paperclip">
                            <field name="receipt_count" widget="statinfo" string="Receipts"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="fund_id" attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                            <field name="employee_id" attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                            <field name="user_id" readonly="1"/>
                            <field name="date" attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                        </group>
                        <group>
                            <field name="category_id" attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                            <field name="amount" attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="user_can_approve" invisible="1"/>
                            <field name="is_reconciled" attrs="{'readonly': [('state', '!=', 'paid')]}"/>
                            <field name="require_receipt" invisible="1"/>
                            <field name="has_receipt" widget="boolean_favorite" readonly="1"
                                   attrs="{'invisible': [('require_receipt', '=', False)]}"/>
                        </group>
                    </group>
                    <group>
                        <field name="description" attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                    </group>
                    <group string="Aging" attrs="{'invisible': ['|', ('state', 'in', ('draft','cancelled','rejected')), '&amp;', ('state', '=', 'paid'), ('is_reconciled', '=', True)]}">
                        <field name="days_pending"/>
                        <field name="aging_bucket"/>
                    </group>
                    <group string="Rejection" attrs="{'invisible': [('state', '!=', 'rejected')]}">
                        <field name="rejection_reason" nolabel="1"/>
                    </group>
                    <notebook>
                        <page string="Approvals" name="approvals"
                              attrs="{'invisible': [('approval_line_ids', '=', False)]}">
                            <field name="approval_line_ids">
                                <tree editable="bottom" create="false" delete="false">
                                    <field name="sequence" widget="handle"/>
                                    <field name="user_id"/>
                                    <field name="state"/>
                                    <field name="approval_date"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Receipts" name="receipts">
                            <field name="attachment_ids" widget="many2many_binary" string="Attach Receipts"
                                   class="oe_inline"/>
                        </page>
                        <page string="Accounting" name="accounting">
                            <group>
                                <field name="payment_move_id" readonly="1"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="view_petty_cash_voucher_search" model="ir.ui.view">
        <field name="name">petty.cash.voucher.search</field>
        <field name="model">petty.cash.voucher</field>
        <field name="arch" type="xml">
            <search string="Vouchers">
                <field name="name"/>
                <field name="fund_id"/>
                <field name="employee_id"/>
                <field name="category_id"/>
                <field name="state"/>
                <separator/>
                <filter name="draft" string="Draft" domain="[('state','=','draft')]"/>
                <filter name="approval" string="Under approval" domain="[('state','=','under_approval')]"/>
                <filter name="paid" string="Paid" domain="[('state','=','paid')]"/>
                <filter name="unreconciled" string="Unreconciled"
                        domain="[('state','=','paid'),('is_reconciled','=',False)]"/>
                <filter name="missing_receipt" string="Missing receipt"
                        domain="[('require_receipt','=',True),('has_receipt','=',False)]"/>
                <group expand="0" string="Group By">
                    <filter string="Fund" name="group_fund" context="{'group_by':'fund_id'}"/>
                    <filter string="Status" name="group_state" context="{'group_by':'state'}"/>
                    <filter string="Aging" name="group_aging" context="{'group_by':'aging_bucket'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="view_petty_cash_voucher_graph" model="ir.ui.view">
        <field name="name">petty.cash.voucher.graph</field>
        <field name="model">petty.cash.voucher</field>
        <field name="arch" type="xml">
            <graph string="Vouchers" type="bar">
                <field name="fund_id"/>
                <field name="amount" type="measure"/>
            </graph>
        </field>
    </record>
    <record id="view_petty_cash_voucher_pivot" model="ir.ui.view">
        <field name="name">petty.cash.voucher.pivot</field>
        <field name="model">petty.cash.voucher</field>
        <field name="arch" type="xml">
            <pivot string="Vouchers">
                <field name="fund_id" type="row"/>
                <field name="state" type="col"/>
                <field name="amount" type="measure"/>
            </pivot>
        </field>
    </record>
</odoo>