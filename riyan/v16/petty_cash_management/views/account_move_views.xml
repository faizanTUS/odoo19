<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_petty_cash_move_form" model="ir.ui.view">
        <field name="name">account.move.form.petty.cash</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='journal_div']" position="after">
                <field name="petty_cash_fund_id" attrs="{'invisible': [('move_type', '!=', 'entry')]}"/>
            </xpath>
        </field>
    </record>
</odoo>
