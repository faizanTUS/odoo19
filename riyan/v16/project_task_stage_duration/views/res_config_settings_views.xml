<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_inherit_stage_duration" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.project.task.stage.duration</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="project.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@id='tasks_management']" position="inside">
                <div class="col-lg-6 o_setting_box">
                    <div class="o_setting_left_pane">
                        <field name="global_task_stage_duration_enabled"/>
                    </div>
                    <div class="o_setting_right_pane">
                        <label for="global_task_stage_duration_enabled"/>
                        <div class="text-muted">
                           Track task stage duration and history for all projects.
                        </div>
                    </div>
                </div>
                <div class="col-12 col-lg-6 o_setting_box">
                    <div class="o_setting_left_pane">
                        <field name="global_stage_history_enabled"/>
                    </div>
                    <div class="o_setting_right_pane">
                        <label for="global_stage_history_enabled"/>
                        <div class="text-muted">
                            Record Stage In, Stage Out and Duration for all projects.
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
