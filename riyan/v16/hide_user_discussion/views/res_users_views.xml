<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_users_form_discussion_toggle" model="ir.ui.view">
        <field name="name">res.users.form.discussion.toggle</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <group name="messaging" position="after">
                <group string="Discuss" name="discussion_access" groups="base.group_system,base.group_erp_manager">
                    <field name="discussion_enabled" widget="boolean_toggle"/>
                </group>
            </group>
        </field>
    </record>
</odoo>
