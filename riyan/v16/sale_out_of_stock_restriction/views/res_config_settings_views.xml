                <h2>Out of Stock Restriction</h2>
                <div class="row mt16 o_settings_container" name="sale_out_of_stock_restriction_setting_container">
                    <div class="col-12 col-lg-6 o_setting_box" id="sale_out_of_stock_restriction_enable">
                        <div class="o_setting_left_pane">
                            <field name="sale_out_of_stock_restriction_enabled"/>
                        </div>
                        <div class="o_setting_right_pane">
                            <label for="sale_out_of_stock_restriction_enabled"/>
                            <div class="text-muted">
                                Prevent confirming a quotation when ordered quantity exceeds available stock for storable products.
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-lg-6 o_setting_box" id="sale_out_of_stock_restriction_base" attrs="{'invisible':[('sale_out_of_stock_restriction_enabled','=', False)]}">
                        <div class="o_setting_left_pane">
                        </div>
                        <div class="o_setting_right_pane">
                            <label for="sale_out_of_stock_restriction_base"/>
                            <div class="text-muted">
                                Compare ordered quantity to physical stock on hand, or to forecasted quantity (includes incoming and outgoing moves).
                            </div>
                            <div class="content-group">
                                <div class="mt16">
                                    <field name="sale_out_of_stock_restriction_base" class="o_light_label" widget="radio"/>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>


            </xpath>
        </field>
    </record>
</odoo>
