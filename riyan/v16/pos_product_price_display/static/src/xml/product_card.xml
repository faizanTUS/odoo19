<?xml version="1.0" encoding="UTF-8" ?>
<templates id="template" xml:space="preserve">

    <t t-name="pos_product_price_display.ProductItem" owl="1"
       t-inherit="point_of_sale.ProductItem"
       t-inherit-mode="extension">
        <xpath expr="//span[hasclass('price-tag')]" position="replace">
            <span class="price-tag">
                <t t-esc="price" />
                <t t-if="priceLabel">
                    <br/>
                    <small class="price-label text-muted" style="font-size:12px; font-weight:normal;">
                        <t t-esc="priceLabel" />
                    </small>
                </t>
            </span>
        </xpath>
    </t>

</templates>