<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-inherit="mail.AttachmentCard"
       t-inherit-mode="extension">

        <xpath expr="//div[hasclass('o_AttachmentCard_details')]"
               position="inside">
            <t t-if="attachmentCard.attachment.size">
                <small class="o_AttachmentCard_size text-muted mt-1">
                    File size: 
                    <t t-esc="(attachmentCard.attachment.size / 1048576).toFixed(2)"/> MB
                </small>
            </t>
        </xpath>

    </t>

</templates>
