<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_uap" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.uap</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="mail.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@class='row mt16 o_settings_container'][@id='emails']" position="after">
                <div class="row mt16 o_settings_container">
                    <div class="col-12 col-lg-6 o_setting_box" id="uap_office_preview_setting">
                        <div class="o_setting_left_pane">
                            <field name="uap_office_preview"/>
                        </div>
                        <div class="o_setting_right_pane">
                            <label for="uap_office_preview" string="Universal attachment preview — Microsoft Office"/>
                            <div class="text-muted">
                                Preview Word, Excel, PowerPoint, CSV, and OpenDocument attachments inside Odoo. Uses Microsoft Office Online; web.base.url must be a correct HTTPS URL reachable by external viewers.
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-lg-6 o_setting_box" id="uap_google_fallback_setting">
                        <div class="o_setting_left_pane">
                            <field name="uap_google_viewer_fallback"/>
                        </div>
                        <div class="o_setting_right_pane">
                            <label for="uap_google_viewer_fallback" string="Use Google Docs viewer instead of Microsoft"/>
                            <div class="text-muted">
                                Embeds files with Google Docs viewer instead of Office Online. Use only if allowed by your security policy (file URL is sent to Google).
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
