<?xml version="1.0" encoding="utf-8" ?>
<templates xml:space="preserve">
    <t t-name="tus_printnode.ButtonOptions" owl="1">
        <Dialog size="'md'" title="('Please Enter Number of Print')">
            <div style="text-align:center;">
                <div class="btn-group" role="group">
                    <div class="form-group">
                        <label for="exampleInputPassword1">Number of Print</label>
                        <input
                                type="number"
                                class="form-control"
                                name="number"
                                min="1"
                                max="100"
                        />
                    </div>
                </div>
            </div>
            <t t-set-slot="footer">
<!--                 <button class="btn btn-info" t-on-click="()=>props.onSelectOption('download')">-->
                 <button class="btn btn-info" t-on-click="()=>props.onSelectOption('print')">
                     <i class="fa fa-print"/>
                     <span style="padding-left: 5px;">Print</span>
                 </button>
                <button class="btn btn-info" t-on-click="()=>props.onSelectOption('open')">
                    <i class="fa fa-file-text"/>
                    <span style="padding-left: 5px;">Open</span>
                </button>
                <button class="btn" t-on-click="()=>props.onSelectOption('close')">Cancel</button>
            </t>
        </Dialog>
    </t>
</templates>
