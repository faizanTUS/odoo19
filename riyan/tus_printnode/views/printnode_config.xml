<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data>
        <record id="view_printnode_config_form" model="ir.ui.view">
            <field name="name">printnode.config.form.view</field>
            <field name="model">printnode.config</field>
            <field name="arch" type="xml">
                <form string="PrintNode Account Configration">
                    <header>
                        <field name="state" invisible="1" />
                        <button
                            name="verify_the_connection"
                            string="Confirm"
                            type="object"
                            class="btn-success oe_highlight"
                            invisible="state != 'draft' "
                        />
                        <button
                            name="update_printers_list"
                            type="object"
                            string="Update Printers List"
                            class="oe_highlight"
                            invisible="state != 'confirmed' "
                        />
                        <button
                            name="re_establish_connection"
                            string="Reset"
                            type="object"
                            class="btn-danger oe_highlight"
                            invisible="state != 'confirmed' "
                        />
                        <field name="state" widget="statusbar" />
                    </header>
                    <sheet>

                        <div class="oe_button_box">
                            <button
                                name="open_printer_from_config"
                                class="oe_stat_button"
                                icon="fa-print"
                                type="object"
                            >
                                <field
                                    string="Printers"
                                    name="printer_count"
                                    widget="statinfo"
                                />
                            </button>
                            <button
                                name="open_system_from_config"
                                class="oe_stat_button"
                                icon="fa-desktop"
                                type="object"
                            >
                                <field
                                    string="System"
                                    name="system_count"
                                    widget="statinfo"
                                />
                            </button>
                        </div>

                        <div class="oe_title">
                            <label
                                class="oe_edit_only"
                                for="name"
                                string="Account Name"
                            />
                            <h1>
                                <field name="name" placeholder="Account Name" />
                            </h1>
                        </div>
                        <group>
                            <group string="Authentication">
                                <field
                                    name="api_key"
                                    readonly="state in ['confirmed']"
                                />
                            </group>
                        </group>
                        <group string='PrintNode Tutorial' invisible="api_key != False">
                            <ul>
                                <li>
                                    <b>
                                        Go to
                                        <a
                                            href='https://app.printnode.com/app/apikeys'
                                            target='_blank'
                                        >PrintNode
                                            Website
                                        </a>
                                        to generate API Key.
                                    </b>
                                </li>
                            </ul>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>


        <record id="view_printnode_config_list" model="ir.ui.view">
            <field name="name">printnode.config.list</field>
            <field name="model">printnode.config</field>
            <field name="arch" type="xml">
                <list string="PrintNode Account Configration">
                    <field name="name" />
                    <field name="api_key" />
                </list>
            </field>
        </record>

        <record id="action_printnode_config" model="ir.actions.act_window">
            <field name="name">Account Configration</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">printnode.config</field>
            <field name="view_mode">list,form</field>
        </record>

        <menuitem id="menu_printnode_config" name="PrintNode" />


          <menuitem
            id="menu_action_printnode_config"
            groups="tus_printnode.printnode_group_manager"
            name="Accounts Configration"
            parent="menu_printnode_config"
            sequence="10"
            action="action_printnode_config"
          />

        <menuitem
            action="base.action_res_users"
            id="menu_action_res_users_inherit"
            parent="menu_printnode_config"
            groups="tus_printnode.printnode_group_manager"
            sequence="100"
        />

    </data>
</odoo>
