<?xml version="1.0" ?>
<odoo>

    <record id="act_report_xml_view" model="ir.ui.view">
        <field name="name">ir.actions.report.form</field>
        <field name="model">ir.actions.report</field>
        <field name="inherit_id" ref="base.act_report_xml_view" />
        <field name="arch" type="xml">
            <xpath expr="//page[@name='security']" position="before">
                <page string="PrintNode" name="PrintNode">
                    <group>
                        <field name="is_color_printer" options="{'no_create': True}" />
                    </group>
                    <separator string="Printing actions per user" />
                    <field name="printing_action_ids">
                        <list string="Printing Action UserWise" editable="bottom">
                            <field
                                name="user_id"
                                required="1"
                                options="{'no_create': True}"
                            />
                            <field name="print_action_type" required="1" />
                            <field
                                name="node_printer_id"
                                options="{'no_create': True}"
                                required="1"
                            />
                            <field
                                name="printnode_paper_id"
                                options="{'no_create': True}"
                            />
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

    <menuitem
        id="menu_action_base_report"
        parent="menu_printnode_config"
        sequence="30"
        groups="tus_printnode.printnode_group_manager"
        action="base.ir_action_report"
    />
</odoo>
