<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data>
        <record id="view_node_printer_form" model="ir.ui.view">
            <field name="name">node.printer.form</field>
            <field name="model">node.printer</field>
            <field name="arch" type="xml">
                <form string="PrintNode System">
                    <sheet>
                        <widget
                            name="web_ribbon"
                            title="Offline"
                            bg_color="bg-danger"
                            invisible="is_online == True"
                        />
                        <widget
                            name="web_ribbon"
                            title="Online"
                            bg_color="bg-success"
                            invisible="is_online == True"
                        />
                        <div class="oe_button_box">
                            <button
                                name="open_role_from_printer"
                                class="oe_stat_button"
                                style="margin-right: 11rem !important;"
                                icon="fa-print"
                                type="object"
                                string="Roles"
                            />
                        </div>
                        <div class="oe_title">
                            <label
                                class="oe_edit_only"
                                for="name"
                                string="System Name"
                            />
                            <h1>
                                <field name="name" placeholder="System Name" />
                            </h1>
                            <div name="options">
                                <div>
                                    <field name="default" />
                                    <label for="default" />
                                </div>
                                <div>
                                    <field name="is_color_printer" />
                                    <label for="is_color_printer" />
                                </div>
                                <div>
                                    <field name="is_online" />
                                    <label for="is_online" />
                                </div>
                            </div>
                        </div>
                        <group string="Information">
                            <group>
                                <field name="description" />
                                <field name="printnode_id" />
                            </group>
                            <group>
                                <field name="state" />
                                <field name="system_id" />
                                <field name="config_id" />
                            </group>
                        </group>
                        <group string="Papers">
                            <field
                                name="paper_ids"
                                widget="many2many_tags"
                                nolabel="1"
                            />
                        </group>

                    </sheet>

                </form>
            </field>
        </record>
        <record id="view_node_printer_list" model="ir.ui.view">
            <field name="name">node.printer.list</field>
            <field name="model">node.printer</field>
            <field name="arch" type="xml">
                <list
                    string="PrintNode System"
                    decoration-danger="not is_online or state == 'deleted'"
                    decoration-success="is_online"
                >
                    <field name="name" />
                    <field name="system_id" />
                    <field name="default" />
                    <field name="is_color_printer" />
                    <field name="printnode_id" />
                    <field name="config_id" />
                    <field name="is_online" invisible="1" />
                    <field name="state" invisible="1" />
                </list>
            </field>
        </record>
        <record id="action_node_printer" model="ir.actions.act_window">
            <field name="name">Printers</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">node.printer</field>
            <field name="view_mode">list,form</field>
            <field name="context" />
            <field name="help" type="html">
                <p class="oe_view_nocontent_create">
                    You can import all available Printers from the PrintNode Instance
                </p>
            </field>
        </record>


        <record id="view_printnode_role_form" model="ir.ui.view">
            <field name="name">printnode.role.form</field>
            <field name="model">printnode.role</field>
            <field name="arch" type="xml">
                <form string="Printed Document Details">
                    <header>
                        <field
                            name="state"
                            widget="statusbar"
                            statusbar_visible="new,in_progress,done,error"
                            readonly="1"
                        />
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <label class="oe_edit_only" for="name" string="Role Name" />
                            <h1>
                                <field name="name" placeholder="Role Name" />
                            </h1>
                        </div>
                        <group string="Information">
                            <group>
                                <field name="node_printer_id" />
                                <field name="printnode_id" />
                            </group>
                            <group>
                                <field name="created_at" />
                                <field name="printnode_state" invisible="1" />
                            </group>
                        </group>
                        <group string="Message">
                            <field name="message" nolabel="1" />
                        </group>
                        <notebook>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>
        <record id="view_printnode_role_list" model="ir.ui.view">
            <field name="name">printnode.role.list</field>
            <field name="model">printnode.role</field>
            <field name="arch" type="xml">
                <list
                    string="Printed Document Details"
                    decoration-danger="state == 'error'"
                    decoration-success="state == 'done'"
                    decoration-muted="state in ['deleted', 'expired', 'disappeared']"
                    create="false"
                    edit="false"
                >
                    <field name="name" />
                    <field name="created_at" />
                    <field name="node_printer_id" />
                    <field name="printnode_id" />
                    <field name="state" />
                    <field name="printnode_state" invisible="1" />
                </list>
            </field>
        </record>

        <record id="action_printnode_role" model="ir.actions.act_window">
            <field name="name">Printed Document Details</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">printnode.role</field>
            <field name="view_mode">list,form</field>
            <field name="context" />
            <field name="help" type="html">
                <p class="oe_view_nocontent_create">
                    When you print any documents it's appear here.
                </p>
            </field>
        </record>

        <menuitem
            name="Printed Document Details"
            parent="menu_printnode_config"
            action="action_printnode_role"
            id="menu_action_printnode_role"
            groups="tus_printnode.printnode_group_user"
            sequence="12"
        />
        <menuitem
            name="Printers"
            parent="menu_printnode_config"
            action="action_node_printer"
            id="menu_action_printnode_printer"
            groups="tus_printnode.printnode_group_manager"
            sequence="30"
        />

    </data>
</odoo>
