<?xml version="1.0" ?>
<odoo>
    <data noupdate="1">

        <!-- PrintNode Access Categories -->
<!--        <record model="ir.module.category" id="printnode_module_category">-->
        <record model="res.groups.privilege" id="printnode_module_category">
            <field name="name">PrintNode</field>
            <field name="description">PrintNode User Access Right</field>
            <field name="sequence">100</field>
        </record>

        <record id="printnode_group_user" model="res.groups">
            <field name="name">User</field>
<!--            <field name="category_id" ref="printnode_module_category" />-->
            <field name="privilege_id" ref="printnode_module_category" />
        </record>

        <record id="printnode_group_manager" model="res.groups">
            <field name="name">Manager</field>
            <field name="implied_ids" eval="[(4, ref('printnode_group_user'))]" />
            <field name="privilege_id" ref="printnode_module_category" />
<!--            <field name="category_id" ref="printnode_module_category" />-->
        </record>
    </data>

    <data>
        <record id="base.group_user" model="res.groups">
            <field name="implied_ids" eval="[(4, ref('printnode_group_user'))]" />
        </record>

        <record id="base.group_erp_manager" model="res.groups">
            <field name="implied_ids" eval="[(4, ref('printnode_group_manager'))]" />
        </record>
    </data>
</odoo>
