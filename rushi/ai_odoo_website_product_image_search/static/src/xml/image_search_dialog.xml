<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="ai_odoo_website_product_image_search.ImageSearchDialog">
        <Dialog title="'Upload Image for Search'" size="'md'">
            <div class="image-search-dialog p-4 text-center">
                <div t-att-class="'drop-zone ' + (state.dragging ? 'dragover' : '')"
                     t-on-dragover.prevent="() => state.dragging = true"
                     t-on-dragleave.prevent="() => state.dragging = false"
                     t-on-drop.prevent="handleDrop">
                    <label for="fileInput" class="upload-label">
                        <t t-if="!state.previewData">
                            <i class="fa fa-image fa-3x mb-2"/>
                            <p class="fw-bold">Drag an image here<br/>or
                                <span class="text-primary">Upload a File</span></p>
                        </t>
                        <t t-if="state.previewData">
                            <img t-att-src="state.previewData" class="preview-img"/>
                        </t>
                    </label>
                    <input type="file" id="fileInput" accept="image/*" class="d-none"
                           t-on-change="handleFileChange"/>
                </div>
            </div>
            <t t-set-slot="footer">
                <div class="d-flex justify-content-end w-100">
                    <button class="btn btn-primary tus-image-search" t-on-click="handleSearch"  t-att-disabled="!state.imageFile">
                        Search
                    </button>
                </div>
            </t>
        </Dialog>
    </t>
</templates>
