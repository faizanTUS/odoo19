<odoo>
    <record id="form_view_res_config_settings" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="website_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//setting[@id='hide_add_to_cart_setting']" position="after">
                <setting id="product_image_search" help="Enable or disable the product image search feature on the website.">
                    <field name="product_image_search_enabled"/>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>