<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <t t-name="tus_quickchat.ListRenderer.RecordRow"
        t-inherit="web.ListRenderer.RecordRow"
        t-inherit-mode="extension">
        <xpath expr="//t[contains(@t-set, 'hasX2ManyAction')]" position="after">
            <t t-if="'message_ids' in this.fields">
                <td class="o_data_cell cursor-pointer o_wa_meta_discuss"
                    t-on-click="(ev) => this.onDiscussCellClicked(record, ev)">
                    <span>
                        <i class="fa fa-lg fa-comments" />
                    </span>
                </td>
            </t>
        </xpath>
    </t>

    <t t-name="tus_quickchat.FormViewDialog"
        t-inherit="web.FormViewDialog"
        t-inherit-mode="extension">
        <xpath expr="//Dialog" position="attributes">
            <attribute name="contentClass">props.contentClass</attribute>
        </xpath>
    </t>
</odoo>
