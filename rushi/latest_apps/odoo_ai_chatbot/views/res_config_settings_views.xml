<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data>
        <record id="res_config_settings_view_form" model="ir.ui.view">
            <field name="name">res.config.settings.view.form.inherit.chatbot</field>
            <field name="model">res.config.settings</field>
            <field name="priority" eval="40" />
            <field name="inherit_id" ref="base.res_config_settings_view_form" />
            <field name="arch" type="xml">
                <xpath expr="//form" position="inside">
                    <app
                        data-string="Odoo AI ChatBot"
                        string="Odoo AI ChatBot"
                        name="Chatbot"
                        logo="/odoo_ai_chatbot/static/description/icon.png"
                    >
                        <block title="AI Model" name="Chatbot">
                            <setting
                                string="Open AI"
                                help="Add Api key From Open AI"
                                invisible="is_gemini"
                            >
                                <field name="is_open_ai" />
                                <div class="content-group" invisible="not is_open_ai">
                                    <div class="mt16">
                                        <div>
                                            <label
                                                for="open_ai_api_key"
                                                string="Open AI Api Key"
                                                class="col-2 o_light_label"
                                            />
                                            <field
                                                name="open_ai_api_key"
                                                password="True"
                                            />
                                        </div>
                                    </div>
                                </div>
                            </setting>
                            <setting
                                string="Gemini"
                                help="Add Api key From Gemini AI"
                                invisible="is_open_ai"
                            >
                                <field name="is_gemini" />
                                <div class="content-group" invisible="not is_gemini">
                                    <div class="mt16">
                                        <div>
                                            <label
                                                for="gemini_api_key"
                                                string="Gemini Api Key"
                                                class="col-2 o_light_label"
                                            />
                                            <field
                                                name="gemini_api_key"
                                                password="True"
                                            />
                                        </div>
                                    </div>
                                </div>
                            </setting>
                        </block>
                    </app>
                </xpath>
            </field>
        </record>
    </data>
</odoo>