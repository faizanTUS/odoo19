<odoo>
    <record id="view_repair_order_export_wizard_form" model="ir.ui.view">
        <field name="name">export.repairs.order.wizard.form</field>
        <field name="model">export.repairs.order.wizard</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div>
                        <h1>Export Repair order</h1>
                    </div>
                    <div>
                        <label for="zip_password" string="Zip Password"/>
                        <field name="zip_password" password="True"/>
                    </div>
                    <field name="repair_ids" nolabel="1">
                        <list>
                            <field name="name"/>
                            <field name="schedule_date"/>
                            <field name="product_id"/>
                            <field name="parts_availability"/>
                            <field name="partner_id"/>
                            <field name="sale_order_id"/>
                            <field name="company_id"/>
                            <field name="state"/>
                        </list>
                    </field>
                </sheet>
                <footer>
                    <button string="Export Repair Orders Zip" type="object" name="action_export" class="oe_highlight"/>
                    <button string="Cancel" class="oe_link" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
