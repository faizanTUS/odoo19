<odoo>
  <record id="ir_actions_server_po_open_wizard" model="ir.actions.server">
    <field name="name">Cancel/Reverse/Reset</field>
    <field name="model_id" ref="purchase.model_purchase_order"/>
    <field name="binding_model_id" ref="purchase.model_purchase_order"/>
    <field name="state">code</field>
    <field name="code">action = env['tus.cancel.reset.wizard'].with_context(active_ids=records.ids, active_model='purchase.order').create({}).action_open_wizard()</field>
  </record>
</odoo>
