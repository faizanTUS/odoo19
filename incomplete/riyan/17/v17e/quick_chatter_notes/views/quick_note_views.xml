<odoo>
    <record id="view_quick_chatter_note_tree" model="ir.ui.view">
        <field name="name">quick.chatter.note.tree</field>
        <field name="model">quick.chatter.note</field>
        <field name="arch" type="xml">
            <tree>
                <field name="sequence"/>
                <field name="name"/>
                <field name="global_note"/>
                <field name="user_id"/>
            </tree>
        </field>
    </record>

    <record id="view_quick_chatter_note_form" model="ir.ui.view">
        <field name="name">quick.chatter.note.form</field>
        <field name="model">quick.chatter.note</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="content"/>
                        <field name="global_note"/>
                        <field name="user_id"
                               invisible="global_note == True"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_quick_chatter_notes" model="ir.actions.act_window">
        <field name="name">Quick Chatter Notes</field>
        <field name="res_model">quick.chatter.note</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
