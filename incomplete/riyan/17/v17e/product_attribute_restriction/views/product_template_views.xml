<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- For users WITHOUT Manage Product Attributes: hide "New" and "Open" in the Attribute selector -->
    <record id="product_template_form_attribute_restrict_select" model="ir.ui.view">
        <field name="name">product.template.form.attribute.restrict.select</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="priority">15</field>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='attribute_line_ids']//field[@name='attribute_id']" position="attributes">
                <attribute name="options">{'no_create': True, 'no_open': True}</attribute>
            </xpath>
        </field>
    </record>

    <!-- For users WITH Manage Product Attributes: allow "New" and "Open" in the Attribute selector -->
    <record id="product_template_form_attribute_allow_manage" model="ir.ui.view">
        <field name="name">product.template.form.attribute.allow.manage</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="priority">25</field>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='attribute_line_ids']//field[@name='attribute_id']" position="attributes" groups="product_attribute_restriction.group_product_attribute_manager">
                <attribute name="options">{'no_create': False, 'no_open': False}</attribute>
            </xpath>
        </field>
    </record>
</odoo>
