<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="stock_card_template">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">

                <div class="page">
                    <h2 style="text-align:center; margin-bottom: 20px;">
                        Stock Card Report
                    </h2>

                    <table class="table table-sm">
                        <tr>
                            <td><strong>Warehouse</strong></td>
                            <td><t t-esc="data['header']['warehouse']"/></td>
                            <td><strong>Location</strong></td>
                            <td><t t-esc="data['header']['location']"/></td>
                        </tr>
                        <tr>
                            <td><strong>From</strong></td>
                            <td><t t-esc="data['header']['date_from']"/></td>
                            <td><strong>To</strong></td>
                            <td><t t-esc="data['header']['date_to']"/></td>
                        </tr>
                        <tr>
                            <td><strong>Generated By</strong></td>
                            <td colspan="3">
                                <t t-esc="data['header']['generated_by']"/>
                            </td>
                        </tr>
                    </table>

                    <t t-foreach="data['groups']" t-as="g">
                        <h4 style="margin-top:18px;">
                            <t t-esc="g['title']"/>
                        </h4>

                        <table class="table table-sm table-bordered">
                            <thead>
                                <tr>
                                    <t t-if="data['group_by'] != 'product'">
                                        <th><strong>Product</strong></th>
                                    </t>
                                    <th><strong>Date</strong></th>
                                    <th><strong>Origin</strong></th>
                                    <th class="text-end"><strong>In Qty</strong></th>
                                    <th class="text-end"><strong>Out Qty</strong></th>
                                    <th class="text-end"><strong>Balance</strong></th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="g['lines']" t-as="l">
                                    <tr>
                                        <t t-if="data['group_by'] != 'product'">
                                            <td>
                                                <t t-esc="l['product']"/>
                                            </td>
                                        </t>
                                        <td><t t-esc="l['date']"/></td>
                                        <td><t t-esc="l['origin'] or ''"/></td>
                                        <td class="text-end"><t t-esc="l['in_qty']"/></td>
                                        <td class="text-end"><t t-esc="l['out_qty']"/></td>
                                        <td class="text-end"><t t-esc="l['balance']"/></td>
                                    </tr>
                                </t>
                                <tr>
                                    <t t-if="data['group_by'] != 'product'">
                                        <td colspan="3" class="text-end"><strong>Total</strong></td>
                                    </t>
                                    <t t-else="">
                                        <td colspan="2" class="text-end"><strong>Total</strong></td>
                                    </t>
                                    <td class="text-end">
                                        <strong><t t-esc="g['totals']['in_qty']"/></strong>
                                    </td>
                                    <td class="text-end">
                                        <strong><t t-esc="g['totals']['out_qty']"/></strong>
                                    </td>
                                    <td/>
                                </tr>
                            </tbody>
                        </table>
                    </t>
                </div>

            </t>
        </t>
    </template>
</odoo>
