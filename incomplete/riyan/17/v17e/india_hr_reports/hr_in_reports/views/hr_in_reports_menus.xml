<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Odoo 19: HR app menus live in hr/views/hr_views.xml.
         Top app root is hr.menu_hr_root (xml id menu_hr_root).
         Built-in "Reporting" submenu is hr.hr_menu_hr_reports — use it for report-style entries. -->
    <menuitem
        id="menu_hr_in_reports_root"
        name="HR Reports"
        parent="hr.hr_menu_hr_reports"
        sequence="20"
        groups="india_hr_reports.group_hr_in_reports_user"/>

    <menuitem
        id="menu_hr_in_reports_cockpit"
        name="HR Cockpit"
        parent="menu_hr_in_reports_root"
        action="action_hr_in_reports_cockpit"
        sequence="5"
        groups="india_hr_reports.group_hr_in_reports_user"/>

    <menuitem id="menu_hr_in_reports_hub" name="Core HR" parent="menu_hr_in_reports_root" sequence="10"/>
    <menuitem
        id="menu_hr_in_report_headcount"
        name="Headcount &amp; movement"
        parent="menu_hr_in_reports_hub"
        action="action_hr_in_report_wizard_hub_headcount"
        sequence="10"/>
    <menuitem
        id="menu_hr_in_report_snapshot"
        name="Employee master snapshot"
        parent="menu_hr_in_reports_hub"
        action="action_hr_in_report_wizard_hub_snapshot"
        sequence="20"/>
</odoo>
