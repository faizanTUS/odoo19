<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hr_in_report_wizard_plan_coverage" model="ir.ui.view">
        <field name="name">hr.in.report.wizard.plan.coverage.form</field>
        <field name="model">hr.in.report.wizard.plan.coverage</field>
        <field name="arch" type="xml">
            <form string="Shift coverage vs demand">
                <group>
                    <group><field name="date_from"/><field name="date_to"/></group>
                    <group>
                        <field name="company_ids" widget="many2many_tags"/>
                        <field name="department_ids" widget="many2many_tags"/>
                        <field name="employee_ids" widget="many2many_tags"/>
                    </group>
                </group>
                <footer>
                    <button name="action_export_xlsx" type="object" string="Export XLSX" class="btn-primary"/>
                    <button name="action_export_pdf" type="object" string="Export PDF"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_hr_in_report_wizard_plan_coverage" model="ir.actions.act_window">
        <field name="name">Shift coverage vs demand</field>
        <field name="res_model">hr.in.report.wizard.plan.coverage</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <record id="view_hr_in_report_wizard_plan_under_over" model="ir.ui.view">
        <field name="name">hr.in.report.wizard.plan.under_over.form</field>
        <field name="model">hr.in.report.wizard.plan.under_over</field>
        <field name="arch" type="xml">
            <form string="Under / over planned hours">
                <group>
                    <group>
                        <field name="date_from"/>
                        <field name="date_to"/>
                        <field name="weekly_capacity_hours"/>
                    </group>
                    <group>
                        <field name="company_ids" widget="many2many_tags"/>
                        <field name="department_ids" widget="many2many_tags"/>
                        <field name="employee_ids" widget="many2many_tags"/>
                    </group>
                </group>
                <footer>
                    <button name="action_export_xlsx" type="object" string="Export XLSX" class="btn-primary"/>
                    <button name="action_export_pdf" type="object" string="Export PDF"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_hr_in_report_wizard_plan_under_over" model="ir.actions.act_window">
        <field name="name">Under / over planned hours</field>
        <field name="res_model">hr.in.report.wizard.plan.under_over</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- Employees → Reporting → HR Reports → Planning -->
    <menuitem id="menu_hr_in_reports_planning" name="Planning" parent="india_hr_reports.menu_hr_in_reports_root" sequence="70"/>
    <menuitem id="menu_plan_coverage" name="Shift coverage vs demand" parent="menu_hr_in_reports_planning" action="action_hr_in_report_wizard_plan_coverage" sequence="10"/>
    <menuitem id="menu_plan_under_over" name="Under / over planned hours" parent="menu_hr_in_reports_planning" action="action_hr_in_report_wizard_plan_under_over" sequence="20"/>

    <!-- Planning app → Reporting (after Planning / Attendance Analysis, sequence 20). -->
    <menuitem
        id="menu_plan_coverage_planning_app"
        name="Shift coverage vs demand"
        parent="planning.planning_menu_reporting"
        action="action_hr_in_report_wizard_plan_coverage"
        sequence="21"
        groups="planning.group_planning_user"/>
    <menuitem
        id="menu_plan_under_over_planning_app"
        name="Under / over planned hours"
        parent="planning.planning_menu_reporting"
        action="action_hr_in_report_wizard_plan_under_over"
        sequence="22"
        groups="planning.group_planning_user"/>
</odoo>
