<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Sale Order Report - Add Multi Discount column -->
    <template id="report_saleorder_document_multi_discount" inherit_id="sale.report_saleorder_document">
        <xpath expr="//th[@name='th_priceunit']" position="after">
            <th name="th_multi_discount" class="text-end text-nowrap" t-if="doc.show_multi_discount_in_pdf" groups="multi_discount_advanced.tus_multi_discount_advanced_group_sale">
                <span>Multi Discount</span>
            </th>
        </xpath>
        <xpath expr="//td[@name='td_product_priceunit']" position="after">
            <td name="td_multi_discount" class="text-end text-nowrap" t-if="doc.show_multi_discount_in_pdf and not line.display_type and line.product_type != 'combo'" groups="multi_discount_advanced.tus_multi_discount_advanced_group_sale">
                <span t-field="line.multi_discount"/>
            </td>
        </xpath>
        <xpath expr="//th[@name='th_discount']" position="after">
            <th name="th_discounted_amount" class="text-end text-nowrap" t-if="doc.show_multi_discount_in_pdf" groups="multi_discount_advanced.tus_multi_discount_advanced_group_sale">
                <span>Discounted Amount</span>
            </th>
        </xpath>
        <xpath expr="//td[@t-if='display_discount']" position="after">
            <td name="td_discounted_amount" class="text-end text-nowrap" t-if="doc.show_multi_discount_in_pdf and not line.display_type and line.product_type != 'combo'" groups="multi_discount_advanced.tus_multi_discount_advanced_group_sale">
                <span t-field="line.discount_amount"/>
            </td>
        </xpath>
    </template>
</odoo>

