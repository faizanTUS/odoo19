<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_inherit_crm_rfq" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.purchase.quotation.from.crm</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="crm.res_config_settings_view_form"/>
        <field name="priority" eval="15"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='crm']" position="inside">
                <block title="Purchase Quotation from CRM" name="purchase_quotation_from_crm" groups="purchase.group_purchase_manager">
                    <setting id="crm_rfq_vendor_action" help="When creating an RFQ from a Lead, choose how to select the vendor by default.">
                        <field name="crm_rfq_vendor_action"/>
                    </setting>
                    <setting id="crm_rfq_prefill_from_lead_products" help="Pre-fill RFQ lines from the lead's requested products (if any).">
                        <field name="crm_rfq_prefill_from_lead_products"/>
                    </setting>
                    <setting id="crm_rfq_copy_expected_revenue" help="Copy the lead's Expected Revenue into the RFQ notes.">
                        <field name="crm_rfq_copy_expected_revenue"/>
                    </setting>
                    <setting id="crm_rfq_required_by_days" help="Default number of days from today for Order Deadline / Expected Arrival (0 = use today).">
                        <field name="crm_rfq_required_by_days"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
