<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="pos_config_view_form_combo_display" model="ir.ui.view">
        <field name="name">pos.config.form.combo.display</field>
        <field name="model">pos.config</field>
        <field name="inherit_id" ref="point_of_sale.pos_config_view_form"/>
        <field name="arch" type="xml">
            <!-- Combo Display: place right below POS name so it's always visible (no dependency on settings block) -->
            <xpath expr="//div[@id='title']" position="after">
                <group string="Combo Display" name="combo_display_group">
                    <field name="combo_display" widget="radio" options="{'horizontal': true}"
                        help="Default display for combo product selection popup in POS (list or grid)."/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
