<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hr_in_report_wizard_in_pf" model="ir.ui.view">
        <field name="name">hr.in.report.wizard.in.pf.form</field>
        <field name="model">hr.in.report.wizard.in.pf</field>
        <field name="arch" type="xml">
            <form string="PF register">
                <group>
                    <group><field name="date_from"/><field name="date_to"/></group>
                    <group>
                        <field name="company_ids" widget="many2many_tags"/>
                        <field name="department_ids" widget="many2many_tags"/>
                        <field name="employee_ids" widget="many2many_tags"/>
                    </group>
                </group>
                <footer>
                    <button name="action_export_xlsx" type="object" string="Export XLSX" class="btn-primary"/>
                    <button name="action_export_pdf" type="object" string="Export PDF"/>
                    <button name="action_export_csv" type="object" string="Export CSV"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_hr_in_report_wizard_in_pf" model="ir.actions.act_window">
        <field name="name">PF contribution register</field>
        <field name="res_model">hr.in.report.wizard.in.pf</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

