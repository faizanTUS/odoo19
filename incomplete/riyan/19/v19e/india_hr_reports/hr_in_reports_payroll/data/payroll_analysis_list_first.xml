<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- HR India Reports menus: open Payslip Lines in list view first (not pivot). -->
    <record id="hr_payroll.hr_payslip_line_action_report" model="ir.actions.act_window">
        <field name="view_mode">list,pivot</field>
    </record>
    <record id="hr_payroll.hr_payslip_line_action_report_view_list" model="ir.actions.act_window.view">
        <field name="sequence" eval="1"/>
    </record>
    <record id="hr_payroll.hr_payslip_line_action_report_view_pivot" model="ir.actions.act_window.view">
        <field name="sequence" eval="2"/>
    </record>
</odoo>
