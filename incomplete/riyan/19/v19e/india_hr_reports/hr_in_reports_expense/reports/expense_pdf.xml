<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Short template ids: PostgreSQL identifiers are limited to 63 chars
        (report_<module>_<id>). Both views use the shared professional layout (title,
        applied filters, detail, summary) wrapped in web.external_layout so the
        company header follows whichever layout (Light, Boxed, Bold, Striped, Bubble,
        Wave, Folder, Standard) is picked in Settings → Companies → Configure Document
        Layout. Declared via <record> (not <template>) so the upgrade explicitly clears
        the legacy inherit_id from when these templates used to extend
        hr_in_reports.hr_in_report_pdf_table; otherwise Odoo keeps the old parent on
        upgrade and the new standalone arch fails to apply.
    -->
    <record id="exp_pdf_cons" model="ir.ui.view">
        <field name="name">exp_pdf_cons</field>
        <field name="type">qweb</field>
        <field name="key">india_hr_reports.exp_pdf_cons</field>
        <field name="mode">primary</field>
        <field name="inherit_id" eval="False"/>
        <field name="arch" type="xml">
            <t t-name="india_hr_reports.exp_pdf_cons">
                <t t-call="web.html_container">
                    <t t-foreach="docs" t-as="doc">
                        <t t-set="company" t-value="doc.company_ids[:1] or env.company"/>
                        <t t-set="o" t-value="doc"/>
                        <t t-call="web.external_layout">
                            <t t-call="india_hr_reports.hr_in_report_pdf_professional_body"/>
                        </t>
                    </t>
                </t>
            </t>
        </field>
    </record>
    <record id="exp_pdf_prod" model="ir.ui.view">
        <field name="name">exp_pdf_prod</field>
        <field name="type">qweb</field>
        <field name="key">india_hr_reports.exp_pdf_prod</field>
        <field name="mode">primary</field>
        <field name="inherit_id" eval="False"/>
        <field name="arch" type="xml">
            <t t-name="india_hr_reports.exp_pdf_prod">
                <t t-call="web.html_container">
                    <t t-foreach="docs" t-as="doc">
                        <t t-set="company" t-value="doc.company_ids[:1] or env.company"/>
                        <t t-set="o" t-value="doc"/>
                        <t t-call="web.external_layout">
                            <t t-call="india_hr_reports.hr_in_report_pdf_professional_body"/>
                        </t>
                    </t>
                </t>
            </t>
        </field>
    </record>

    <record id="action_report_exp_consolidated" model="ir.actions.report">
        <field name="name">Consolidated claims (PDF)</field>
        <field name="model">hr.in.report.wizard.exp.consolidated</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">india_hr_reports.exp_pdf_cons</field>
        <field name="paperformat_id" ref="india_hr_reports.paperformat_hr_in_reports"/>
    </record>
    <record id="action_report_exp_product_analytic" model="ir.actions.report">
        <field name="name">Claims by product (PDF)</field>
        <field name="model">hr.in.report.wizard.exp.product_analytic</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">india_hr_reports.exp_pdf_prod</field>
        <field name="paperformat_id" ref="india_hr_reports.paperformat_hr_in_reports"/>
    </record>
</odoo>
