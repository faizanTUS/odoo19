<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hr_in_report_wizard_pay_register" model="ir.ui.view">
        <field name="name">hr.in.report.wizard.pay.register.form</field>
        <field name="model">hr.in.report.wizard.pay.register</field>
        <field name="arch" type="xml">
            <form string="Payroll register">
                <group>
                    <group><field name="date_from"/><field name="date_to"/></group>
                    <group>
                        <field name="company_ids" widget="many2many_tags"/>
                        <field name="department_ids" widget="many2many_tags"/>
                        <field name="employee_ids" widget="many2many_tags"/>
                    </group>
                </group>
                <footer>
                    <button name="action_export_xlsx" type="object" string="Export XLSX" class="btn-primary"/>
                    <button name="action_export_pdf" type="object" string="Export PDF"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_hr_in_report_wizard_pay_register" model="ir.actions.act_window">
        <field name="name">Payroll register</field>
        <field name="res_model">hr.in.report.wizard.pay.register</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <record id="view_hr_in_report_wizard_pay_bank" model="ir.ui.view">
        <field name="name">hr.in.report.wizard.pay.bank.form</field>
        <field name="model">hr.in.report.wizard.pay.bank</field>
        <field name="arch" type="xml">
            <form string="Bank net pay advice">
                <group>
                    <group><field name="date_from"/><field name="date_to"/></group>
                    <group>
                        <field name="company_ids" widget="many2many_tags"/>
                        <field name="department_ids" widget="many2many_tags"/>
                        <field name="employee_ids" widget="many2many_tags"/>
                    </group>
                </group>
                <footer>
                    <button name="action_export_xlsx" type="object" string="Export XLSX" class="btn-primary"/>
                    <button name="action_export_pdf" type="object" string="Export PDF"/>
                    <button name="action_export_csv" type="object" string="Export CSV"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_hr_in_report_wizard_pay_bank" model="ir.actions.act_window">
        <field name="name">Bank net pay advice</field>
        <field name="res_model">hr.in.report.wizard.pay.bank</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- Employees → Reporting → Payroll reports -->
    <menuitem
        id="menu_hr_in_reports_payroll"
        name="Payroll reports"
        parent="hr.hr_menu_hr_reports"
        groups="india_hr_reports.group_hr_in_reports_user,hr_payroll.group_hr_payroll_user,base.group_system"
        sequence="22"/>
    <menuitem id="menu_pay_register" name="Payroll register" parent="menu_hr_in_reports_payroll" action="action_hr_in_report_wizard_pay_register" sequence="10"/>
    <menuitem id="menu_pay_bank" name="Bank net pay advice" parent="menu_hr_in_reports_payroll" action="action_hr_in_report_wizard_pay_bank" sequence="20"/>

    <!-- Payroll app → Reporting (separate app; not a duplicate in Employees → Reporting). -->
    <menuitem
        id="menu_pay_register_native"
        name="Payroll register"
        parent="hr_payroll.menu_hr_payroll_report"
        action="action_hr_in_report_wizard_pay_register"
        groups="hr_payroll.group_hr_payroll_user"
        sequence="16"/>
    <menuitem
        id="menu_pay_bank_native"
        name="Bank net pay advice"
        parent="hr_payroll.menu_hr_payroll_report"
        action="action_hr_in_report_wizard_pay_bank"
        groups="hr_payroll.group_hr_payroll_user"
        sequence="17"/>
</odoo>
