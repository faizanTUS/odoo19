<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="PartnerDetailsEdit" t-inherit="point_of_sale.PartnerDetailsEdit" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('partner-details-box')]//div[hasclass('partner-details-left')]" position="inside">
            <div class="partner-detail">
                <span class="label">Referral Code</span>
                <input class="detail" name="referral_by_code" id="referral_by_code" t-model="changes.referral_by_code"
                       placeholder="Referral Code"/>
            </div>
        </xpath>
    </t>
</templates>
