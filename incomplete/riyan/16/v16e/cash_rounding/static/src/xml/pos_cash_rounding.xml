<?xml version="1.0" encoding="utf-8"?>
<templates id="template" xml:space="preserve">

    <t t-name="PaymentScreen" t-inherit="point_of_sale.PaymentScreen" t-inherit-mode="extension" owl="1">
        <xpath expr="//div[hasclass('js_invoice')]" position="after">
            <t t-if="env.pos.config.cash_rounding">
                <div class="cash-visible" t-if="env.pos.cash_rounding_list.length > 1">
                    <t t-foreach="env.pos.cash_rounding_list" t-as="cash_rounding" t-key="cash_rounding.id">
                        <div class="button cash_rounding_list cash-visible cash_rounding_all"
                             style="text-align: center;font-size: large;"
                            t-on-click="on_click_cash_rounding"
                            t-att-data-rounding_id='cash_rounding.id'>
                            <t t-esc="cash_rounding_val()"/>
                        </div>
                    </t>
                </div>
            </t>
        </xpath>
    </t>
</templates>
