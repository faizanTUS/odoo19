<odoo>
    <record id="action_repair_order_export" model="ir.actions.server">
        <field name="name">Export Repair Order</field>
        <field name="model_id" ref="repair.model_repair_order"/>
        <field name="binding_model_id" ref="repair.model_repair_order"/>
        <field name="state">code</field>
        <field name="groups_id"  eval="[(4, ref('repair_order_report_zip_secure.group_export_repair_order'))]"/>
        <field name="code">
            action = {
            'name': 'Export Repair Order',
            'type': 'ir.actions.act_window',
            'res_model': 'export.repairs.order.wizard',
            'view_mode': 'form',
            'target': 'new',
            'context': {'default_repair_ids': [record.id for record in records]},
            }
        </field>
    </record>
    <record id="repair_order_list_action_view" model="ir.ui.view">
        <field name="name">repair.order.list.view</field>
        <field name="model">repair.order</field>
        <field name="inherit_id" ref="repair.view_repair_order_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//tree" position="inside">
                <header>
                    <button name="%(action_repair_order_export)d" type="action" string="Export Repair Orders"
                            groups="repair_order_report_zip_secure.group_export_repair_order" class="oe_highlight ml4"/>
                </header>
            </xpath>
        </field>
    </record>


</odoo>