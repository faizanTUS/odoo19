<odoo>
    <record id="action_purchase_order_export_zip_pdf" model="ir.actions.server">
        <field name="name">Export Purchase Order</field>
        <field name="model_id" ref="purchase.model_purchase_order"/>
        <field name="binding_model_id" ref="purchase.model_purchase_order"/>
        <field name="state">code</field>
        <field name="groups_id" eval="[(4, ref('purchase_order_report_zip_secure.group_export_purchase_order_pdf'))]"/>
        <field name="code">
            action = {
                'name': 'Export Purchase Order',
                'type': 'ir.actions.act_window',
                'res_model': 'export.purchase.pdf.wizard',
                'view_mode': 'form',
                'target': 'new',
                'context': {'default_purchase_ids': [record.id for record in records],
                             'default_is_purchase': True,
            },
            }
        </field>

    </record>
    <record id="purchase_order_list_view_action" model="ir.ui.view">
        <field name="name">purchase.order.list.view</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="%(action_purchase_order_export_zip_pdf)d" type="action" string="Export Purchase Order" groups="purchase_order_report_zip_secure.group_export_purchase_order_pdf"/>
            </xpath>
        </field>
    </record>

     <record id="action_purchase_order_quotation_export_zip" model="ir.actions.server">
        <field name="name">Export Purchase Quotation</field>
        <field name="model_id" ref="purchase.model_purchase_order"/>
        <field name="binding_model_id" ref="purchase.model_purchase_order"/>
        <field name="state">code</field>
        <field name="groups_id" eval="[(4, ref('purchase_order_report_zip_secure.group_export_purchase_order_pdf'))]"/>
        <field name="code">
            action = {
                'name': 'Export Purchase Quotation',
                'type': 'ir.actions.act_window',
                'res_model': 'export.purchase.pdf.wizard',
                'view_mode': 'form',
                'target': 'new',
                'context': {'default_purchase_ids': [record.id for record in records],
                             'default_is_purchase_rfq': True,
            },
            }
        </field>

    </record>

     <record id="purchase_order_kpis_tree_list_view_action" model="ir.ui.view">
        <field name="name">purchase.order.list.view</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_kpis_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="%(action_purchase_order_quotation_export_zip)d" type="action" string="Export Purchase Quotation" groups="purchase_order_report_zip_secure.group_export_purchase_order_pdf"/>
            </xpath>
        </field>
    </record>
</odoo>