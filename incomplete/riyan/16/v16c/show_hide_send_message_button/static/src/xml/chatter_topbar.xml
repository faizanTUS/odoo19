<?xml version="1.0" encoding="UTF-8" ?>
<templates id="template_ext" xml:space="preserve">
    <t
        t-name="ChatterTopbarExt"
        t-inherit="mail.ChatterTopbar"
        t-inherit-mode="extension"
        owl="1"
    >
        <xpath
            expr="//button[hasclass('o_ChatterTopbar_buttonSendMessage')]"
            position="attributes"
        >
         <attribute name="t-if">chatterTopbar.chatter.isShowSendMessage</attribute>
        </xpath>
    </t>
</templates>
