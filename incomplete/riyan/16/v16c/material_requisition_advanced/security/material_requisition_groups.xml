<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_material_requisition_user" model="res.groups">
        <field name="name">Employee (Material Requisition)</field>
        <field name="category_id" ref="base.module_category_inventory"/>
        <field name="comment">Can create and manage own material requisitions only.</field>
    </record>
    <record id="group_material_requisition_manager" model="res.groups">
        <field name="name">Department Manager (Material Requisition)</field>
        <field name="category_id" ref="base.module_category_inventory"/>
        <field name="comment">Can approve/decline material requisitions of their department.</field>
    </record>
    <record id="group_material_requisition_officer" model="res.groups">
        <field name="name">Requisition Officer</field>
        <field name="category_id" ref="base.module_category_inventory"/>
        <field name="comment">Can approve/reject requisitions, set destination, add vendors, generate pickings and POs.</field>
    </record>
    <record id="rule_material_requisition_employee" model="ir.rule">
        <field name="name">Material Requisition: see own</field>
        <field name="model_id" ref="model_material_requisition"/>
        <field name="domain_force">[('requested_by_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_material_requisition_user'))]"/>
    </record>
    <record id="rule_material_requisition_stock_user" model="ir.rule">
        <field name="name">Material Requisition: Inventory user sees own</field>
        <field name="model_id" ref="model_material_requisition"/>
        <field name="domain_force">[('requested_by_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('stock.group_stock_user'))]"/>
    </record>
    <record id="rule_material_requisition_manager" model="ir.rule">
        <field name="name">Material Requisition: department manager</field>
        <field name="model_id" ref="model_material_requisition"/>
        <field name="domain_force">[('department_id.manager_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_material_requisition_manager'))]"/>
    </record>
    <record id="rule_material_requisition_officer" model="ir.rule">
        <field name="name">Material Requisition: officer see all</field>
        <field name="model_id" ref="model_material_requisition"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_material_requisition_officer'))]"/>
    </record>
</odoo>
