<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="ir_actions_report_view_pdf_template" model="ir.ui.view">
        <field name="name">ir.actions.report.form.pdf.template</field>
        <field name="model">ir.actions.report</field>
        <field name="inherit_id" ref="base.act_report_xml_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='attachment']" position="after">
                <group string="PDF Template" attrs="{'invisible':[('report_type','!=','qweb-pdf')]}">
                    <field name="template_type"
                           attrs="{'invisible':[('report_type','!=','qweb-pdf')]}"
                           options="{'no_create': True}"/>
                    <field name="pdf_template"
                           filename="pdf_template_filename"
                           attrs="{'invisible':[('report_type','!=','qweb-pdf')]}"
                           widget="binary"
                           options="{'accept': '.pdf,.png,.jpg,.jpeg,.gif'}"/>
                    <field name="pdf_template_filename" invisible="1"/>
                    <field name="watermark_width_percent"
                           attrs="{'invisible':[('template_type','!=','watermark')]}"/>

                    <field name="watermark_opacity"
                           attrs="{'invisible':[('template_type','!=','watermark')]}"/>
                     <field name="watermark_position"
                           attrs="{'invisible':[('template_type','!=','watermark')]}"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>

