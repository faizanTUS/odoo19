<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="pay_in_pf_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-set="company" t-value="doc.company_ids[:1] or env.company"/>
                <t t-set="o" t-value="doc"/>
                <t t-call="web.external_layout">
                    <t t-call="india_hr_reports.hr_in_report_pdf_professional_body"/>
                </t>
            </t>
        </t>
    </template>
