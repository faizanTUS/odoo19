<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_project_profitability_list" model="ir.ui.view">
        <field name="name">project.profitability.list</field>
        <field name="model">project.profitability</field>
        <field name="arch" type="xml">
            <list string="Project Profitability" decoration-success="profitability_status == 'excellent'" decoration-info="profitability_status == 'good'" decoration-warning="profitability_status in ('average', 'poor')" decoration-danger="profitability_status == 'loss'">
                <field name="project_id"/>
                <field name="partner_id"/>
                <field name="date"/>
                <field name="revenue_recognized"/>
                <field name="total_cost"/>
                <field name="gross_margin"/>
                <field name="margin_percentage"/>
                <field name="profitability_status"/>
                <field name="budget_status"/>
                <field name="currency_id" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_project_profitability_form" model="ir.ui.view">
        <field name="name">project.profitability.form</field>
        <field name="model">project.profitability</field>
        <field name="arch" type="xml">
            <form string="Project Profitability">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_refresh_calculations" type="object" class="oe_stat_button" icon="fa-refresh">
                            <field name="id" widget="statinfo" string="Refresh"/>
                        </button>
                    </div>
                    <group>
                        <group string="Project Info">
                            <field name="project_id"/>
                            <field name="partner_id"/>
                            <field name="analytic_account_id"/>
                            <field name="sale_order_id"/>
                            <field name="opportunity_id"/>
                            <field name="date"/>
                        </group>
                        <group string="Status">
                            <field name="profitability_status"/>
                            <field name="budget_status"/>
                            <field name="currency_id" invisible="True"/>
                            <field name="company_id" invisible="True"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Revenue" name="revenue">
                            <group>
                                <group>
                                    <field name="lead_value"/>
                                    <field name="so_total"/>
                                    <field name="invoiced_amount"/>
                                    <field name="paid_amount"/>
                                    <field name="revenue_recognized"/>
                                </group>
                            </group>
                        </page>
                        <page string="Costs" name="costs">
                            <group>
                                <group>
                                    <field name="timesheet_cost"/>
                                    <field name="expense_cost"/>
                                    <field name="vendor_bill_cost"/>
                                    <field name="other_cost"/>
                                    <field name="total_cost"/>
                                </group>
                            </group>
                        </page>
                        <page string="Budget" name="budget">
                            <group>
                                <group>
                                    <field name="budget_revenue"/>
                                    <field name="budget_cost"/>
                                    <field name="budget_margin"/>
                                </group>
                                <group string="Variance">
                                    <field name="revenue_variance"/>
                                    <field name="cost_variance"/>
                                    <field name="cost_variance_percentage"/>
                                    <field name="margin_variance"/>
                                </group>
                            </group>
                        </page>
                        <page string="KPIs" name="kpis">
                            <group>
                                <group>
                                    <field name="hours_logged"/>
                                    <field name="hours_budgeted"/>
                                    <field name="billing_rate"/>
                                    <field name="cost_rate"/>
                                </group>
                                <group>
                                    <field name="gross_margin"/>
                                    <field name="margin_percentage"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_project_profitability_pivot" model="ir.ui.view">
        <field name="name">project.profitability.pivot</field>
        <field name="model">project.profitability</field>
        <field name="arch" type="xml">
            <pivot string="Project Profitability">
                <field name="project_id" type="row"/>
                <field name="date" type="col"/>
                <field name="revenue_recognized" type="measure"/>
                <field name="total_cost" type="measure"/>
                <field name="gross_margin" type="measure"/>
                <field name="margin_percentage" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_project_profitability_graph" model="ir.ui.view">
        <field name="name">project.profitability.graph</field>
        <field name="model">project.profitability</field>
        <field name="arch" type="xml">
            <graph string="Project Profitability" type="bar">
                <field name="project_id"/>
                <field name="revenue_recognized" type="measure"/>
                <field name="total_cost" type="measure"/>
                <field name="gross_margin" type="measure"/>
            </graph>
        </field>
    </record>

</odoo>
