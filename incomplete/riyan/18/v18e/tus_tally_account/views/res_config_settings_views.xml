<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.account.accountant</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">            
            <block id="bank_cash" position="inside">
                <div class="col-12 col-lg-6 o_setting_box" groups="base.group_no_one">
                    <div class="o_setting_left_pane">
                        <field name="use_anglo_saxen_according_to_tally"/>
                    </div>
                    <div class="o_setting_right_pane">
                        <label for="use_anglo_saxen_according_to_tally"/>
                        <span class="fa fa-lg fa-building-o" title="Values set here are company-specific." role="img" aria-label="Values set here are company-specific." groups="base.group_multi_company"/>
                        <div class="text-muted">
                            Record cost of goods sold in your journal entries according to tally
                        </div>
                    </div>
                </div>
            </block>
        </field>
    </record>
    
    <record id="view_account_form_extended" model="ir.ui.view">
        <field name="name">view.account.form.extended</field>
        <field name="model">account.account</field>
        <field name="inherit_id" ref="account.view_account_form"/>
        <field name="arch" type="xml">
        	<field name="deprecated" position='after'>
        		<field name='anglo_saxon_accounting_according_to_tally' invisible="True"/>
        		<field name="tally_wise_reporting"/>
        	</field>
        </field>
    </record>       
    
</odoo>
