<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hr_in_report_wizard_hub_headcount" model="ir.ui.view">
        <field name="name">hr.in.report.wizard.hub.headcount.form</field>
        <field name="model">hr.in.report.wizard.hub.headcount</field>
        <field name="arch" type="xml">
            <form string="Headcount &amp; movement">
                <group>
                    <group>
                        <field name="date_from"/>
                        <field name="date_to"/>
                        <field name="include_movement_lines"/>
                    </group>
                    <group>
                        <field name="company_ids" widget="many2many_tags"/>
                        <field name="department_ids" widget="many2many_tags"/>
                        <field name="employee_ids" widget="many2many_tags"/>
                    </group>
                </group>
                <footer>
                    <button name="action_export_xlsx" type="object" string="Export XLSX" class="btn-primary"/>
                    <button name="action_export_pdf" type="object" string="Export PDF"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_hr_in_report_wizard_hub_headcount" model="ir.actions.act_window">
        <field name="name">Headcount &amp; movement</field>
        <field name="res_model">hr.in.report.wizard.hub.headcount</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <record id="view_hr_in_report_wizard_hub_snapshot" model="ir.ui.view">
        <field name="name">hr.in.report.wizard.hub.snapshot.form</field>
        <field name="model">hr.in.report.wizard.hub.snapshot</field>
        <field name="arch" type="xml">
            <form string="Employee master snapshot">
                <group>
                    <group>
                        <field name="date_from" invisible="1"/>
                        <field name="date_to"/>
                    </group>
                    <group>
                        <field name="company_ids" widget="many2many_tags"/>
                        <field name="department_ids" widget="many2many_tags"/>
                        <field name="employee_ids" widget="many2many_tags"/>
                    </group>
                </group>
                <footer>
                    <button name="action_export_xlsx" type="object" string="Export XLSX" class="btn-primary"/>
                    <button name="action_export_pdf" type="object" string="Export PDF"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_hr_in_report_wizard_hub_snapshot" model="ir.actions.act_window">
        <field name="name">Employee master snapshot</field>
        <field name="res_model">hr.in.report.wizard.hub.snapshot</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
