<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="pos_combo_advanced.SelectComboProductsPopup">
        <Dialog title="props.product.display_name" contentClass="'select-combo-products-popup'" size="'lg'">
            <div class="mb-3">
                <span class="text-muted">Select combo products and quantities</span>
            </div>
            <t t-if="isOverMax" class="alert alert-warning">
                You cannot add more than <t t-esc="maxComboItems"/> combo item(s) for this combo.
            </t>
            <!-- List view -->
            <div t-if="displayMode === 'list'" class="combo-list border rounded p-2 mb-3">
                <t t-foreach="options" t-as="opt" t-key="opt.product_id">
                    <div class="d-flex align-items-center justify-content-between border-bottom py-2 combo-list-row">
                        <div class="d-flex align-items-center gap-2">
                            <img t-if="opt.product.image_128" t-att-src="opt.product.getImageUrl ? opt.product.getImageUrl() : ''" class="rounded" style="width: 40px; height: 40px; object-fit: cover;"/>
                            <div>
                                <span t-esc="opt.product.display_name"/>
                                <span class="text-muted ms-1">(<t t-esc="opt.min_qty"/> - <t t-esc="opt.max_qty"/>)</span>
                            </div>
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            <button type="button" class="btn btn-sm btn-outline-secondary" t-on-click="() => this.decrement(opt.product_id)">−</button>
                            <span class="qty-value" t-esc="getOptionQty(opt.product_id)"/>
                            <button type="button" class="btn btn-sm btn-outline-secondary" t-on-click="() => this.increment(opt.product_id)">+</button>
                            <span class="ms-2 text-muted" t-esc="env.utils.formatCurrency((opt.product.lst_price || 0) * getOptionQty(opt.product_id))"/>
                        </div>
                    </div>
                </t>
            </div>
            <!-- Grid view -->
            <div t-if="displayMode === 'grid'" class="combo-grid row g-2 mb-3">
                <t t-foreach="options" t-as="opt" t-key="opt.product_id">
                    <div class="col-6 col-md-4">
                        <div class="card h-100 combo-grid-card">
                            <img t-if="opt.product.image_128" t-att-src="opt.product.getImageUrl ? opt.product.getImageUrl() : ''" class="card-img-top" style="height: 80px; object-fit: cover;"/>
                            <div class="card-body p-2">
                                <div class="small text-truncate" t-esc="opt.product.display_name"/>
                                <div class="d-flex align-items-center justify-content-between mt-1">
                                    <div class="btn-group btn-group-sm">
                                        <button type="button" class="btn btn-outline-secondary" t-on-click="() => this.decrement(opt.product_id)">−</button>
                                        <span class="btn btn-outline-secondary disabled" t-esc="getOptionQty(opt.product_id)"/>
                                        <button type="button" class="btn btn-outline-secondary" t-on-click="() => this.increment(opt.product_id)">+</button>
                                    </div>
                                    <span class="small text-muted" t-esc="env.utils.formatCurrency(opt.product.lst_price || 0)"/>
                                </div>
                            </div>
                        </div>
                    </div>
                </t>
            </div>
            <div class="d-flex justify-content-between align-items-center">
                <span><strong>Total:</strong> <t t-esc="env.utils.formatCurrency(totalAmount)"/></span>
            </div>
            <t t-set-slot="footer">
                <div class="d-flex w-100 justify-content-between">
                    <button class="btn btn-secondary" t-on-click="cancel">Cancel</button>
                    <button class="btn btn-primary" t-att-disabled="!canConfirm" t-on-click="confirm">Confirm</button>
                </div>
            </t>
        </Dialog>
    </t>

