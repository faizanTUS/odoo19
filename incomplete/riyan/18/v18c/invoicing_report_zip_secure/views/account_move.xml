<odoo>
    <record id="action_invoice_export_zip" model="ir.actions.server">
        <field name="name">Export Customer Invoice</field>
        <field name="model_id" ref="account.model_account_move"/>
        <field name="binding_model_id" ref="account.model_account_move"/>
        <field name="state">code</field>
        <field name="groups_id" eval="[(4, ref('invoicing_report_zip_secure.group_export_invoices'))]"/>
        <field name="code">
            action = {
            'name': 'Export Customer Invoice',
            'type': 'ir.actions.act_window',
            'res_model': 'export.accounting.pdf.wizard',
            'view_mode': 'form',
            'target': 'new',
            'context': {
            'default_invoice_ids': [record.id for record in records],
            'default_move_type': 'out_invoice',
            },
            }
        </field>
    </record>

    <record id="view_invoice_export_button_action" model="ir.ui.view">
        <field name="name">invoice.list.view.export.button</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_out_invoice_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="%(action_invoice_export_zip)d" type="action" string="Export Customer Invoice"
                        groups="invoicing_report_zip_secure.group_export_invoices"/>
            </xpath>
        </field>
    </record>


