<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_task_form_inherit_stage_history" model="ir.ui.view">
        <field name="name">project.task.form.inherit.stage.history</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_form2"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='description_page']" position="after">
                <page name="task_stage_history_page" string="Task Stage History">
                    <field name="stage_history_ids" nolabel="1" readonly="1">
                        <list create="0" delete="0" edit="0" default_order="stage_in desc">
                            <field name="stage_id"/>
                            <field name="stage_in"/>
                            <field name="stage_out"/>
                            <field name="duration_display" string="Duration"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
