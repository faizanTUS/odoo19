<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Task Stage Lifetime / Stage History: list of all transitions -->
    <record id="view_project_task_stage_history_search" model="ir.ui.view">
        <field name="name">project.task.stage.history.search</field>
        <field name="model">project.task.stage.history</field>
        <field name="arch" type="xml">
            <search string="Task Stage Lifetime">
                <field name="task_id"/>
                <field name="stage_id"/>
                <field name="project_id"/>
                <field name="user_id"/>
                <filter string="Current Stage" name="filter_current_stage" domain="[('stage_out', '=', False)]"/>
                <separator/>
                <group expand="0" string="Group By">
                    <filter string="Stage" name="group_stage" context="{'group_by': 'stage_id'}"/>
                    <filter string="Task" name="group_task" context="{'group_by': 'task_id'}"/>
                    <filter string="Project" name="group_project" context="{'group_by': 'project_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_project_task_stage_history_list" model="ir.ui.view">
        <field name="name">project.task.stage.history.list</field>
        <field name="model">project.task.stage.history</field>
        <field name="arch" type="xml">
            <list string="Task Stage Lifetime" create="0" delete="0" edit="0" default_order="stage_in desc">
                <field name="task_id"/>
                <field name="project_id"/>
                <field name="stage_id"/>
                <field name="from_stage_id" string="From Stage"/>
                <field name="stage_in" string="Stage In"/>
                <field name="stage_out" string="Stage Out"/>
                <field name="duration_display" string="Duration"/>
                <field name="user_id"/>
            </list>
        </field>
    </record>

    <!-- Stage History: detailed view with Start/Stop columns (like image 2) -->
    <record id="view_project_task_stage_history_list_full" model="ir.ui.view">
        <field name="name">project.task.stage.history.list.full</field>
        <field name="model">project.task.stage.history</field>
        <field name="arch" type="xml">
            <list string="Stage History" create="0" delete="0" edit="0" default_order="stage_in desc">
                <field name="stage_id"/>
                <field name="from_stage_id" string="From Stage"/>
                <field name="user_id"/>
                <field name="project_id"/>
                <field name="task_id"/>
            </list>
        </field>
    </record>

    <record id="action_project_task_stage_lifetime" model="ir.actions.act_window">
        <field name="name">Task Stage Lifetime</field>
        <field name="res_model">project.task.stage.history</field>
        <field name="view_mode">list</field>
        <field name="search_view_id" ref="view_project_task_stage_history_search"/>
        <field name="context">{'search_default_group_stage': 0}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No stage history yet.
            </p><p>
                Enable "Project Task Stage Duration" or "Project Stage Duration History" in Project settings or in the module configuration, then move tasks between stages to see history here.
            </p>
        </field>
    </record>

    <record id="action_project_stage_history" model="ir.actions.act_window">
        <field name="name">Stage History</field>
        <field name="res_model">project.task.stage.history</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_project_task_stage_history_list_full"/>
        <field name="search_view_id" ref="view_project_task_stage_history_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No stage history yet.
            </p><p>
                Enable stage history in Project or in Settings, then move tasks between stages.
            </p>
        </field>
    </record>
</odoo>
