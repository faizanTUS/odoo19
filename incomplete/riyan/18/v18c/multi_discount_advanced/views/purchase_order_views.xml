<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Purchase Order Line Form - Add Multi Discount field (inside purchase order form) -->
    <record id="view_purchase_order_line_form_multi_discount" model="ir.ui.view">
        <field name="name">purchase.order.form.line.multi.discount</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <!-- Add multi-discount field after discount field in the embedded line form -->
            <xpath expr="//div[@name='reminder']" position="after">
                <field name="show_multi_discount_in_pdf" groups="multi_discount_advanced.tus_multi_discount_advanced_group_purchase"/>
            </xpath>

            <!-- Add multi-discount field after discount field in the embedded line form -->
            <xpath expr="//field[@name='order_line']//form//field[@name='discount']" position="after">
                <field name="multi_discount" groups="multi_discount_advanced.tus_multi_discount_advanced_group_purchase"/>
            </xpath>
        </field>
    </record>

    <!-- Purchase Order Line Tree - Add Multi Discount column (inside purchase order form) -->
    <record id="view_purchase_order_line_tree_multi_discount" model="ir.ui.view">
        <field name="name">purchase.order.form.line.tree.multi.discount</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <!-- Add multi-discount column after price_unit in the embedded line list -->
            <xpath expr="//field[@name='order_line']//list//field[@name='price_unit']" position="after">
                <field name="multi_discount" optional="hide" groups="multi_discount_advanced.tus_multi_discount_advanced_group_purchase"/>
            </xpath>
            <!-- Add discount_amount and discounted_total_amount columns -->
            <xpath expr="//field[@name='order_line']//list//field[@name='discount']" position="after">
                <field name="discount_amount" optional="hide" groups="multi_discount_advanced.tus_multi_discount_advanced_group_purchase"/>
                <field name="discounted_total_amount" optional="hide" groups="multi_discount_advanced.tus_multi_discount_advanced_group_purchase"/>
            </xpath>
        </field>
    </record>
</odoo>

