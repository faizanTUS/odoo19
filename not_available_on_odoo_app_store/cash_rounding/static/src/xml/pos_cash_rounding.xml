<?xml version="1.0" encoding="utf-8"?>
<templates id="template" xml:space="preserve">

    <t t-name="PaymentScreenButtons" t-inherit="point_of_sale.PaymentScreenButtons" t-inherit-mode="extension" owl="1">
        <xpath expr="//button[hasclass('js_invoice')]" position="after">
            <t t-set="cash_rounding_list" t-value="pos.models['account.cash.rounding'].getAll()"/>
            <t t-if="pos.config.cash_rounding">
                <t t-if="cash_rounding_list and cash_rounding_list.length > 1">
                    <t t-foreach="cash_rounding_list" t-as="cash_rounding" t-key="cash_rounding.id">
                        <button class="button cash_rounding_list cash-visible cash_rounding_all btn btn-light py-3 text-start rounded-0 border-bottom"
                                t-on-click="on_click_cash_rounding"
                                t-att-class="{ 'highlight active': this.getSelectedRounding() == cash_rounding.id }"
                                t-att-data-rounding_id='cash_rounding.id'>
                                <t t-esc="cash_rounding_val()"/>
                        </button>
                    </t>
                </t>
            </t>
        </xpath>
    </t>
</templates>
