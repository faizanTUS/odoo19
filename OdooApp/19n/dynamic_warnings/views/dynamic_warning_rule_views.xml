<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dynamic_warning_rule_list" model="ir.ui.view">
        <field name="name">dynamic.warning.rule.list</field>
        <field name="model">dynamic.warning.rule</field>
        <field name="arch" type="xml">
            <list string="Warning Rules" decoration-info="warning_type == 'info'" decoration-warning="warning_type == 'warning'" decoration-danger="warning_type == 'danger'">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="model_id"/>
                <field name="warning_type" widget="badge"/>
                <field name="active"/>
                <field name="group_ids" widget="many2many_tags" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_dynamic_warning_rule_form" model="ir.ui.view">
        <field name="name">dynamic.warning.rule.form</field>
        <field name="model">dynamic.warning.rule</field>
        <field name="arch" type="xml">
            <form string="Warning Rule">
                <sheet>
                    <group>
                        <group>
                            <field name="name" placeholder="e.g. Low Stock Alert"/>
                            <field name="model_id" options="{'no_create': True}"
                                   help="For the main product form (Products menu), choose 'Product Template'. Use 'Product Variant' only for variant-specific forms."/>
                            <field name="warning_type" widget="radio"/>
                            <field name="message" placeholder="e.g. This product has less than 10 units in stock. Please check."/>
                            <field name="group_ids" widget="many2many_tags" options="{'no_create': True}"
                                   placeholder="Leave empty to show to all users"/>
                        </group>
                        <group>
                            <field name="sequence"/>
                            <field name="active"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="date_start"/>
                            <field name="date_end"/>
                        </group>
                    </group>
                    <group string="Conditions" name="conditions_group">
                        <label for="domain" class="o_form_label"/>
                        <div class="w-100">
                            <p class="text-muted mb-1">
                                Define when this alert is shown using a domain. Example: [('qty_available', '&lt;', 10)] or [('phone', '=', False), ('email', '=', False)]
                            </p>
                            <field name="domain" placeholder="[]" nolabel="1" class="oe_inline"/>
                        </div>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
