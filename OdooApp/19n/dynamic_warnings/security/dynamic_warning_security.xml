<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Privilege Category -->
    <record id="res_groups_privilege_dynamic_warning" model="res.groups.privilege">
        <field name="name">Dynamic Warnings</field>
        <field name="sequence">25</field>
    </record>

    <!-- User Group -->
    <record id="group_dynamic_warning_user" model="res.groups">
        <field name="name">User</field>
        <field name="privilege_id" ref="res_groups_privilege_dynamic_warning"/>
        <field name="comment">Can see dynamic warnings on forms.</field>
    </record>

    <!-- Manager Group -->
    <record id="group_dynamic_warning_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="privilege_id" ref="res_groups_privilege_dynamic_warning"/>
        <field name="implied_ids" eval="[(4, ref('group_dynamic_warning_user'))]"/>
        <field name="comment">Can create, edit and delete warning rules.</field>
    </record>

</odoo>