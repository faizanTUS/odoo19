<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_purchase_order_form_restrict_m2o" model="ir.ui.view">
        <field name="name">purchase.order.form.restrict.m2o</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <field name="partner_id" position="replace">
                <field name="partner_id" groups="!many2one_restrict_create_edit.group_restrict_m2o_create_edit_purchase"/>
                <field name="partner_id"
                       groups="many2one_restrict_create_edit.group_restrict_m2o_create_edit_purchase"
                       options="{'no_create': True, 'no_create_edit': True, 'no_open': True}"/>
            </field>

            <field name="user_id" position="replace">
                <field name="user_id" groups="!many2one_restrict_create_edit.group_restrict_m2o_create_edit_purchase"/>
                <field name="user_id"
                       groups="many2one_restrict_create_edit.group_restrict_m2o_create_edit_purchase"
                       options="{'no_create': True, 'no_create_edit': True, 'no_open': True}"/>

            </field>

            <field name="product_id" position="replace">
                <field name="product_id" groups="!many2one_restrict_create_edit.group_restrict_m2o_create_edit_purchase"/>
                <field name="product_id"
                       groups="many2one_restrict_create_edit.group_restrict_m2o_create_edit_purchase"
                       options="{'no_create': True, 'no_create_edit': True, 'no_open': True}"/>
            </field>

        </field>
    </record>
</odoo>