<odoo>
    <record id="view_contact_category_tree" model="ir.ui.view">
        <field name="name">contact.category.tree</field>
        <field name="model">contact.category</field>
        <field name="arch" type="xml">
            <list>
                <field name="display_name"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_contact_category_form" model="ir.ui.view">
        <field name="name">contact.category.form</field>
        <field name="model">contact.category</field>
        <field name="arch" type="xml">
            <form class="oe_form_configuration">
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Category"/>
                        <h1>
                            <field name="name" placeholder="e.g. Lamps"/>
                        </h1>
                    </div>
                    <group name="first" col="2">
                        <field name="parent_id" class="oe_inline"/>
                        <field name="contact_count"/>
                        <field name="active"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="contact_category_action_form" model="ir.actions.act_window">
        <field name="name">Contact Categories</field>
        <field name="res_model">contact.category</field>
        <field name="view_mode">list,form</field>
    </record>
    <menuitem id="menu_contact_category" name="Contact Categories" parent="contacts.res_partner_menu_config"
              action="contact_category_action_form"/>

</odoo>
