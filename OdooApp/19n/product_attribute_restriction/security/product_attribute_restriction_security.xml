<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Category for Product Attribute Restriction (visible in user form) -->
        <record id="module_category_product_attribute_restriction" model="res.groups.privilege">
            <field name="name">Product Attributes</field>
            <field name="sequence">20</field>
        </record>

        <!-- Full access: users with this group can add any product attribute to products -->
        <record id="group_product_attribute_manager" model="res.groups">
            <field name="name">Manage Product Attributes</field>
            <field name="privilege_id" ref="product_attribute_restriction.module_category_product_attribute_restriction"/>
        </record>

        <!-- Administrators always have full attribute access -->
        <record id="base.group_system" model="res.groups">
            <field name="implied_ids" eval="[Command.link(ref('product_attribute_restriction.group_product_attribute_manager'))]"/>
        </record>
    </data>
</odoo>
