<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="mail_template_remittance_advice" model="mail.template">
            <field name="name">Remittance Advice (Vendor Payments)</field>
            <field name="model_id" ref="account.model_account_payment"/>
            <field name="subject">Remittance Advice for {{ object.name or 'n/a' }}</field>
            <field name="partner_to">{{ object.partner_id.id }}</field>
            <field name="description">Sent when sending Remittance Advice by email from Vendor Payment (Send receipt by email)</field>
            <field name="body_html" type="html">
<div style="margin: 0px; padding: 0px;">
    <p style="margin: 0px; padding: 0px; font-size: 13px;">
        Dear <t t-out="object.partner_id.name or ''">Vendor</t>,<br/><br/>
        Please find attached our Remittance Advice for payment <span style="font-weight:bold;" t-out="(object.name or '').replace('/','-') or ''">P/2023/00001</span>
        amounting to <span style="font-weight:bold;" t-out="format_amount(object.amount, object.currency_id) or ''">0.00</span> from <t t-out="object.company_id.name or ''">YourCompany</t>.
        <br/><br/>
        This document details the invoices covered by this payment.
        <br/><br/>
        Do not hesitate to contact us if you have any questions.
        <br/><br/>
        Best regards,
        <t t-if="not is_html_empty(user.signature)">
            <br/><br/>
            <t t-out="user.signature or ''">--<br/>User</t>
        </t>
    </p>
</div>
            </field>
            <field name="report_template_ids" eval="[(4, ref('remittance_advice.action_report_remittance_advice'))]"/>
            <field name="lang">{{ object.partner_id.lang }}</field>
            <field name="auto_delete" eval="True"/>
        </record>
    </data>
</odoo>
