<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_multi_invoice_payment_wizard_form" model="ir.ui.view">
        <field name="name">multi.invoice.payment.wizard.form</field>
        <field name="model">multi.invoice.payment.wizard</field>
        <field name="arch" type="xml">
            <form string="Multi Invoice Payment">
                <sheet>
                    <group>
                        <group>
                            <field name="partner_type"/>
                            <field name="payment_type"/>
                            <field name="partner_id" options="{'no_create': False}"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="journal_id"/>
                            <field name="currency_id" readonly="1"/>
                            <field name="payment_date"/>
                            <field name="memo"/>
                        </group>
                    </group>

                    <separator string="Invoices / Bills"/>

                    <field name="line_ids" context="{'default_currency_id': currency_id}" nolabel="1"
                           options="{'no_create': True}" readonly="0" force_save="1">
                        <list editable="top" create="0" delete="1">
                            <field name="invoice_number"/>
                            <field name="currency_name"/>
                            <field name="invoice_date" optional="show"/>
                            <field name="invoice_date_due" optional="show"/>
                            <field name="name" string="Document"/>
                            <field name="move_type" optional="hide"/>
                            <field name="residual"/>
                            <field name="amount"/>
                        </list>
                    </field>

                    <group class="mt16">
                        <group>
                            <field name="allocated_amount" readonly="1"/>
                            <field name="amount_total"/>
                            <field name="extra_amount" readonly="1"/>
                        </group>
                    </group>
                </sheet>
                <footer>
                    <button name="action_confirm" string="Confirm Payment" type="object"
                            class="oe_highlight btn-primary" context="{'force_save': True}"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_multi_invoice_payment_wizard" model="ir.actions.act_window">
        <field name="name">Multi Invoice Payment</field>
        <field name="res_model">multi.invoice.payment.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem
            id="menu_multi_invoice_payment_root"
            name="Multi Invoice Payment"
            sequence="20"
            parent="accountant.menu_accounting"
            action="action_multi_invoice_payment_wizard"
            groups="account.group_account_invoice,account.group_account_readonly"/>
</odoo>