<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Email Template for Attendance Report -->
        <record id="email_template_attendance_report" model="mail.template">
            <field name="name">Attendance Report</field>
            <field name="model_id" ref="model_attendance_report_wizard"/>
            <field name="subject">Attendance Report - {{ object.date_from }} to {{ object.date_to }}</field>
            <field name="email_from">{{ user.email }}</field>
            <field name="email_to">{{ ','.join(object.recipient_ids.mapped('email')) }}</field>
            <field name="body_html" type="html">
<div style="font-family: Arial, sans-serif; max-width: 800px; margin: 0 auto;">

    <h2 style="color: #2c3e50;">Attendance Report</h2>

    <p>Dear Recipient,</p>

    <p>
        Please find attached the attendance report for the period
        <strong><t t-out="object.date_from"/></strong>
        to
        <strong><t t-out="object.date_to"/></strong>.
    </p>

    <div style="background-color: #f8f9fa; padding: 15px; border-radius: 5px; margin: 20px 0;">
        <h3 style="margin-top: 0;">Report Summary</h3>

        <p>
            <strong>Date Range:</strong>
            <t t-out="object.date_from"/> to <t t-out="object.date_to"/>
        </p>

        <p>
            <strong>Employees:</strong>
            <t t-if="object.employee_ids">
                <t t-out="len(object.employee_ids)"/>
            </t>
            <t t-else="">All</t>
        </p>

        <p>
            <strong>Departments:</strong>
            <t t-if="object.department_ids">
                <t t-out="len(object.department_ids)"/>
            </t>
            <t t-else="">All</t>
        </p>

        <p>
            <strong>Report Type:</strong>
            <t t-out="object.report_type"/>
        </p>
    </div>

    <p>
        This report was generated by
        <t t-out="user.name"/>.
    </p>

    <p>
        Best regards,<br/>
        <t t-out="user.company_id.name"/> HR System
    </p>

    <hr style="border: none; border-top: 1px solid #eee; margin: 20px 0;"/>

    <p style="font-size: 12px; color: #777;">
        This is an automated message. Please do not reply to this email.
    </p>

</div>


            </field>
        </record>

        <!-- Email Template for Attendance Alert -->
        <record id="email_template_attendance_alert" model="mail.template">
            <field name="name">Attendance Alert</field>
            <field name="model_id" ref="hr_attendance.model_hr_attendance"/>
            <field name="subject">Attendance Alert - {{ object.employee_id.name }} - {{ format_datetime(object.check_in) }}</field>
            <field name="email_to">{{ object.employee_id.parent_id.work_email or object.employee_id.department_id.manager_id.work_email }}</field>
            <field name="body_html"><![CDATA[
                <div style="font-family: Arial, sans-serif; max-width: 800px; margin: 0 auto;">
                    <h3 style="color: #dc3545;">Attendance Alert</h3>
                    <p>Dear Manager,</p>
                    <p>This is to notify you about an attendance issue for <strong>{{ object.employee_id.name }}</strong>.</p>

                    <div style="background-color: #fff3cd; padding: 15px; border-radius: 5px; margin: 20px 0;">
                        <h4 style="margin-top: 0; color: #856404;">Attendance Details</h4>
                        <p><strong>Date:</strong> {{ format_datetime(object.check_in) }}</p>
                        <p><strong>Employee:</strong> {{ object.employee_id.name }}</p>
                        <p><strong>Department:</strong> {{ object.employee_id.department_id.name or 'Not assigned' }}</p>
                        <p><strong>Status:</strong> <span style="color: #{{ object.attendance_status_id.color|replace('#','') }};">{{ object.attendance_status_id.name }}</span></p>
                        <p><strong>Check-in:</strong> {{ object.check_in|time }}</p>
                        <p><strong>Check-out:</strong> {{ object.check_out|time if object.check_out else 'Not recorded' }}</p>
                    </div>

                    <p>Please review this attendance record and take appropriate action if necessary.</p>

                    <p>Best regards,<br/>
                    {{ object.company_id.name }} HR System</p>
                </div>
            ]]></field>
        </record>
    </data>
</odoo>