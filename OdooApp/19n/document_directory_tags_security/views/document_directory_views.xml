<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_document_directory_tree" model="ir.ui.view">
        <field name="name">document.directory.list</field>
        <field name="model">document.directory</field>
        <field name="arch" type="xml">
            <list string="Directories" multi_edit="1">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="parent_id"/>
                <field name="res_model_id" optional="show"/>
                <field name="document_count" string="Documents"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_document_directory_tree_structure" model="ir.ui.view">
        <field name="name">document.directory.structure</field>
        <field name="model">document.directory</field>
        <field name="priority">5</field>
        <field name="arch" type="xml">
            <list string="Directory Structure" default_order="parent_path, sequence, name">
                <field name="name"/>
                <field name="parent_id"/>
                <field name="document_count"/>
                <field name="res_model_id" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_document_directory_form" model="ir.ui.view">
        <field name="name">document.directory.form</field>
        <field name="model">document.directory</field>
        <field name="arch" type="xml">
            <form string="Directory">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_attachments" type="object" class="oe_stat_button" icon="fa-files-o">
                            <field name="document_count" widget="statinfo" string="Documents"/>
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="parent_id"/>
                            <field name="active"/>
                            <field name="sequence"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group string="Model routing (advanced)">
                            <field name="res_model_id" options="{'no_create': True}"/>
                            <field name="res_model_name" readonly="1"/>
                        </group>
                    </group>
                    <group string="Independent numbering">
                        <field name="sequence_prefix"/>
                        <field name="sequence_padding"/>
                        <field name="sequence_id" readonly="1" groups="base.group_no_one"/>
                    </group>
                    <notebook>
                        <page string="Directory Tags" name="dir_tags">
                            <field name="directory_tag_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                        </page>
                        <page string="Security" name="security">
                            <group>
                                <field name="group_ids" widget="many2many_tags" options="{'no_create': True}"
                                       help="Leave empty for no extra group restriction. If set, the user must belong to at least one listed group."/>
                                <field name="allowed_document_user_ids" widget="many2many_avatar_user"
                                       help="Document Users only see directories listed here."/>
                            </group>
                        </page>
                        <page string="Sub-Directories" name="children">
                            <field name="child_ids" context="{'default_company_id': company_id}">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="document_count"/>
                                    <field name="active"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_document_directory_kanban" model="ir.ui.view">
        <field name="name">document.directory.kanban</field>
        <field name="model">document.directory</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile">
                <field name="id"/>
                <field name="name"/>
                <field name="document_count"/>
                <field name="directory_tag_ids"/>
                <templates>
                    <t t-name="card">
                        <div class="d-flex flex-column align-items-center p-3 text-center">
                            <i class="fa fa-folder-open fa-4x text-warning mb-2" title="Directory"/>
                            <field name="name" class="fw-bold fs-5"/>
                            <span class="badge text-bg-secondary mt-1">
                                <field name="document_count"/> documents
                            </span>
                            <field name="directory_tag_ids" widget="many2many_tags" options="{'color_field': 'color'}" class="mt-2"/>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_document_directory_search" model="ir.ui.view">
        <field name="name">document.directory.search</field>
        <field name="model">document.directory</field>
        <field name="arch" type="xml">
            <search string="Directories">
                <field name="name"/>
                <field name="parent_id"/>
                <field name="res_model_id"/>
                <field name="directory_tag_ids"/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
                <separator/>
                <filter string="Root folders" name="roots" domain="[('parent_id', '=', False)]"/>
                <group>
                    <filter string="Parent" name="group_parent" context="{'group_by': 'parent_id'}"/>
                    <filter string="Model" name="group_model" context="{'group_by': 'res_model_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_document_directory" model="ir.actions.act_window">
        <field name="name">Directories</field>
        <field name="res_model">document.directory</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="view_document_directory_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create a document directory</p>
            <p>Organize attachments with per-folder sequences, tags, and security.</p>
        </field>
    </record>

    <record id="action_document_directory_structure" model="ir.actions.act_window">
        <field name="name">Directory Structure</field>
        <field name="res_model">document.directory</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_document_directory_tree_structure"/>
        <field name="search_view_id" ref="view_document_directory_search"/>
        <field name="context">{'search_default_group_parent': 1}</field>
    </record>
</odoo>
