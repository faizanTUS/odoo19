<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="pos_product_price_display_pro.ProductCard" t-inherit="point_of_sale.ProductCard" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('product-content')]" position="after">
            <div t-if="props.displayPrice" class="product-price-display w-100 px-2 pb-1 mt-auto">
<!--            <div t-if="props.displayPrice" class="product-price-display w-50 px-2 pb-1 mt-auto" style="margin:0px -3px 0px 0px;">-->
                <span class="d-block small fw-bold">
                    <t t-esc="props.displayPrice"/>
                    <t t-if="props.priceLabel"> <t t-esc="props.priceLabel"/></t>
                </span>
            </div>
        </xpath>
    </t>
</templates>
