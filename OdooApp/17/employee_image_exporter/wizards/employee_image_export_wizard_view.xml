<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Wizard Form View -->
    <record id="view_employee_image_export_wizard_form" model="ir.ui.view">
        <field name="name">employee.image.export.wizard.form</field>
        <field name="model">employee.image.export.wizard</field>
        <field name="arch" type="xml">
            <form string="Export Employee Images">
                <sheet>

                    <!-- EMPLOYEE SELECTION -->
                    <group string="Employee Selection">
                        <field name="selection_mode"/>
                        <field name="include_archived"/>
                        <field name="state" invisible="1"/>

                        <!-- Domain field only visible when selection_mode = 'domain' -->
                        <field name="employee_domain" widget="domain" options="{'model': 'hr.employee'}"/>
                    <p class="oe_grey">
                        Use the domain to filter employees. E.g., <code>[('department_id.name', '=', 'Sales')]</code>
                    </p>

                    </group>

                    <!-- FILE NAMING -->
                    <group string="File Naming"  >
                        <field name="naming_mode"/>

                        <field name="custom_pattern" invisible = "naming_mode != 'custom'"/>
                        <p class="oe_grey" invisible = "naming_mode != 'custom'">
                        Use placeholders: <code>{name}</code>, <code>{id}</code>, <code>{identification_id}</code>, <code>{work_email}</code>, <code>{work_phone}</code>.
                    </p>
                    </group>

                    <!-- IMAGE OPTIONS -->
                    <group string="Image Options">
                        <field name="image_field"/>
                        <field name="output_format"/>
                        <field name="resize_enabled"/>

                        <!-- Resize options. only visible when resize_enabled = True -->
                        <field name="resize_width" invisible = "resize_enabled == False"/>

                        <field name="resize_height" invisible = "resize_enabled == False"/>

                        <field name="keep_ratio" invisible = "resize_enabled == False"/>
                    </group>

                    <!-- RESULT -->
                    <group string="Result" invisible ="state == 'draft'">
                        <field name="zip_filename" readonly="1"/>
                        <field name="zip_file" filename="zip_filename" readonly="1"/>
                    </group>

                    <!-- FOOTER BUTTONS -->
                    <footer>
                        <button name="action_generate_zip"
                                type="object"
                                string="Generate Zip"
                                class="btn-primary"
                                invisible = "state == 'generated'" />

                        <button name="action_download"
                                type="object"
                                string="Download Zip"
                                class="btn-secondary"
                                invisible = "state != 'generated'" />


                        <button string="Close"
                                class="btn-secondary"
                                special="cancel"/>
                    </footer>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_employee_image_export_wizard" model="ir.actions.act_window">
        <field name="name">Export Employee Images</field>
        <field name="res_model">employee.image.export.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{}</field>
    </record>

    <!-- Menu Item for direct access -->
    <menuitem id="menu_employee_image_export"
              name="Export Employee Images"
              action="action_employee_image_export_wizard"
              parent="hr.menu_hr_root"
              sequence="100"
              groups="employee_image_exporter.group_employee_image_exporter"/>

    <!-- Server Action to open wizard from hr.employee list selection -->
    <record id="server_action_employee_image_export" model="ir.actions.server">
        <field name="name">Export Images as Zip</field>
        <field name="model_id" ref="hr.model_hr_employee"/>
        <field name="binding_model_id" ref="hr.model_hr_employee"/>
        <field name="binding_type">action</field>
        <field name="state">code</field>
        <field name="code">
action = {
    "name": "Export Employee Images",
    "type": "ir.actions.act_window",
    "res_model": "employee.image.export.wizard",
    "view_mode": "form",
    "target": "new",
    "context": {
        "active_ids": records.ids,
        "default_selection_mode": "context",
    },
}
        </field>
    </record>

</odoo>
