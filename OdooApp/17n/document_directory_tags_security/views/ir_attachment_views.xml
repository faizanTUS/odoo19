<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_attachment_form_document_hub" model="ir.ui.view">
        <field name="name">ir.attachment.form.document.hub</field>
        <field name="model">ir.attachment</field>
        <field name="inherit_id" ref="base.view_attachment_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[hasclass('w-100')]" position="after">
                <group string="Document Hub" groups="base.group_user">
                    <field name="document_sequence_ref"/>
                    <field name="directory_id"
                           groups="document_directory_tags_security.group_document_hub_manager,document_directory_tags_security.group_document_hub_user"
                           options="{'no_create': True}"/>
                    <field name="directory_name"
                           groups="document_directory_tags_security.group_document_hub_employee"
                           readonly="1"/>
                    <field name="document_tag_ids" widget="many2many_tags" options="{'color_field': 'color'}"
                           groups="document_directory_tags_security.group_document_hub_manager,document_directory_tags_security.group_document_hub_user"/>
                    <field name="owner_id" widget="many2one_avatar_user"
                           groups="document_directory_tags_security.group_document_hub_manager,document_directory_tags_security.group_document_hub_user"/>
                </group>
            </xpath>
        </field>
    </record>

    <record id="view_attachment_tree_document_hub" model="ir.ui.view">
        <field name="name">ir.attachment.list.document.hub</field>
        <field name="model">ir.attachment</field>
        <field name="inherit_id" ref="base.view_attachment_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="document_sequence_ref" optional="show"/>
                <field name="directory_id" optional="show"
                       groups="document_directory_tags_security.group_document_hub_manager,document_directory_tags_security.group_document_hub_user"/>
                <field name="directory_name" optional="show"/>
                <field name="document_tag_ids" widget="many2many_tags" optional="hide" options="{'color_field': 'color'}"/>
                <field name="owner_id" widget="many2one_avatar_user" optional="show"/>
            </xpath>
        </field>
    </record>

    <record id="view_attachment_search_document_hub" model="ir.ui.view">
        <field name="name">ir.attachment.search.document.hub</field>
        <field name="model">ir.attachment</field>
        <field name="inherit_id" ref="base.view_attachment_search"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="document_sequence_ref"/>
                <field name="directory_id" groups="document_directory_tags_security.group_document_hub_manager,document_directory_tags_security.group_document_hub_user"/>
                <field name="directory_name"/>
                <field name="document_tag_ids"/>
                <field name="owner_id"/>
            </xpath>
            <xpath expr="//filter[@name='my_documents_filter']" position="attributes">
                <attribute name="domain">[('owner_id', '=', uid)]</attribute>
                <attribute name="string">My documents (owner)</attribute>
            </xpath>
            <xpath expr="//filter[@name='my_documents_filter']" position="after">
                <separator/>
                <filter string="Has directory" name="has_directory" domain="[('directory_id', '!=', False)]"/>
                <filter string="Unfiled" name="no_directory" domain="[('directory_id', '=', False)]"/>
            </xpath>
            <xpath expr="//search" position="inside">
                <searchpanel groups="document_directory_tags_security.group_document_hub_manager,document_directory_tags_security.group_document_hub_user">
                    <field name="directory_id" icon="fa-folder" enable_counters="1"/>
                    <field name="document_tag_ids" icon="fa-tags" select="multi" enable_counters="1"/>
                </searchpanel>
            </xpath>
        </field>
    </record>

    <record id="view_attachment_kanban_document_hub" model="ir.ui.view">
        <field name="name">ir.attachment.kanban.document.hub</field>
        <field name="model">ir.attachment</field>
        <field name="inherit_id" ref="mail.view_document_file_kanban"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='type']" position="after">
                <field name="document_sequence_ref"/>
                <field name="directory_name"/>
                <field name="document_tag_ids"/>
                <field name="owner_id"/>
            </xpath>
            <xpath expr="//field[@name='name']" position="after">
                <div t-if="record.document_sequence_ref.raw_value" class="text-muted small">
                    <field name="document_sequence_ref"/>
                </div>
                <div t-if="record.directory_name.raw_value" class="small">
                    <i class="fa fa-folder-o me-1" title="Directory"/><field name="directory_name"/>
                </div>
                <field name="document_tag_ids" widget="many2many_tags" options="{'color_field': 'color'}" class="mt-1"/>
            </xpath>
            <xpath expr="//field[@name='create_uid']" position="replace">
                <field name="owner_id" widget="many2one_avatar_user" class="ms-auto"/>
            </xpath>
        </field>
    </record>

    <record id="action_document_hub_all_attachments" model="ir.actions.act_window">
        <field name="name">All Documents</field>
        <field name="res_model">ir.attachment</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="search_view_id" ref="base.view_attachment_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Upload or open a document</p>
            <p>Use the search panel to browse by directory and tags.</p>
        </field>
    </record>

    <record id="action_document_hub_my_attachments" model="ir.actions.act_window">
        <field name="name">My Documents</field>
        <field name="res_model">ir.attachment</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="context">{'search_default_my_documents_filter': 1}</field>
        <field name="search_view_id" ref="base.view_attachment_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No personal documents yet</p>
            <p>Files you own appear here.</p>
        </field>
    </record>
</odoo>
