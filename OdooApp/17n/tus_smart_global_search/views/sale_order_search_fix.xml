<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!--
        Core sale order search uses partner_id child_of in the same OR as name ilike.
        For typed text like order references (S00, S00007), child_of does not apply and
        breaks the quick-search / "No matches" behaviour on list views (Odoo 17–19).
        Use ilike on partner for name-style partner lookup instead.
    -->
    <record id="view_sales_order_filter_search_text_fix" model="ir.ui.view">
        <field name="name">sale.order.search.filter_domain.text.fix</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_sales_order_filter"/>
        <field name="arch" type="xml">
            <field name="name" position="attributes">
                <attribute name="filter_domain">['|', '|', ('name', 'ilike', self), ('client_order_ref', 'ilike', self), ('partner_id', 'ilike', self)]</attribute>
            </field>
        </field>
    </record>
</odoo>
