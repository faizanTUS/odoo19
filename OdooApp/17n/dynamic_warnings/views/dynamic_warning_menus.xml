<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_dynamic_warning_rule" model="ir.actions.act_window">
        <field name="name">Warning Rules</field>
        <field name="res_model">dynamic.warning.rule</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'search_default_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first warning rule
            </p>
            <p>
                Define custom alerts that appear on form views when conditions are met.
                Choose a target model (e.g. Product, Partner, Sale Order), set conditions (domain),
                write your message and select the style: Info, Warning or Danger.
            </p>
        </field>
    </record>

    <menuitem id="menu_dynamic_warnings_root"
              name="Dynamic Warnings"
              parent="base.menu_administration"
              sequence="100"/>

    <menuitem id="menu_dynamic_warning_rule"
              name="Warning Rules"
              parent="menu_dynamic_warnings_root"
              action="action_dynamic_warning_rule"
              sequence="10"/>
</odoo>
