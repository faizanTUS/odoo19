<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_picking_form_inherit_backdate" model="ir.ui.view">
        <field name="name">stock.picking.form.inherit.backdate</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='date_done']" position="after">
                <field name="original_date_done" groups="inventory_backdate_advanced.group_inventory_backdate_manager"/>
            </xpath>
            <xpath expr="//field[@name='original_date_done']" position="after">
                <field name="backdate_user_id" groups="inventory_backdate_advanced.group_inventory_backdate_manager"/>
                <field name="backdate_reason" groups="inventory_backdate_advanced.group_inventory_backdate_manager"/>
            </xpath>
        </field>
    </record>
</odoo>
