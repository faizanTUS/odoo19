<odoo>
  <record id="view_picking_form_inherit_reversal" model="ir.ui.view">
    <field name="name">stock.picking.form.tus.reversal</field>
    <field name="model">stock.picking</field>
    <field name="inherit_id" ref="stock.view_picking_form"/>
    <field name="arch" type="xml">
      <xpath expr="//header" position="inside">
        <button name="action_open_cancel_reset_wizard" type="object"
                string="Cancel/Reverse/Reset" class="oe_highlight"
                groups="tus_po_reversal_advanced.group_reversal_user"/>
      </xpath>
    </field>
  </record>
</odoo>
