<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_multi_approval_tree" model="ir.ui.view">
        <field name="name">multi.approval.tree</field>
        <field name="model">multi.approval</field>
        <field name="arch" type="xml">
            <tree string="Approval Requests" decoration-info="state=='submitted'" decoration-success="state=='approved'" decoration-danger="state=='refused'" decoration-muted="state=='cancel'">
                <field name="code"/>
                <field name="name"/>
                <field name="user_id"/>
                <field name="type_id"/>
                <field name="state" widget="badge" decoration-info="state=='submitted'" decoration-success="state=='approved'" decoration-danger="state=='refused'" decoration-muted="state=='cancel'"/>
                <field name="complete_date"/>
            </tree>
        </field>
    </record>

    <record id="view_multi_approval_form" model="ir.ui.view">
        <field name="name">multi.approval.form</field>
        <field name="model">multi.approval</field>
        <field name="arch" type="xml">
            <form string="Approval Request">
                <header>
                    <button name="action_submit" string="Submit" type="object" class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_approve" string="Approve" type="object" class="oe_highlight" invisible="state != 'submitted'"/>
                    <button name="%(action_approval_refused_reason)d" string="Refuse" type="action" context="{'default_reason': ''}" invisible="state != 'submitted'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,approved"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="name"/>
                            <field name="user_id"/>
                            <field name="type_id"/>
                        </group>
                        <group>
                            <field name="origin_ref"/>
                            <field name="complete_date" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Approval Lines">
                            <field name="line_ids" readonly="1">
                                <tree>
                                    <field name="sequence"/>
                                    <field name="name"/>
                                    <field name="user_id"/>
                                    <field name="require_opt"/>
                                    <field name="state" widget="badge" decoration-info="state=='waiting'" decoration-success="state=='approved'" decoration-danger="state=='refused'"/>
                                    <field name="refused_reason"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" groups="base.group_user"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_multi_approval_search" model="ir.ui.view">
        <field name="name">multi.approval.search</field>
        <field name="model">multi.approval</field>
        <field name="arch" type="xml">
            <search string="Approval Requests">
                <field name="code"/>
                <field name="name"/>
                <field name="user_id"/>
                <field name="type_id"/>
                <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Submitted" name="submitted" domain="[('state', '=', 'submitted')]"/>
                <filter string="Approved" name="approved" domain="[('state', '=', 'approved')]"/>
                <filter string="Refused" name="refused" domain="[('state', '=', 'refused')]"/>
                <filter string="My Requests" name="my_requests" domain="[('user_id', '=', uid)]"/>
                <filter string="My Approvals" name="my_approvals" domain="[('line_ids.user_id', '=', uid), ('state', '=', 'submitted')]"/>
                <group expand="0" string="Group By">
                    <filter string="State" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Type" name="group_type" context="{'group_by': 'type_id'}"/>
                    <filter string="User" name="group_user" context="{'group_by': 'user_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_multi_approval_request" model="ir.actions.act_window">
        <field name="name">Approval Requests</field>
        <field name="res_model">multi.approval</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first approval request!
            </p>
            <p>
                Submit requests for approval through configured workflows.
            </p>
        </field>
    </record>
</odoo>

