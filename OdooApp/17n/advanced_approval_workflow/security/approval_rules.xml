<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="multi_approval_rule_user" model="ir.rule">
        <field name="name">Approval Request: User Restricted</field>
        <field name="model_id" ref="model_multi_approval"/>
        <field name="domain_force">
            [
                '|',
                ('user_id', '=', user.id),
                ('line_ids.user_id', '=', user.id)
            ]
        </field>
        <field name="groups"
               eval="[(4, ref('advanced_approval_workflow.group_approval_user'))]"/>
    </record>

    <record id="multi_approval_rule_manager" model="ir.rule">
        <field name="name">Approval Request: Manager Full Access</field>
        <field name="model_id" ref="model_multi_approval"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups"
               eval="[(4, ref('advanced_approval_workflow.group_approval_manager'))]"/>
    </record>

    <record id="multi_approval_line_rule_user" model="ir.rule">
        <field name="name">Approval Line: User Restricted</field>
        <field name="model_id" ref="model_multi_approval_line"/>
        <field name="domain_force">
            [
                '|',
                ('approval_id.user_id', '=', user.id),
                ('user_id', '=', user.id)
            ]
        </field>
        <field name="groups"
               eval="[(4, ref('advanced_approval_workflow.group_approval_user'))]"/>
    </record>

    <record id="multi_approval_line_rule_manager" model="ir.rule">
        <field name="name">Approval Line: Manager Full Access</field>
        <field name="model_id" ref="model_multi_approval_line"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups"
               eval="[(4, ref('advanced_approval_workflow.group_approval_manager'))]"/>
    </record>

</odoo>
