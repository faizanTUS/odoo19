<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_sale_multi_pricelist_wizard_form" model="ir.ui.view">
        <field name="name">sale.multi.pricelist.wizard.form</field>
        <field name="model">sale.multi.pricelist.wizard</field>
        <field name="arch" type="xml">
            <form string="Multi Pricelist on Order">
                <sheet>
                    <group>
                        <group>
                            <field name="order_line_id" invisible="1"/>
                            <field name="product_id" readonly="1"/>
                            <field name="product_uom_qty" readonly="1"/>
                            <field name="product_uom_id" readonly="1" invisible="1"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <label for="line_ids" string="Compare prices and select a pricelist to apply:"/>
                    <field name="line_ids" readonly="1" nolabel="1">
                        <tree string="Pricelist Prices" create="0" delete="0" edit="0" decoration-primary="pricelist_id == parent.selected_pricelist_id">
                            <field name="pricelist_id" context="{'hide_currency_in_name': True}"/>
                            <field name="min_qty"/>
                            <field name="discount_pr"/>
                            <field name="discount_amount" widget="monetary"
                                   options="{'currency_field': 'currency_id'}"
                                   decoration-success="discount_amount &gt; 0"
                                   decoration-danger="discount_amount &lt; 0"/>
                            <field name="price" widget="monetary"
                                   options="{'currency_field': 'currency_id'}"/>

<!--                            <field name="price" widget="monetary"/>-->
                            <field name="currency_id" column_invisible="1"/>
                        </tree>
                    </field>
                    <group>
                        <group>
                            <field name="available_pricelist_ids" invisible="1"/>
                            <field name="selected_pricelist_id" options="{'no_create': True}" placeholder="Select a pricelist..." context="{'hide_currency_in_name': True}"/>
                        </group>
                    </group>
                </sheet>
                <footer>
                    <button name="action_apply" string="Apply" type="object" class="btn-primary" data-hotkey="q"/>
                    <button name="action_cancel" string="Cancel" special="cancel" class="btn-secondary" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
