<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_material_requisition_config_settings" model="ir.ui.view">
        <field name="name">material.requisition.config.form</field>
        <field name="model">material.requisition.config</field>
        <field name="arch" type="xml">
            <form string="Material Requisition Configuration" class="oe_form_configuration">
                <sheet>
                    <group>
                        <group string="Approval Workflow">
                            <field name="set_email_notification"/>
                            <field name="set_department_manager_approval"/>
                            <field name="set_requisition_officer_approval"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
