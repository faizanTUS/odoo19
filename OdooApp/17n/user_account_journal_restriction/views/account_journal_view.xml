<odoo>
    <record id="view_account_journal_form_journal_restriction_inherit" model="ir.ui.view">
        <field name="name">account.journal.journal.restriction.form.inherit</field>
        <field name="model">account.journal</field>
        <field name="inherit_id" ref="account.view_account_journal_form"/>
        <field name="arch" type="xml">
            <!-- Add a dedicated tab for control -->
            <xpath expr="//page[last()]" position="after">
                <page string="Access Control" groups="base.group_user">
                    <group>
                        <field name="allowed_user_ids" widget="many2many_tags"
                               options="{'no_create_edit': True}"/>
                        <label string="Only these users will be able to see and use this journal." for="allowed_user_ids"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
