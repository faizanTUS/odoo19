<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t t-name="point_of_sale.ProductsWidget" owl="1"
       t-inherit="point_of_sale.ProductsWidget"
       t-inherit-mode="extension">
        <xpath expr="//ProductCard" position="attributes">
            <attribute name="price">(pos &amp;&amp; pos.config &amp;&amp; pos.config.display_product_price_on_card !== false) ? getProductPrice(product) : ''</attribute>
            <attribute name="priceLabel">(pos &amp;&amp; pos.config &amp;&amp; pos.config.display_product_price_on_card !== false) ? getPriceLabel() : ''</attribute>
        </xpath>
    </t>
</templates>