<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="pdf_split_and_merge.PDFBinaryField" t-inherit="web.BinaryField" owl="1">
        <xpath expr="//t[@t-elif='props.record.resId and props.value']" position="replace">
            <t t-elif="props.record.resId and props.value">
                <div class="o_image_box float-start" t-att-data-tooltip="'Download ' + fileName">
                    <a class="o_form_uri d-flex align-items-center" href="#" t-on-click.stop.prevent="onFileDownload">
                        <span style="cursor: zoom-in;" class="o_image o_hover" data-mimetype="application/pdf" data-ext="pdf" role="img" t-on-click.stop="onFileOpen"/>
                        <t t-if="state.fileName" t-esc="state.fileName" />
                    </a>
                </div>
            </t>
        </xpath>
    </t>

</templates>
