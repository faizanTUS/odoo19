<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-inherit="web.Many2ManyBinaryField.attachment_preview"
       t-inherit-mode="extension">

        <xpath expr="//div[hasclass('caption') and hasclass('small')]/a[last()]"
               position="after">
            <t t-if="file.file_size">
                <div class="text-muted small ms-2 d-inline-block">
                    <t t-esc="(file.file_size / 1048576).toFixed(2)"/> MB
                </div>
            </t>
        </xpath>

    </t>

    <t t-inherit="mail.MailComposerAttachmentList"
       t-inherit-mode="extension">

        <xpath expr="//li//a" position="after">

                <t t-if="file.file_size">
                    <small class="text-muted ms-2 me-2">
                        (File size: <t t-esc="(file.file_size / 1048576).toFixed(2)"/> MB)
                    </small>
                </t>

        </xpath>

    </t>

</templates>
