<odoo>
    <data>
        <record id="purchase_order_form_global_discount" model="ir.ui.view">
            <field name="name">purchase.order.form.inherit.discount</field>
            <field name="model">purchase.order</field>
            <field name="inherit_id" ref="purchase.purchase_order_form"/>
            <field name="arch" type="xml">
                <xpath expr="//notebook//page[@name='products']//field[@name='order_line']//tree//field[@name='taxes_id']"
                       position="after">
                    <field name="discount" attrs="{'invisible': [('parent.show_discount_feature', '=', False)]}"/>
                </xpath>
                <xpath expr="//field[@name='tax_totals']" position="before">
                    <field name="show_discount_feature" invisible="1"/>
                    <div class="float-end d-flex gap-1 mb-2" name="Po_button_below_order_lines"
                         attrs="{'invisible': [('show_discount_feature', '=', False)]}">
                        <button string="Discount" name="action_open_discount_wizard" type="object"
                                class="btn btn-secondary"
                                attrs="{'invisible':[('state', 'not in', ['draft', 'sent'])]}"
                        />
                    </div>
                </xpath>
            </field>
        </record>
    </data>
</odoo>