<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hr_in_report_wizard_exp_consolidated" model="ir.ui.view">
        <field name="name">hr.in.report.wizard.exp.consolidated.form</field>
        <field name="model">hr.in.report.wizard.exp.consolidated</field>
        <field name="arch" type="xml">
            <form string="Employee-wise consolidated claims">
                <group>
                    <group><field name="date_from"/><field name="date_to"/></group>
                    <group>
                        <field name="company_ids" widget="many2many_tags"/>
                        <field name="department_ids" widget="many2many_tags"/>
                        <field name="employee_ids" widget="many2many_tags"/>
                    </group>
                </group>
                <footer>
                    <button name="action_export_xlsx" type="object" string="Export XLSX" class="btn-primary"/>
                    <button name="action_export_pdf" type="object" string="Export PDF"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_hr_in_report_wizard_exp_consolidated" model="ir.actions.act_window">
        <field name="name">Employee-wise consolidated claims</field>
        <field name="res_model">hr.in.report.wizard.exp.consolidated</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <record id="view_hr_in_report_wizard_exp_product" model="ir.ui.view">
        <field name="name">hr.in.report.wizard.exp.product_analytic.form</field>
        <field name="model">hr.in.report.wizard.exp.product_analytic</field>
        <field name="arch" type="xml">
            <form string="Claims by product &amp; analytic">
                <group>
                    <group><field name="date_from"/><field name="date_to"/></group>
                    <group>
                        <field name="company_ids" widget="many2many_tags"/>
                        <field name="department_ids" widget="many2many_tags"/>
                        <field name="employee_ids" widget="many2many_tags"/>
                    </group>
                </group>
                <footer>
                    <button name="action_export_xlsx" type="object" string="Export XLSX" class="btn-primary"/>
                    <button name="action_export_pdf" type="object" string="Export PDF"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_hr_in_report_wizard_exp_product" model="ir.actions.act_window">
        <field name="name">Claims by product &amp; analytic</field>
        <field name="res_model">hr.in.report.wizard.exp.product_analytic</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- Native Expenses app → Reporting: same audience as core (internal users). -->
    <menuitem
        id="menu_exp_consolidated_native"
        name="Employee-wise consolidated claims"
        parent="hr_expense.menu_hr_expense_reports"
        action="action_hr_in_report_wizard_exp_consolidated"
        groups="base.group_user"
        sequence="1"/>
    <menuitem
        id="menu_exp_product_native"
        name="Claims by product &amp; analytic"
        parent="hr_expense.menu_hr_expense_reports"
        action="action_hr_in_report_wizard_exp_product"
        groups="base.group_user"
        sequence="2"/>

    <!--
        Employees → Reporting: sibling of "HR Reports" (not nested under it), so visibility
        does not require IndiaHrReportscommunity.group_hr_in_reports_user. Any of the listed groups is enough.
    -->
    <menuitem
        id="menu_hr_in_reports_expense"
        name="Expense reports"
        parent="hr.hr_menu_hr_reports"
        groups="IndiaHrReportscommunity.group_hr_in_reports_user,hr_expense.group_hr_expense_team_approver,hr.group_hr_user,base.group_system"
        sequence="21"/>
    <menuitem
        id="menu_exp_consolidated"
        name="Employee-wise consolidated claims"
        parent="menu_hr_in_reports_expense"
        action="action_hr_in_report_wizard_exp_consolidated"
        sequence="10"/>
    <menuitem
        id="menu_exp_product"
        name="Claims by product &amp; analytic"
        parent="menu_hr_in_reports_expense"
        action="action_hr_in_report_wizard_exp_product"
        sequence="20"/>
</odoo>
