<?xml version="1.0" encoding="utf-8"?>
<odoo>
	<!-- Minimal redirect form template for Cashfree -->
	<!-- Cashfree uses JavaScript SDK for checkout, so this form is minimal -->
	<template id="cashfree_redirect_form">
		<form id="CashfreeRedirectForm" method="post" style="display: none;">
			<!-- Hidden fields for Cashfree payment session (if needed for fallback) -->
			<input type="hidden" id="cashfree_payment_session_id" t-att-value="cashfree_payment_session_id"/>
			<input type="hidden" id="cashfree_mode" t-att-value="cashfree_mode"/>
		</form>
	</template>
</odoo>
