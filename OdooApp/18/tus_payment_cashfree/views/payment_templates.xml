<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="cashfree_assets">
        <script type="text/javascript" src="https://sdk.cashfree.com/js/v3/cashfree.js"></script>
    </template>

    <template id="tt_payment_form" inherit_id="payment.form">
        <xpath expr="." position="inside">
            <t t-call="tus_payment_cashfree.cashfree_assets"/>
        </xpath>
    </template>

    <template id="tt_payment_pay" inherit_id="payment.pay">
        <xpath expr="." position="inside">
            <t t-call="tus_payment_cashfree.cashfree_assets"/>
        </xpath>
    </template>

    <template id="tt_payment_confirm" inherit_id="payment.confirm">
        <xpath expr="." position="inside">
            <t t-call="tus_payment_cashfree.cashfree_assets"/>
        </xpath>
    </template>
</odoo>
