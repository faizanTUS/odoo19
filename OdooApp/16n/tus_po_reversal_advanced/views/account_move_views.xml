<odoo>
  <record id="view_vendor_bill_form_inherit_reversal" model="ir.ui.view">
    <field name="name">account.move.form.tus.reversal</field>
    <field name="model">account.move</field>
    <field name="inherit_id" ref="account.view_move_form"/>
    <field name="arch" type="xml">
      <xpath expr="//header" position="inside">
        <button name="action_open_cancel_reset_wizard" type="object"
                string="Cancel/Reverse/Reset" class="oe_highlight"
                groups="tus_po_reversal_advanced.group_reversal_user"
                attrs="{'invisible': [('move_type', 'not in', ['in_refund', 'in_invoice'])]}"
        />
      </xpath>
    </field>
  </record>
</odoo>
