<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Purchase Order Report - Add Multi Discount column -->
    <template id="report_purchaseorder_document_multi_discount" inherit_id="purchase.report_purchaseorder_document">
        <xpath expr="//th[@name='th_price_unit']" position="after">
            <th name="th_multi_discount" class="text-end" t-if="o.show_multi_discount_in_pdf" groups="multi_discount_advanced.tus_multi_discount_advanced_group_purchase">
                <strong>Multi Discount</strong>
            </th>
        </xpath>
        <xpath expr="//tbody//t[contains(@t-if, 'not line.display_type')]//td[5]" position="after">
            <td class="text-end" t-if="o.show_multi_discount_in_pdf and not line.display_type" groups="multi_discount_advanced.tus_multi_discount_advanced_group_purchase">
                <span t-field="line.multi_discount"/>
            </td>
        </xpath>
        <xpath expr="//th[@name='th_amount']" position="before">
            <th name="th_discounted_amount" class="text-end" t-if="o.show_multi_discount_in_pdf" groups="multi_discount_advanced.tus_multi_discount_advanced_group_purchase">
                <strong>Discounted Amount</strong>
            </th>
        </xpath>
        <xpath expr="//tbody//t[contains(@t-if, 'not line.display_type')]//td[6]" position="after">
            <td class="text-end" t-if="o.show_multi_discount_in_pdf and not line.display_type" groups="multi_discount_advanced.tus_multi_discount_advanced_group_purchase">
                <span t-field="line.discount_amount"
                    t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
            </td>
        </xpath>
    </template>
</odoo>

