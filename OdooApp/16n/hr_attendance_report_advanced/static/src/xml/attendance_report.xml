<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="AttendanceReportWidget">
        <div class="o_attendance_report_widget">
            <div class="o_attendance_filters">
                <div class="row">
                    <div class="col-md-3">
                        <label>Date From</label>
                        <input type="date" t-att-value="state.date_from" class="form-control"/>
                    </div>
                    <div class="col-md-3">
                        <label>Date To</label>
                        <input type="date" t-att-value="state.date_to" class="form-control"/>
                    </div>
                    <div class="col-md-3">
                        <label>Employees</label>
                        <select class="form-control">
                            <option value="all">All Employees</option>
                            <option t-foreach="state.employees" t-as="emp" t-att-value="emp.id" t-esc="emp.name"/>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label>Output Format</label>
                        <select class="form-control">
                            <option value="pdf">PDF</option>
                            <option value="excel">Excel</option>
                        </select>
                    </div>
                </div>
            </div>

            <div class="o_attendance_preview mt-3">
                <div class="card">
                    <div class="card-header">
                        <h5 class="card-title">Report Preview</h5>
                    </div>
                    <div class="card-body">
                        <div t-if="state.loading" class="text-center">
                            <i class="fa fa-spinner fa-spin"/> Loading...
                        </div>
                        <div t-else="" class="o_attendance_table">
                            <!-- Preview content will be rendered here -->
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </t>
</templates>