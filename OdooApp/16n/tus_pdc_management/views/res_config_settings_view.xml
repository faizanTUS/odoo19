<odoo>
    <record id="view_res_config_settings_tus_pdc" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.tus.pdc</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
<!--            <xpath expr="//block[@id='account_vendor_bills']" position="after">-->
            <xpath expr="//div[@id='account_vendor_bills']" position="after">
<!--                <block title="PDC Payment" id="tus_pdc_payment_block">-->
                <h2>PDC Payment</h2>

                <div class="row mt16 o_settings_container">
                    <div class="col-12 col-lg-6 o_setting_box"
                         title="These accounts are set in any new PDC payment entry created.">
                        <div class="o_setting_left_pane"/>
                        <div class="o_setting_right_pane">
                            <span class="o_form_label">PDC Accounts and Journals
                            </span>
                            <div class="content-group">
                                <div class="row mt8">
                                    <label for="customer_pdc_account_id" class="col-lg-5 o_light_label"/>
                                    <field name="customer_pdc_account_id"/>
                                </div>
                                <div class="row mt8">
                                    <label for="customer_pdc_journal_id"
                                           class="col-lg-5 o_light_label"/>
                                    <field name="customer_pdc_journal_id"/>
                                </div>

                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-lg-6 o_setting_box"
                         title="These accounts are set in any new PDC payment entry created.">
                        <div class="o_setting_left_pane"/>
                        <div class="o_setting_right_pane">
                            <span class="o_form_label">PDC Accounts and Journals
                            </span>
                            <div class="content-group">
                                <div class="row mt8">
                                    <label for="customer_pdc_bounce_account_id" class="col-lg-5 o_light_label"/>
                                    <field name="customer_pdc_bounce_account_id"/>
                                </div>
                                <div class="row mt8">
                                    <label for="pdc_bank_journal_id"
                                           class="col-lg-5 o_light_label"/>
                                    <field name="pdc_bank_journal_id"/>
                                </div>

                            </div>
                        </div>
                    </div>

                    <div class="col-12 col-lg-6 o_setting_box"
                         title="These accounts are set in any new PDC payment entry created.">
                        <div class="o_setting_left_pane"/>
                        <div class="o_setting_right_pane">
                            <span class="o_form_label">
                            </span>
                            <div class="content-group">
                                <div class="row mt8">
                                    <label for="vendor_pdc_account_id" class="col-lg-5 o_light_label"/>
                                    <field name="vendor_pdc_account_id"/>
                                </div>
                                <div class="row mt8">
                                    <label for="vendor_pdc_journal_id"
                                           class="col-lg-5 o_light_label"/>
                                    <field name="vendor_pdc_journal_id"/>
                                </div>

                            </div>
                        </div>
                    </div>

                    <div class="col-12 col-lg-6 o_setting_box"
                         title="These accounts are set in any new PDC payment entry created.">
                        <div class="o_setting_left_pane"/>
                        <div class="o_setting_right_pane">
                            <span class="o_form_label">
                            </span>
                            <div class="content-group">
                                <div class="row mt8">
                                    <label for="vendor_pdc_bounce_account_id" class="col-lg-5 o_light_label"/>
                                    <field name="vendor_pdc_bounce_account_id"/>
                                </div>

                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
