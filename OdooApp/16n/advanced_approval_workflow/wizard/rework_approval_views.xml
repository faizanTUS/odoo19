<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_approval_rework_wizard_form" model="ir.ui.view">
        <field name="name">approval.rework.wizard.form</field>
        <field name="model">approval.rework.wizard</field>
        <field name="arch" type="xml">
            <form string="Rework Approval">
                <group>
                    <field name="reason" placeholder="Enter the reason for rework..."/>
                </group>
                <footer>
                    <button string="Rework" name="action_rework" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_approval_rework_wizard" model="ir.actions.act_window">
        <field name="name">Rework Approval</field>
        <field name="res_model">approval.rework.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>

