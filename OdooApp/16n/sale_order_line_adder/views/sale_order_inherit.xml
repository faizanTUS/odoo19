<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_order_form_with_add_line" model="ir.ui.view">
        <field name="name">add.line.sale.order.form.view</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']/tree/field[@name='product_id']" position="before">
                    <button name="action_add_line_after"
                        icon="fa-plus-square"
                        type="object"
                        class="btn btn-primary oe_inline add-btn" width="25px"
                />
            </xpath>
        </field>
    </record>


</odoo>