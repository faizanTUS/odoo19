<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_quick_task" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.crm.quick.task</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="crm.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('app_settings_block')][@data-key='crm']/div[1]" position="after">
                <div class="row mt16 o_settings_container">
                    <div class="col-lg-6 o_setting_box">
                        <div class="o_setting_left_pane">
                        </div>
                        <div class="o_setting_right_pane">
                            <label for="crm_quick_task_project_id"/>
                            <div class="text-muted">
                                Quick Task Default Project" help="Default project used when creating a Quick Task from a
                                Lead or Opportunity. You can override this per Sales Team or per Lead/Opportunity.
                            </div>
                            <field name="crm_quick_task_project_id"/>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
