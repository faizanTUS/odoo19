<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_form_view_pricelist_prices" model="ir.ui.view">
        <field name="name">product.template.form.pricelist.prices</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='general_information']/group[last()]" position="before">
                <group name="pricelist_price_on_product" string="Pricelist Price on The Product"
                    attrs="{'invisible': [('user_display_pricelist_on_product', '=', False)]}">
                    <field name="user_display_pricelist_on_product" invisible="1"/>
                    <field name="hide_pricelist_price"/>
                    <field name="hide_pricelist_ids" widget="many2many_tags" options="{'no_create': True}"
                        attrs="{'invisible': [('hide_pricelist_price', '=', True)]}"/>
                    <field name="pricelist_price_line_ids" nolabel="1" colspan="2"
                        attrs="{'invisible': [('hide_pricelist_price', '=', True)]}"
                        readonly="1">
                        <tree string="Pricelist Prices" create="0" delete="0" edit="0" decoration-muted="1">
                            <field name="pricelist_name" string="Pricelist Name"/>
                            <field name="min_quantity" string="Min Qty"/>
                            <field name="price" string="Price" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                            <field name="date_start" string="From Date"/>
                            <field name="date_end" string="To Date"/>
                            <field name="currency_id" attrs="{'column_invisible': True}"/>
                            <field name="pricelist_id" attrs="{'column_invisible': True}"/>
                        </tree>
                    </field>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
