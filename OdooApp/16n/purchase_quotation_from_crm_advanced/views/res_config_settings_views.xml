<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_inherit_crm_rfq" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.purchase.quotation.from.crm</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="crm.res_config_settings_view_form"/>
        <field name="priority" eval="15"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='generate_lead_setting_container']" position="after">
                <h2>Purchase Quotation from CRM</h2>
                <div class="row mt16 o_settings_container"
                     groups="purchase.group_purchase_manager">
                    <div class="col-lg-6 o_setting_box">
                        <div class="o_setting_left_pane">

                        </div>
                        <div class="o_setting_right_pane">
                            <label for="crm_rfq_vendor_action"/>
                            <div class="text-muted">
                                When creating an RFQ from a Lead, choose how to select the vendor by default.
                            </div>
                            <field name="crm_rfq_vendor_action"/>
                        </div>
                    </div>

                    <div class="col-12 col-lg-6 o_setting_box">
                        <div class="o_setting_left_pane">
                            <field name="crm_rfq_prefill_from_lead_products"/>
                        </div>
                        <div class="o_setting_right_pane">
                            <label for="crm_rfq_prefill_from_lead_products"/>
                            <div class="text-muted">
                                Pre-fill RFQ lines from the lead's requested products (if any).
                            </div>
                        </div>
                    </div>

                    <div class="col-12 col-lg-6 o_setting_box">
                        <div class="o_setting_left_pane">
                            <field name="crm_rfq_copy_expected_revenue"/>
                        </div>
                        <div class="o_setting_right_pane">
                            <label for="crm_rfq_copy_expected_revenue"/>
                            <div class="text-muted">
                                Copy the lead's Expected Revenue into the RFQ notes.
                            </div>
                        </div>
                    </div>

                    <div class="col-12 col-lg-6 o_setting_box">
                        <div class="o_setting_left_pane">
                        </div>
                        <div class="o_setting_right_pane">
                            <label for="crm_rfq_required_by_days"/>
                            <div class="text-muted">
                                Default number of days from today for Order Deadline / Expected Arrival (0 = use today).
                            </div>
                            <field name="crm_rfq_required_by_days"/>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
