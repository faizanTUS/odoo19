<?xml version="1.0" encoding="UTF-8"?>
<odoo>


        <record id="ir_cron_ageing_alerts" model="ir.cron">
            <field name="name">Ageing Alerts : Daily</field>
            <field name="model_id" ref="model_account_ageing_alert_runner"/>
            <field name="state">code</field>
            <field name="code">model.run_daily_ageing_alert()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="nextcall" eval="(DateTime.now().replace(hour=3, minute=0) + timedelta(days=1)).strftime('%Y-%m-%d %H:%M:%S')"/>
        </record>
           

</odoo>
