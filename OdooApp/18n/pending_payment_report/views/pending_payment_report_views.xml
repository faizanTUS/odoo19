<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Pending Payment Report Wizard -->
    <record id="view_pending_payment_report_wizard_form" model="ir.ui.view">
        <field name="name">pending.payment.report.wizard.form</field>
        <field name="model">pending.payment.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Pending Payment Report">
                <group>
                    <group>
                        <field name="partner_customer_ids" widget="many2many_tags" placeholder="All Customers"
                               invisible="invoice_type != 'out_invoice'"/>
                        <field name="partner_vendor_ids" widget="many2many_tags" placeholder="All Vendors"
                               invisible="invoice_type != 'in_invoice'"/>
                        <field name="partner_ids" widget="many2many_tags" placeholder="All Customers / Vendors"
                               invisible="invoice_type != 'both'"/>
                        <field name="date_from" optional="show"/>
                        <field name="date_to" optional="show"/>
                        <field name="due_date_from"/>
                        <field name="due_date_to"/>
                        <field name="currency_id" options="{'no_create': True}"/>
                    </group>
                    <group>
                        <field name="company_id" groups="base.group_multi_company"/>
                        <field name="user_id" placeholder="All Salespersons"/>
                        <field name="invoice_type" widget="radio"/>
                    </group>
                </group>
                <footer>
                    <button name="action_view_report" string="View Report" type="object" class="btn-secondary"/>
                    <button name="action_print_report" string="Print Report" type="object" class="btn-primary"/>
                    <button name="action_print_excel" string="Print Excel" type="object" class="btn-primary"/>
                    <button name="action_send_to_configured_user" string="Send to Configured User" type="object" class="btn-secondary" title="Generate report and email to the user set in Invoicing → Configuration → Pending Payment Report Settings"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Pending Payment Report Tree (Summary) -->
    <record id="view_pending_payment_report_line_tree" model="ir.ui.view">
        <field name="name">pending.payment.report.line.tree</field>
        <field name="model">pending.payment.report.line</field>
        <field name="arch" type="xml">
            <list string="Pending Payment Report" create="false" edit="false" delete="false">
                <header>
                    <button name="action_send_email" string="Send Email" type="object" class="btn-primary"
                            icon="fa-envelope"/>
                </header>
                <field name="partner_id"/>
                <field name="move_type" optional="show"/>
                <field name="currency_id" optional="show"/>
                <field name="total" sum="Total"/>
                <field name="paid_amount" sum="Paid Amount"/>
                <field name="pending_amount" sum="Pending Amount"/>
                <field name="invoice_count" sum="Invoice Count"/>
                <field name="email"/>
                <field name="email_id"/>
            </list>
        </field>
    </record>

    <!-- Pending Payment Report Tree with Overdue Days (Detail) -->
    <record id="view_pending_payment_report_line_detail_tree" model="ir.ui.view">
        <field name="name">pending.payment.report.line.detail.tree</field>
        <field name="model">pending.payment.report.line.detail</field>
        <field name="arch" type="xml">
            <list string="Invoice Details" create="false" edit="false" delete="false">
                <field name="line_id" column_invisible="1"/>
                <field name="move_id" column_invisible="1"/>
                <field name="invoice_number"/>
                <field name="due_date"/>
                <field name="overdue_days"/>
                <field name="amount_total"/>
                <field name="received_amount"/>
                <field name="payment_dates"/>
                <field name="amount_residual"/>
                <field name="currency_id"/>
            </list>
        </field>
    </record>

    <record id="view_pending_payment_report_line_form" model="ir.ui.view">
        <field name="name">pending.payment.report.line.form</field>
        <field name="model">pending.payment.report.line</field>
        <field name="arch" type="xml">
            <form string="Pending Payment Report Line" create="false" edit="false" delete="false">
                <group>
                    <field name="partner_id"/>
                    <field name="currency_id"/>
                    <field name="total"/>
                    <field name="paid_amount"/>
                    <field name="pending_amount"/>
                    <field name="invoice_count"/>
                    <field name="email"/>
                    <field name="email_id"/>
                </group>
                <notebook>
                    <page string="Invoice Details" name="details">
                        <field name="detail_ids" nolabel="1" readonly="1">
                            <list create="false" edit="false" delete="false">
                                <field name="invoice_number"/>
                                <field name="due_date"/>
                                <field name="overdue_days"/>
                                <field name="amount_total"/>
                                <field name="received_amount"/>
                                <field name="payment_dates"/>
                                <field name="amount_residual"/>
                            </list>
                        </field>
                    </page>
                </notebook>
            </form>
        </field>
    </record>

    <!-- Wizard action -->
    <record id="action_pending_payment_report_wizard" model="ir.actions.act_window">
        <field name="name">Pending Payment Report</field>
        <field name="res_model">pending.payment.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Set filters and click View Report, Print Report, or Print Excel.
            </p>
        </field>
    </record>
</odoo>
