<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="action_report_remittance_advice" model="ir.actions.report">
            <field name="name">Remittance Advice (PDF)</field>
            <field name="model">account.payment</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">remittance_advice.report_remittance_advice</field>
            <field name="report_file">remittance_advice.report_remittance_advice</field>
            <field name="print_report_name">(object.name or 'Remittance_Advice').replace('/', '_') + '_Remittance_Advice.pdf'</field>
            <field name="binding_model_id" ref="account.model_account_payment"/>
            <field name="binding_type">report</field>
            <field name="domain">[('partner_type', '=', 'supplier')]</field>
        </record>
    </data>
</odoo>
