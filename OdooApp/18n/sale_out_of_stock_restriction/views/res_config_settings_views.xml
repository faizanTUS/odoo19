<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_sale_out_of_stock" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.sale.out.of.stock</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='quotation_order_setting_container']" position="after">
                <block title="Out of Stock Restriction" name="sale_out_of_stock_restriction_setting_container">
                    <setting
                        id="sale_out_of_stock_restriction_enable"
                        help="Prevent confirming a quotation when ordered quantity exceeds available stock for storable products."
                    >
                        <field name="sale_out_of_stock_restriction_enabled"/>
                    </setting>
                    <setting
                        id="sale_out_of_stock_restriction_base"
                        string="Restriction based on"
                        help="Compare ordered quantity to physical stock on hand, or to forecasted quantity (includes incoming and outgoing moves)."
                        invisible="not sale_out_of_stock_restriction_enabled"
                    >
                        <field name="sale_out_of_stock_restriction_base" class="o_light_label" widget="radio"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
