<!--                        class="btn btn-sm btn-outline-danger js_portal_so_delete"-->
<!--                        t-att-data-line-id="line.id"-->
<!--                        title="Delete Line">-->
<!--                    <i class="fa fa-trash"/>-->
<!--                </button>-->
<!--            </td>-->
<!--        </xpath>-->

<!--        <xpath expr="//tr[@name='tr_product']/td[@name='td_product_subtotal']"-->
        <xpath expr="//t[@name='product_line_row']/td[@id='subtotal']"
               position="after">
            <td class="text-center">
                <button t-if="sale_order.state in ['draft','sent']"
                        type="button"
                        class="btn btn-sm btn-outline-danger js_portal_so_delete"
                        t-att-data-line-id="line.id"
                        title="Delete Line">
                    <i class="fa fa-trash"/>
                </button>
            </td>
        </xpath>
    </template>
</odoo>