<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="warehouse_restrict_category" model="ir.module.category">
            <field name="name">Warehouse Restrictions</field>
            <field name="description">User-based warehouse and location restrictions</field>
            <field name="sequence">20</field>
        </record>

        <record id="group_restrict_warehouse" model="res.groups">
            <field name="name">Restrict Warehouses</field>
            <field name="category_id" ref="tus_warehouse_stock_restrictions.warehouse_restrict_category"/>
        </record>

        <record id="group_restrict_sale" model="res.groups">
            <field name="name">Restrict Sales by Warehouse</field>
            <field name="category_id" ref="tus_warehouse_stock_restrictions.warehouse_restrict_category"/>
        </record>

        <record id="group_restrict_button" model="res.groups">
            <field name="name">Restrict Stock Buttons</field>
            <field name="category_id" ref="tus_warehouse_stock_restrictions.warehouse_restrict_category"/>
        </record>

        <record id="group_restrict_sale_order_limit" model="res.groups">
            <field name="name">Restrict SO Limit</field>
            <field name="category_id" ref="tus_warehouse_stock_restrictions.warehouse_restrict_category"/>
        </record>

        <!-- Picking Type Restriction -->
        <record id="rule_stock_picking_type_filter" model="ir.rule">
            <field name="name">Allowed Picking Types</field>
            <field name="model_id" ref="stock.model_stock_picking_type"/>
            <field name="groups" eval="[(4, ref('tus_warehouse_stock_restrictions.group_restrict_warehouse'))]"/>
            <field name="domain_force">[('id', 'in', user.default_picking_type_ids.ids)]</field>
<!--            ('id', '!=', 0)-->
        </record>

        <!-- Admin bypass for pickings -->
        <record id="rule_stock_picking_admin" model="ir.rule">
            <field name="name">Admin See All Pickings</field>
            <field name="model_id" ref="stock.model_stock_picking"/>
            <field name="groups" eval="[(4, ref('base.group_system'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>

        <!-- Sale Order Restriction -->
        <record id="rule_sale_order_by_warehouse" model="ir.rule">
            <field name="name">Restrict Sale Order by Warehouse</field>
            <field name="model_id" ref="sale.model_sale_order"/>
            <field name="groups" eval="[(4, ref('tus_warehouse_stock_restrictions.group_restrict_sale'))]"/>
            <field name="domain_force">[('warehouse_id', 'in', user.warehouse_ids.ids)]</field>
        </record>

        <!-- Picking Restriction -->
        <record id="rule_stock_picking_restrict" model="ir.rule">
            <field name="name">Restrict Pickings by Operation Types</field>
            <field name="model_id" ref="stock.model_stock_picking"/>
            <field name="groups" eval="[(4, ref('tus_warehouse_stock_restrictions.group_restrict_warehouse'))]"/>
            <field name="domain_force">[('picking_type_id', 'in', user.default_picking_type_ids.ids)]</field>
        </record>

    </data>
</odoo>
