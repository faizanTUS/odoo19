<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="attendance_report_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-set="o" t-value="doc"/>
                <t t-call="web.internal_layout">

                    <div class="page o_attendance_report" style="font-size: 11px; color: #333;">

                        <!-- HEADER -->
                        <div style="border-bottom: 2px solid #875A7B; padding-bottom: 8px; margin-bottom: 12px;">
                            <h2 style="font-size: 18px; margin: 0; color: #875A7B;">
                                Employee Attendance Report
                            </h2>
                            <p style="margin: 4px 0 0 0; font-size: 11px;">
                                <strong>Period:</strong>
                                <span t-esc="date_from or ''"/>
                                –
                                <span t-esc="date_to or ''"/>
                                <t t-if="company">| <strong>Company:</strong>
                                    <span t-esc="company.name"/>
                                </t>
                                | <strong>Type:</strong>
                                <span t-esc="report_type_label or 'Combined Report'"/>
                            </p>
                        </div>

                        <!-- NO DATA -->
                        <t t-if="(report_type == 'detailed' and not detailed_lines) or
                              (report_type == 'summary' and not employees_data) or
                              (report_type == 'combined' and not detailed_lines and not employees_data)">
                            <div style="padding: 12px; background: #FFF3CD; border: 1px solid #FFECB5; border-radius: 4px;">
                                <strong>No attendance data found for the selected period.</strong>
                            </div>
                        </t>

                        <!-- DETAILED REPORT -->
                        <t t-if="report_type in ('detailed', 'combined')">
                            <h3 style="margin-top: 20px; font-size: 14px; color: #444;">
                                Detailed Attendance Records
                            </h3>

                            <t t-if="detailed_lines">
                                <table class="table table-sm table-bordered"
                                       style="font-size: 10px; margin-top: 8px;">
                                    <thead style="background-color: #F1F1F1;">
                                        <tr>
                                            <th>Employee</th>
                                            <th>Department</th>
                                            <th>Date</th>
                                            <th>Check In</th>
                                            <th>Check Out</th>
                                            <th>Hours</th>
                                            <th>Overtime</th>
                                            <th>Status</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <t t-foreach="detailed_lines" t-as="line">
                                            <tr>
                                                <td t-esc="line.get('employee', '')"/>
                                                <td t-esc="line.get('department', '')"/>
                                                <td t-esc="line.get('date_str', '')"/>
                                                <td t-esc="line.get('check_in', '')"/>
                                                <td t-esc="line.get('check_out', '')"/>
                                                <td t-esc="line.get('hours', 0)"/>
                                                <td t-esc="line.get('overtime', 0)"/>
                                                <td t-esc="line.get('status_code', '')"/>
                                            </tr>
                                        </t>
                                    </tbody>
                                </table>
                            </t>

                            <t t-else="">
                                <p>
                                    <strong>No detailed attendance records.</strong>
                                </p>
                            </t>
                        </t>

                        <!-- SUMMARY MATRIX -->
                        <t t-if="report_type in ('summary', 'combined') and employees_data">
                            <h3 style="margin-top: 24px; font-size: 14px; color: #444;">
                                Attendance Summary (Matrix)
                            </h3>

                            <table class="table table-sm table-bordered attendance-report-table"
                                   style="font-size: 9.5px; margin-top: 8px;">
                                <thead style="background-color: #F1F1F1;">
                                    <tr>
                                        <th>Employee</th>
                                        <th>Department</th>
                                        <t t-foreach="date_list" t-as="date">
                                            <th t-esc="date.strftime('%d/%m')"/>
                                        </t>
                                        <th>P</th>
                                        <th>HD</th>
                                        <th>A</th>
                                        <th>L</th>
                                        <th>WO</th>
                                        <th>Hrs</th>
                                        <th>OT</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="employees_data" t-as="employee">
                                        <tr>
                                            <td t-esc="employee.get('name', '')"/>
                                            <td t-esc="employee.get('department', '')"/>
                                            <t t-foreach="employee.get('attendance_days', [])" t-as="day">
                                                <td t-attf-style="
                                                background-color: {{ day.get('color', '#6c757d') }};
                                                color: white;
                                                text-align: center;">
                                                    <t t-if="show_hours and day.get('hours', 0) > 0">
                                                        <t t-esc="round(day.get('hours', 0), 1)"/>
                                                    </t>
                                                    <t t-else="">
                                                        <t t-esc="day.get('status_code', '')"/>
                                                    </t>
                                                </td>
                                            </t>
                                            <td t-esc="employee.get('summary', {}).get('status_count', {}).get('present', 0)"/>
                                            <td t-esc="employee.get('summary', {}).get('status_count', {}).get('half_day', 0)"/>
                                            <td t-esc="employee.get('summary', {}).get('status_count', {}).get('absent', 0)"/>
                                            <td t-esc="employee.get('summary', {}).get('status_count', {}).get('on_leave', 0)"/>
                                            <td t-esc="employee.get('summary', {}).get('status_count', {}).get('week_off', 0)"/>
                                            <td t-esc="round(employee.get('summary', {}).get('total_hours', 0), 1)"/>
                                            <td t-esc="round(employee.get('summary', {}).get('overtime_hours', 0), 1)"/>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </t>

                        <!-- FINAL SUMMARY -->
                        <div style="margin-top: 24px; padding-top: 12px; border-top: 2px solid #DDD;">
                            <h3 style="font-size: 14px;">Overall Summary</h3>

                            <p style="font-size: 11px;">
                                <strong>Total Employees:</strong>
                                <span t-esc="summary.get('total_employees', 0)"/>
                            </p>

                            <p style="font-size: 11px;">
                                <strong>Present:</strong>
                                <t t-esc="summary.get('total_present', 0)"/>
                                |
                                <strong>Half Day:</strong>
                                <t t-esc="summary.get('total_half_day', 0)"/>
                                |
                                <strong>Absent:</strong>
                                <t t-esc="summary.get('total_absent', 0)"/>
                                |
                                <strong>Leave:</strong>
                                <t t-esc="summary.get('total_on_leave', 0)"/>
                                |
                                <strong>Week Off:</strong>
                                <t t-esc="summary.get('total_week_off', 0)"/>
                            </p>

                            <p style="font-size: 11px;">
                                <strong>Total Hours:</strong>
                                <t t-esc="round(summary.get('total_hours', 0), 1)"/>
                                |
                                <strong>Overtime:</strong>
                                <t t-esc="round(summary.get('total_overtime', 0), 1)"/>
                            </p>
                        </div>

                    </div>
                </t>
            </t>
        </t>
    </template>


    <!-- Analytics Report Template -->
    <template id="analytics_report_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-set="o" t-value="doc"/>
                <t t-call="web.internal_layout">
                    <div class="page">
                        <h2>Attendance Analytics Report</h2>
                        <p>
                            From:
                            <span t-esc="date_from"/>
                            To:
                            <span t-esc="date_to"/>
                        </p>

                        <!-- Analytics content would go here -->
                        <div t-raw="analytics_content"/>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>