<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form_inherit_disable_out_of_stock_variant" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.disable.out.of.stock.variant</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="website_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//setting[@id='product_attributes_setting']" position="after">
                <setting
                    id="disable_out_of_stock_variant_setting"
                    string="Disable Out of Stock Product Variant"
                    help="Disable out of stock product variant for add to cart. When enabled, out-of-stock variants show &quot;This combination does not exist&quot; and Add to cart is disabled on the product page."
                >
                    <field name="website_disable_out_of_stock_variant"/>
                </setting>
                <setting
                    id="hide_out_of_stock_products_from_shop_setting"
                    string="Hide Out of Stock Products from Shop"
                    help="When enabled, products with 0 on hand are hidden from the shop listing (e.g. Corner Desk Right Sit with 0 quantity will not appear on /shop)."
                >
                    <field name="website_hide_out_of_stock_products_from_shop"/>
                </setting>
            </xpath>
        </field>
    </record>

</odoo>
