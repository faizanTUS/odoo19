<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="mail_template_material_requisition_dept_manager" model="mail.template">
            <field name="name">Material Requisition – Department Manager Approval</field>
            <field name="model_id" ref="model_material_requisition"/>
            <field name="subject">Material Requisition for Department Manager Approval – {{ object.name }}</field>
            <field name="body_html" type="html">
<div style="margin: 0px; padding: 0px;">
    <p>Hello,</p>
    <p>A material requisition <strong t-out="object.name">MR/00001</strong> from <t t-out="object.requested_by_id.name">User</t> is waiting for your approval.</p>
    <p>Request Date: <t t-out="object.request_date">2026-03-12</t></p>
    <p>Department: <t t-out="object.department_id.name or 'N/A'">N/A</t></p>
    <p>
        <a t-attf-href="/web#id=#{object.id}&amp;model=material.requisition&amp;view_type=form">View Requisition</a>
    </p>
    <p>Please approve or reject from the form.</p>
    <p>Best regards,<br/><t t-out="object.company_id.name or ''">Company</t></p>
</div>
            </field>
            <field name="lang">{{ object.department_id.manager_id.user_id.lang or 'en_US' }}</field>
        </record>
        <record id="mail_template_material_requisition_requisition_user" model="mail.template">
            <field name="name">Material Requisition – Requisition User Approval</field>
            <field name="model_id" ref="model_material_requisition"/>
            <field name="subject">Material Requisition for Requisition Officer Approval – {{ object.name }}</field>
            <field name="body_html" type="html">
<div style="margin: 0px; padding: 0px;">
    <p>Hello,</p>
    <p>A material requisition <strong t-out="object.name">MR/00001</strong> is waiting for requisition officer approval.</p>
    <p>Requested by: <t t-out="object.requested_by_id.name">User</t></p>
    <p>Request Date: <t t-out="object.request_date">2026-03-12</t></p>
    <p>
        <a t-attf-href="/web#id=#{object.id}&amp;model=material.requisition&amp;view_type=form">View Requisition</a>
    </p>
    <p>Please approve or reject and generate pickings/purchase orders as needed.</p>
    <p>Best regards,<br/><t t-out="object.company_id.name or ''">Company</t></p>
</div>
            </field>
            <field name="lang">{{ object.requested_by_id.lang or 'en_US' }}</field>
        </record>
    </data>
</odoo>
