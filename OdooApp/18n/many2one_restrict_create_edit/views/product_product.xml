<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_restrict_m2o" model="ir.ui.view">
        <field name="name">product.product.form.restrict.m2o</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_normal_form_view"/>
        <field name="arch" type="xml">

            <field name="categ_id" position="replace">
                <field name="categ_id" groups="!many2one_restrict_create_edit.group_restrict_m2o_create_edit_products"/>
                <field name="categ_id"
                       groups="many2one_restrict_create_edit.group_restrict_m2o_create_edit_products"
                       options="{'no_create': True, 'no_create_edit': True, 'no_open': True}"/>
            </field>

            <field name="product_variant_id" position="replace">
                <field name="product_variant_id" groups="!many2one_restrict_create_edit.group_restrict_m2o_create_edit_products"/>
                <field name="product_variant_id"
                       groups="many2one_restrict_create_edit.group_restrict_m2o_create_edit_products"
                       options="{'no_create': True, 'no_create_edit': True, 'no_open': True}"/>
            </field>

            <field name="uom_id" position="replace">
                <field name="uom_id" groups="!many2one_restrict_create_edit.group_restrict_m2o_create_edit_products"/>
                <field name="uom_id"
                       groups="many2one_restrict_create_edit.group_restrict_m2o_create_edit_products"
                       options="{'no_create': True, 'no_create_edit': True, 'no_open': True}"/>
            </field>

        </field>
    </record>
</odoo>
