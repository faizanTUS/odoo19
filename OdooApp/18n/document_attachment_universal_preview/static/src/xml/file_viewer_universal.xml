<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-inherit="web.FileViewer" t-inherit-mode="extension">
        <xpath expr="//i[@t-if='state.file.isVideo']" position="after">
            <i t-if="state.file.isMsOffice" class="fa fa-file-o" role="img" title="Office document"/>
        </xpath>
        <xpath expr="//iframe[@t-if='state.file.isPdf']" position="after">
            <div
                t-if="state.file.isMsOffice"
                t-on-click.stop=""
                t-on-wheel="onWheelOffice"
                class="o-uap-office-outer w-75 h-100 d-flex align-items-center justify-content-center overflow-auto"
                t-att-class="{ 'w-100': ui.isSmall }"
            >
                <div class="o-uap-office-shell w-100 h-100" t-att-style="officeShellStyle">
                    <iframe
                        class="o-FileViewer-view o-uap-office-iframe w-100 h-100 border-0"
                        t-att-src="state.file.defaultSource"
                        title="Office preview"
                    />
                </div>
            </div>
        </xpath>
        <xpath expr="//div[@t-if='state.file.isImage'][@role='toolbar']" position="after">
            <div t-if="state.file.isMsOffice" class="position-absolute bottom-0 d-flex" role="toolbar">
                <div class="o-FileViewer-toolbarButton p-3 rounded-0" t-on-click.stop="officeZoomIn" title="Zoom In (+)" role="button">
                    <i class="fa fa-fw fa-plus" role="img"/>
                </div>
                <div
                    class="o-FileViewer-toolbarButton p-3 rounded-0"
                    t-att-class="{ 'o_disabled opacity-50': (state.officeScale ?? 1) === 1 }"
                    t-on-click.stop="officeResetZoom"
                    role="button"
                    title="Reset Zoom (0)"
                >
                    <i class="fa fa-fw fa-search" role="img"/>
                </div>
                <div
                    class="o-FileViewer-toolbarButton p-3 rounded-0"
                    t-att-class="{ 'o_disabled opacity-50': (state.officeScale ?? 1) &lt;= minOfficeScale }"
                    t-on-click.stop="officeZoomOut"
                    role="button"
                    title="Zoom Out (-)"
                >
                    <i class="fa fa-fw fa-minus" role="img"/>
                </div>
                <div class="o-FileViewer-toolbarButton p-3 rounded-0" t-on-click.stop="openOfficeInNewTab" title="Open in new tab" role="button">
                    <i class="fa fa-fw fa-external-link" role="img"/>
                </div>
            </div>
        </xpath>
    </t>

</templates>
